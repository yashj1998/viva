<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Sign In — ViVA Seller Center' %></title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { font-family: 'Inter', sans-serif; }
    .font-heading { font-family: 'Poppins', sans-serif; }
  </style>
</head>
<body class="bg-[#fafaf9] text-[#16261d] min-h-screen flex flex-col justify-between">

  <!-- Header Strip -->
  <header class="bg-white border-b border-gray-100 py-3 px-4 sm:px-12 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2 group">
      <div class="w-8 h-8 rounded-lg bg-[#123524] text-white flex items-center justify-center font-bold text-sm">
        <i class="fa-solid fa-store"></i>
      </div>
      <div class="flex flex-col">
        <span class="font-heading font-bold text-sm sm:text-base tracking-tight text-[#123524] leading-none">
          ViVA <span class="text-amber-600 font-semibold text-xs">Seller Center</span>
        </span>
      </div>
    </a>

    <a href="/" class="text-xs text-gray-500 hover:text-[#123524] font-semibold flex items-center gap-1.5 transition-colors">
      <i class="fa-solid fa-arrow-left text-[10px]"></i>
      <span class="hidden sm:inline">Back to Storefront</span>
      <span class="sm:hidden">Storefront</span>
    </a>
  </header>

  <!-- Main Login Card -->
  <main class="flex-1 flex items-center justify-center p-3.5 sm:p-8">
    <div class="bg-white rounded-2xl sm:rounded-3xl border border-gray-200/80 p-5 sm:p-10 max-w-md w-full shadow-lg space-y-5 sm:space-y-6">
      
      <!-- Card Header -->
      <div class="text-center space-y-1.5 sm:space-y-2">
        <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-amber-50 border border-amber-200 text-amber-800 flex items-center justify-center mx-auto text-lg sm:text-xl shadow-xs">
          <i class="fa-solid fa-store"></i>
        </div>
        <h1 class="font-heading font-bold text-xl sm:text-2xl text-[#123524]">
          <%= mode === 'register' ? 'Register New Store' : 'Merchant Sign In' %>
        </h1>
        <p class="text-xs text-gray-500">
          <%= mode === 'register' ? 'Join ViVA Merchant Network to sell modern lifestyle essentials.' : 'Access your dedicated store catalog, inventory, and order fulfillments.' %>
        </p>
      </div>

      <!-- Mode Switcher Tabs -->
      <div class="flex items-center bg-gray-100 p-1 rounded-xl text-xs font-semibold">
        <a href="/seller/login" class="flex-1 text-center py-2 rounded-lg transition-all <%= mode !== 'register' ? 'bg-white text-[#123524] shadow-xs font-bold' : 'text-gray-500 hover:text-gray-900' %>">
          Sign In
        </a>
        <a href="/seller/register" class="flex-1 text-center py-2 rounded-lg transition-all <%= mode === 'register' ? 'bg-white text-[#123524] shadow-xs font-bold' : 'text-gray-500 hover:text-gray-900' %>">
          Register Store
        </a>
      </div>

      <!-- Alerts -->
      <% if (error) { %>
        <div class="p-3.5 bg-rose-50 border border-rose-200 rounded-xl text-xs text-rose-700 font-semibold flex items-center gap-2">
          <i class="fa-solid fa-circle-exclamation text-rose-500"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <% if (message) { %>
        <div class="p-3.5 bg-emerald-50 border border-emerald-200 rounded-xl text-xs text-emerald-800 font-semibold flex items-center gap-2">
          <i class="fa-solid fa-circle-check text-emerald-600"></i>
          <span><%= message %></span>
        </div>
      <% } %>

      <% if (mode === 'register') { %>
        <!-- REGISTER STORE FORM -->
        <form action="/seller/register" method="POST" class="space-y-4 text-xs">
          <div class="space-y-1">
            <label class="font-bold text-gray-700">Merchant Owner Name *</label>
            <input type="text" name="name" required placeholder="e.g. Alex Henderson" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none">
          </div>

          <div class="space-y-1">
            <label class="font-bold text-gray-700">Store / Business Name *</label>
            <input type="text" name="storeName" required placeholder="e.g. Apex Living Studio" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none">
          </div>

          <div class="space-y-1">
            <label class="font-bold text-gray-700">Business Email Address *</label>
            <input type="email" name="email" required placeholder="seller@yourstore.com" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none font-mono">
          </div>

          <div class="space-y-1">
            <label class="font-bold text-gray-700">Phone Contact</label>
            <input type="tel" name="phone" placeholder="+1 (555) 019-2831" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none">
          </div>

          <div class="space-y-1">
            <label class="font-bold text-gray-700">Password *</label>
            <input type="password" name="password" required placeholder="Create secure password" class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none">
          </div>

          <div class="space-y-1">
            <label class="font-bold text-gray-700">Store Description</label>
            <textarea name="storeDescription" rows="2" placeholder="Briefly describe the categories and products you supply..." class="w-full px-3.5 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none"></textarea>
          </div>

          <button type="submit" class="w-full py-3 bg-[#123524] hover:bg-[#1a4b33] text-white rounded-xl font-bold text-xs transition-colors shadow-xs">
            Create Store &amp; Access Dashboard
          </button>
        </form>

      <% } else { %>
        <!-- SIGN IN FORM -->
        <form action="/seller/login" method="POST" class="space-y-4 text-xs">
          <div class="space-y-1">
            <label class="font-bold text-gray-700">Seller Email Address</label>
            <input 
              type="email" 
              id="sellerEmailInput"
              name="email" 
              required 
              placeholder="seller@viva.com" 
              class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none font-mono"
            >
          </div>

          <div class="space-y-1">
            <div class="flex items-center justify-between">
              <label class="font-bold text-gray-700">Password</label>
            </div>
            <input 
              type="password" 
              id="sellerPasswordInput"
              name="password" 
              required 
              placeholder="••••••••" 
              class="w-full px-3.5 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none"
            >
          </div>

          <button type="submit" class="w-full py-3 bg-[#123524] hover:bg-[#1a4b33] text-white rounded-xl font-bold text-xs transition-colors shadow-xs flex items-center justify-center gap-2">
            <span>Sign In to Seller Dashboard</span>
            <i class="fa-solid fa-arrow-right text-[11px]"></i>
          </button>
        </form>

        <!-- Quick Fill Demo Seller Credentials -->
        <div class="pt-2 border-t border-gray-100">
          <button 
            type="button" 
            onclick="fillDemoSeller()" 
            class="w-full py-2.5 px-3 bg-amber-50 hover:bg-amber-100 border border-amber-200 text-amber-900 rounded-xl font-bold text-xs transition-colors flex items-center justify-center gap-2"
          >
            <i class="fa-solid fa-wand-magic-sparkles text-amber-600"></i>
            <span>1-Click Fill Demo Seller (`seller@viva.com`)</span>
          </button>
        </div>
      <% } %>

      <div class="text-center text-[11px] text-gray-400">
        Protected by ViVA Merchant Security &amp; End-to-End Encryption
      </div>
    </div>
  </main>

  <footer class="py-4 text-center text-xs text-gray-400 border-t border-gray-100 bg-white">
    &copy; <%= new Date().getFullYear() %> ViVA Live Better &bull; Seller Operations Hub
  </footer>

  <script>
    function fillDemoSeller() {
      const emailInput = document.getElementById('sellerEmailInput');
      const passInput = document.getElementById('sellerPasswordInput');
      if (emailInput && passInput) {
        emailInput.value = 'seller@viva.com';
        passInput.value = 'seller123';
      }
    }
  </script>
</body>
</html>
