<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Products Catalog — ViVA Seller Center' %></title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { font-family: 'Inter', sans-serif; }
    .font-heading { font-family: 'Poppins', sans-serif; }
  </style>
</head>
<body class="bg-[#fafaf9] text-[#16261d] min-h-screen flex">

  <%- include('sidebar') %>

  <!-- Main Content Area -->
  <div class="flex-1 flex flex-col min-w-0">
    <%- include('topbar') %>

    <main class="p-4 sm:p-6 lg:p-8 space-y-6 flex-1 overflow-y-auto">
      
      <!-- Notifications -->
      <% if (message) { %>
        <div class="p-3.5 sm:p-4 rounded-2xl text-xs font-semibold flex items-center justify-between shadow-xs bg-emerald-50 text-emerald-800 border border-emerald-200">
          <div class="flex items-center gap-2">
            <i class="fa-solid fa-circle-check text-emerald-600"></i>
            <span><%= message %></span>
          </div>
          <button onclick="this.parentElement.remove()" class="text-emerald-700 hover:text-emerald-900 font-bold">&times;</button>
        </div>
      <% } %>

      <!-- Top Header -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="font-heading font-bold text-lg sm:text-xl text-[#123524]">My Products Catalog</h1>
          <p class="text-xs text-gray-500 mt-0.5">Manage your store listings, pricing, SKU codes, and live availability on ViVA.</p>
        </div>
        <div class="flex items-center gap-2 sm:gap-2.5 flex-wrap">
          <button 
            type="button" 
            onclick="document.getElementById('sellerAddProductCard').classList.toggle('hidden')"
            class="inline-flex items-center gap-2 px-3.5 sm:px-4 py-2 sm:py-2.5 rounded-xl bg-[#123524] text-white text-xs font-bold hover:bg-[#1a4b33] transition-colors shadow-xs cursor-pointer"
          >
            <i class="fa-solid fa-plus text-[11px]"></i> Add New Product
          </button>
          <a href="/seller/inventory" class="inline-flex items-center gap-1.5 px-3 sm:px-3.5 py-2 sm:py-2.5 rounded-xl border border-gray-200 bg-white hover:bg-gray-50 text-gray-700 text-xs font-bold transition-colors shadow-2xs">
            <i class="fa-solid fa-warehouse text-amber-600 text-xs"></i> Stock Control
          </a>
        </div>
      </div>

      <!-- Quick Add Product Drawer -->
      <div id="sellerAddProductCard" class="bg-white rounded-2xl sm:rounded-3xl border border-gray-200/80 p-4 sm:p-6 shadow-xs space-y-4 hidden">
        <div class="flex items-center justify-between border-b border-gray-100 pb-3">
          <h2 class="font-heading font-bold text-sm text-[#123524] flex items-center gap-2">
            <i class="fa-solid fa-circle-plus text-emerald-700 text-xs"></i>
            <span>Add Product to <%= currentSeller.storeName %></span>
          </h2>
          <button type="button" onclick="document.getElementById('sellerAddProductCard').classList.add('hidden')" class="text-gray-400 hover:text-gray-600 font-bold">&times;</button>
        </div>

        <form action="/seller/products/new" method="POST" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-4 items-end text-xs">
          <div class="lg:col-span-2 space-y-1">
            <label class="font-bold text-gray-700">Product Title *</label>
            <input type="text" name="name" required placeholder="e.g. Acoustic Studio Monitors" class="w-full px-3 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none">
          </div>

          <div class="space-y-1">
            <label class="font-bold text-gray-700">SKU (Auto-generates if blank)</label>
            <input type="text" name="sku" placeholder="e.g. APEX-AUD-01" class="w-full px-3 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none uppercase font-mono">
          </div>

          <div class="space-y-1">
            <label class="font-bold text-gray-700">Category *</label>
            <select name="category" class="w-full px-3 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none">
              <% (categories || []).forEach(cat => { %>
                <option value="<%= cat.name %>"><%= cat.name %></option>
              <% }) %>
            </select>
          </div>

          <div class="space-y-1">
            <label class="font-bold text-gray-700">Regular Price ($) *</label>
            <input type="number" step="0.01" name="price" required placeholder="129.99" class="w-full px-3 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none font-bold">
          </div>

          <div class="space-y-1">
            <label class="font-bold text-gray-700">Sale Price ($) *</label>
            <input type="number" step="0.01" name="salePrice" required placeholder="99.99" class="w-full px-3 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none text-[#c8503f] font-bold">
          </div>

          <div class="space-y-1">
            <label class="font-bold text-gray-700">Initial Stock</label>
            <input type="number" name="stockQuantity" value="50" min="0" class="w-full px-3 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none font-bold">
          </div>

          <div class="space-y-1">
            <label class="font-bold text-gray-700">Low Stock Alert Level</label>
            <input type="number" name="lowStockThreshold" value="10" min="1" class="w-full px-3 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none">
          </div>

          <div class="space-y-1">
            <label class="font-bold text-gray-700">Listing Status</label>
            <select name="status" class="w-full px-3 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none font-semibold">
              <option value="published">Published (Live)</option>
              <option value="draft">Draft (Hidden)</option>
            </select>
          </div>

          <div class="lg:col-span-3 space-y-1">
            <label class="font-bold text-gray-700">Product Image URL / Path</label>
            <input type="text" name="primaryImageUrl" value="/images/products/headphones.png" class="w-full px-3 py-2 border border-gray-200 rounded-xl font-mono text-gray-700">
          </div>

          <div class="lg:col-span-6 space-y-1">
            <label class="font-bold text-gray-700">Product Description</label>
            <textarea name="description" rows="2" placeholder="Describe materials, warranty, features..." class="w-full px-3 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none"></textarea>
          </div>

          <div class="lg:col-span-6 flex items-center justify-end gap-2 pt-2 border-t border-gray-100">
            <button type="button" onclick="document.getElementById('sellerAddProductCard').classList.add('hidden')" class="px-4 py-2 text-gray-600 hover:bg-gray-100 rounded-xl font-bold">
              Cancel
            </button>
            <button type="submit" class="px-5 py-2 bg-[#123524] hover:bg-[#1a4b33] text-white font-bold rounded-xl shadow-xs transition-colors">
              Save &amp; Publish Listing
            </button>
          </div>
        </form>
      </div>

      <!-- Filters & Search Toolbar -->
      <form action="/seller/products" method="GET" class="bg-white p-3.5 sm:p-4 rounded-2xl sm:rounded-3xl border border-gray-200/80 shadow-xs space-y-3">
        <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3 text-xs">
          <!-- Search -->
          <div class="relative flex-1">
            <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
            <input 
              type="text" 
              name="search" 
              value="<%= query.search || '' %>" 
              placeholder="Search by product title or SKU..." 
              class="w-full pl-9 pr-4 py-2 text-xs rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-emerald-500"
            >
          </div>

          <!-- Filters: Grid on mobile/tablet, flex on desktop -->
          <div class="grid grid-cols-2 sm:grid-cols-4 md:flex md:items-center gap-2">
            <select name="category" onchange="this.form.submit()" class="w-full md:w-auto px-2.5 sm:px-3 py-2 border border-gray-200 rounded-xl bg-white focus:outline-none font-medium text-gray-700 text-xs">
              <option value="all">All Categories</option>
              <% (categories || []).forEach(cat => { %>
                <option value="<%= cat.name %>" <%= (query.category === cat.name) ? 'selected' : '' %>><%= cat.name %></option>
              <% }) %>
            </select>

            <select name="stock" onchange="this.form.submit()" class="w-full md:w-auto px-2.5 sm:px-3 py-2 border border-gray-200 rounded-xl bg-white focus:outline-none font-medium text-gray-700 text-xs">
              <option value="all">All Stock</option>
              <option value="in-stock" <%= query.stock === 'in-stock' ? 'selected' : '' %>>In Stock (>0)</option>
              <option value="low-stock" <%= query.stock === 'low-stock' ? 'selected' : '' %>>Low Stock</option>
              <option value="out-of-stock" <%= query.stock === 'out-of-stock' ? 'selected' : '' %>>Out of Stock (0)</option>
            </select>

            <select name="status" onchange="this.form.submit()" class="w-full md:w-auto px-2.5 sm:px-3 py-2 border border-gray-200 rounded-xl bg-white focus:outline-none font-medium text-gray-700 text-xs">
              <option value="all">All Statuses</option>
              <option value="published" <%= query.status === 'published' ? 'selected' : '' %>>Published (Live)</option>
              <option value="draft" <%= query.status === 'draft' ? 'selected' : '' %>>Draft</option>
            </select>

            <select name="sort" onchange="this.form.submit()" class="w-full md:w-auto px-2.5 sm:px-3 py-2 border border-gray-200 rounded-xl bg-white focus:outline-none font-medium text-gray-700 text-xs">
              <option value="newest" <%= (!query.sort || query.sort === 'newest') ? 'selected' : '' %>>Newest First</option>
              <option value="price-asc" <%= query.sort === 'price-asc' ? 'selected' : '' %>>Price: Low to High</option>
              <option value="price-desc" <%= query.sort === 'price-desc' ? 'selected' : '' %>>Price: High to Low</option>
              <option value="stock-asc" <%= query.sort === 'stock-asc' ? 'selected' : '' %>>Stock: Low to High</option>
              <option value="name-asc" <%= query.sort === 'name-asc' ? 'selected' : '' %>>Name A-Z</option>
            </select>

            <div class="col-span-2 sm:col-span-4 md:col-span-1 flex items-center gap-2">
              <button type="submit" class="flex-1 md:flex-initial px-4 py-2 bg-[#123524] text-white text-xs font-bold rounded-xl hover:bg-[#1a4b33] transition-colors text-center">
                Filter
              </button>
              <% if (query.search || (query.category && query.category !== 'all') || (query.stock && query.stock !== 'all') || (query.status && query.status !== 'all')) { %>
                <a href="/seller/products" class="px-2.5 py-2 text-xs text-gray-500 hover:text-gray-800 font-semibold">Reset</a>
              <% } %>
            </div>
          </div>
        </div>
      </form>

      <!-- Products Table -->
      <div class="bg-white rounded-2xl sm:rounded-3xl border border-gray-200/80 overflow-hidden shadow-xs">
        <div class="overflow-x-auto -mx-4 sm:mx-0 px-4 sm:px-0">
          <table class="w-full text-left text-xs min-w-[720px]">
            <thead>
              <tr class="text-gray-400 uppercase tracking-wider text-[10px] border-b border-gray-100 bg-gray-50/70">
                <th class="py-3 px-4">Thumbnail</th>
                <th class="py-3 px-4">Product Title &amp; SKU</th>
                <th class="py-3 px-4">Category</th>
                <th class="py-3 px-4">Stock Availability</th>
                <th class="py-3 px-4">Regular Price</th>
                <th class="py-3 px-4">Sale Price</th>
                <th class="py-3 px-4">Status</th>
                <th class="py-3 px-4 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% if (products && products.length > 0) { %>
                <% products.forEach(product => { %>
                  <% 
                    const stock = Number(product.stockQuantity) || 0;
                    const threshold = Number(product.lowStockThreshold) || 10;
                    const isOutOfStock = stock <= 0;
                    const isLowStock = !isOutOfStock && stock <= threshold;
                  %>
                  <tr class="hover:bg-gray-50/60 transition-colors">
                    <!-- Thumbnail -->
                    <td class="py-3.5 px-4">
                      <div class="w-10 h-10 bg-gray-50 rounded-xl p-1 border border-gray-100 flex items-center justify-center">
                        <img src="<%= product.primaryImageUrl %>" alt="<%= product.name %>" class="max-h-full max-w-full object-contain">
                      </div>
                    </td>

                    <!-- Title & SKU -->
                    <td class="py-3.5 px-4 font-bold text-gray-900 max-w-xs">
                      <div class="truncate"><%= product.name %></div>
                      <div class="flex items-center gap-1.5 mt-0.5">
                        <span class="text-[10px] text-emerald-800 font-mono font-semibold bg-emerald-50 px-1.5 py-0.2 rounded">
                          <%= product.sku || 'NO-SKU' %>
                        </span>
                        <a href="/product/<%= product.slug %>" target="_blank" class="text-[10px] text-gray-400 hover:text-emerald-700 flex items-center gap-0.5">
                          <span>Live PDP</span>
                          <i class="fa-solid fa-arrow-up-right-from-square text-[8px]"></i>
                        </a>
                      </div>
                    </td>

                    <!-- Category -->
                    <td class="py-3.5 px-4 whitespace-nowrap">
                      <span class="bg-gray-100 text-gray-700 px-2 py-0.5 rounded text-[10px] font-semibold">
                        <%= product.category %>
                      </span>
                    </td>

                    <!-- Stock Availability -->
                    <td class="py-3.5 px-4 whitespace-nowrap">
                      <span class="inline-flex items-center gap-1.5 font-semibold <%= isOutOfStock ? 'text-rose-600' : (isLowStock ? 'text-amber-700' : 'text-gray-700') %>">
                        <span class="w-2 h-2 rounded-full <%= isOutOfStock ? 'bg-rose-500' : (isLowStock ? 'bg-amber-500' : 'bg-emerald-500') %>"></span>
                        <span><%= stock %> units</span>
                      </span>
                    </td>

                    <!-- Regular Price -->
                    <td class="py-3.5 px-4 text-gray-400 line-through whitespace-nowrap">
                      $<%= (product.price || 0).toFixed(2) %>
                    </td>

                    <!-- Sale Price -->
                    <td class="py-3.5 px-4 font-bold text-[#c8503f] whitespace-nowrap">
                      $<%= (product.salePrice || product.price || 0).toFixed(2) %>
                      <% if (product.discountPercent) { %>
                        <span class="text-[9px] bg-rose-50 text-rose-700 px-1 py-0.2 rounded font-bold ml-1">
                          -<%= product.discountPercent %>%
                        </span>
                      <% } %>
                    </td>

                    <!-- Status -->
                    <td class="py-3.5 px-4 whitespace-nowrap">
                      <form action="/seller/products/status/<%= product._id %>" method="POST" class="inline">
                        <button 
                          type="submit" 
                          class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider transition-colors <%= product.status === 'published' ? 'bg-emerald-100 text-emerald-800 hover:bg-emerald-200' : 'bg-gray-200 text-gray-700 hover:bg-gray-300' %>"
                          title="Click to toggle publish status"
                        >
                          <span class="w-1.5 h-1.5 rounded-full <%= product.status === 'published' ? 'bg-emerald-600' : 'bg-gray-500' %>"></span>
                          <span><%= product.status === 'published' ? 'Live' : 'Draft' %></span>
                        </button>
                      </form>
                    </td>

                    <!-- Actions -->
                    <td class="py-3.5 px-4 text-right whitespace-nowrap">
                      <form action="/seller/products/delete/<%= product._id %>" method="POST" onsubmit="return confirm('Delete this listing permanently?');" class="inline">
                        <button type="submit" class="p-1.5 text-gray-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition-colors" title="Delete Product">
                          <i class="fa-regular fa-trash-can text-xs"></i>
                        </button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="8" class="py-12 text-center text-gray-400">
                    <i class="fa-solid fa-boxes-stacked text-3xl mb-2 block text-gray-300"></i>
                    No products found matching your search or filters.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <!-- Pagination -->
        <% if (pagination && pagination.totalPages > 1) { %>
          <div class="p-3.5 sm:p-4 border-t border-gray-100 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs bg-gray-50/50">
            <span class="text-gray-500 font-medium text-center sm:text-left">
              Page <%= pagination.page %> of <%= pagination.totalPages %> (<%= pagination.totalProducts %> products)
            </span>
            <div class="flex items-center gap-1.5 flex-wrap justify-center">
              <% if (pagination.hasPrevPage) { %>
                <a href="/seller/products?page=<%= pagination.page - 1 %>&search=<%= query.search || '' %>&category=<%= query.category || 'all' %>&stock=<%= query.stock || 'all' %>&status=<%= query.status || 'all' %>" class="px-2.5 sm:px-3 py-1.5 rounded-lg border border-gray-200 bg-white hover:bg-gray-50 font-bold text-gray-700">
                  &larr; Prev
                </a>
              <% } %>
              <% for(let p = 1; p <= pagination.totalPages; p++) { %>
                <a href="/seller/products?page=<%= p %>&search=<%= query.search || '' %>&category=<%= query.category || 'all' %>&stock=<%= query.stock || 'all' %>&status=<%= query.status || 'all' %>" class="px-2.5 sm:px-3 py-1.5 rounded-lg font-bold transition-colors <%= p === pagination.page ? 'bg-[#123524] text-white' : 'border border-gray-200 bg-white text-gray-700 hover:bg-gray-50' %>">
                  <%= p %>
                </a>
              <% } %>
              <% if (pagination.hasNextPage) { %>
                <a href="/seller/products?page=<%= pagination.page + 1 %>&search=<%= query.search || '' %>&category=<%= query.category || 'all' %>&stock=<%= query.stock || 'all' %>&status=<%= query.status || 'all' %>" class="px-2.5 sm:px-3 py-1.5 rounded-lg border border-gray-200 bg-white hover:bg-gray-50 font-bold text-gray-700">
                  Next &rarr;
                </a>
              <% } %>
            </div>
          </div>
        <% } %>
      </div>

    </main>
  </div>
</body>
</html>
