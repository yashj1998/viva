<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Inventory & Stock — ViVA Seller Center' %></title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { font-family: 'Inter', sans-serif; }
    .font-heading { font-family: 'Poppins', sans-serif; }
  </style>
</head>
<body class="bg-[#fafaf9] text-[#16261d] min-h-screen flex">

  <%- include('sidebar') %>

  <!-- Main Content Area -->
  <div class="flex-1 flex flex-col min-w-0">
    <%- include('topbar') %>

    <main class="p-4 sm:p-6 lg:p-8 space-y-6 flex-1 overflow-y-auto">
      
      <!-- Notifications -->
      <% if (message) { %>
        <div class="p-3.5 sm:p-4 rounded-2xl text-xs font-semibold flex items-center justify-between shadow-xs bg-emerald-50 text-emerald-800 border border-emerald-200">
          <div class="flex items-center gap-2">
            <i class="fa-solid fa-circle-check text-emerald-600"></i>
            <span><%= message %></span>
          </div>
          <button onclick="this.parentElement.remove()" class="text-emerald-700 hover:text-emerald-900 font-bold">&times;</button>
        </div>
      <% } %>

      <!-- Top Header -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="font-heading font-bold text-lg sm:text-xl text-[#123524]">Stock Control &amp; Inventory</h1>
          <p class="text-xs text-gray-500 mt-0.5">Real-time stock ledger, minimum threshold monitoring, and manual inventory adjustments.</p>
        </div>
        <div class="flex items-center gap-2.5">
          <a href="/seller/products" class="inline-flex items-center gap-2 px-3.5 py-2.5 rounded-xl border border-gray-200 text-gray-700 bg-white hover:bg-gray-50 text-xs font-bold transition-colors shadow-2xs">
            <i class="fa-solid fa-boxes-stacked text-emerald-700 text-xs"></i> Products Catalog
          </a>
        </div>
      </div>

      <!-- KPI Metrics Strip -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
        <div class="bg-white p-3.5 sm:p-4 rounded-xl sm:rounded-2xl border border-gray-200/80 shadow-xs">
          <span class="text-[9px] sm:text-[10px] font-bold uppercase tracking-wider text-gray-400">Total Stock</span>
          <div class="text-xl sm:text-2xl font-bold font-heading text-[#123524] mt-1 truncate"><%= stats.totalStockUnits.toLocaleString() %></div>
          <p class="text-[10px] text-gray-400 mt-0.5 truncate"><%= stats.totalProducts %> products</p>
        </div>

        <div class="bg-white p-3.5 sm:p-4 rounded-xl sm:rounded-2xl border border-gray-200/80 shadow-xs">
          <span class="text-[9px] sm:text-[10px] font-bold uppercase tracking-wider text-emerald-600">Healthy Stock</span>
          <div class="text-xl sm:text-2xl font-bold font-heading text-emerald-700 mt-1 truncate"><%= stats.inStockCount %></div>
          <p class="text-[10px] text-gray-400 mt-0.5 truncate">Above threshold</p>
        </div>

        <div class="bg-white p-3.5 sm:p-4 rounded-xl sm:rounded-2xl border border-gray-200/80 shadow-xs">
          <span class="text-[9px] sm:text-[10px] font-bold uppercase tracking-wider text-amber-600">Low Stock</span>
          <div class="text-xl sm:text-2xl font-bold font-heading text-amber-700 mt-1 truncate"><%= stats.lowStockCount %></div>
          <p class="text-[10px] text-amber-700 font-semibold mt-0.5 truncate">Re-order alert</p>
        </div>

        <div class="bg-white p-3.5 sm:p-4 rounded-xl sm:rounded-2xl border border-gray-200/80 shadow-xs">
          <span class="text-[9px] sm:text-[10px] font-bold uppercase tracking-wider text-rose-600">Out of Stock</span>
          <div class="text-xl sm:text-2xl font-bold font-heading text-rose-700 mt-1 truncate"><%= stats.outOfStockCount %></div>
          <p class="text-[10px] text-rose-700 font-semibold mt-0.5 truncate">Unavailable</p>
        </div>
      </div>

      <!-- Filters Toolbar -->
      <div class="space-y-3">
        <!-- Stock Filter Pills (Scrollable on mobile) -->
        <div class="flex items-center gap-1.5 flex-nowrap sm:flex-wrap overflow-x-auto pb-1 sm:pb-0 text-xs max-w-full">
          <a href="/seller/inventory?stockStatus=all" class="px-3.5 py-2 rounded-xl font-bold whitespace-nowrap transition-colors <%= (!query.stockStatus || query.stockStatus === 'all') ? 'bg-[#123524] text-white shadow-xs' : 'bg-white text-gray-600 border border-gray-200 hover:bg-gray-50' %>">
            All Items (<%= stats.totalProducts %>)
          </a>
          <a href="/seller/inventory?stockStatus=low-stock" class="px-3.5 py-2 rounded-xl font-bold whitespace-nowrap transition-colors <%= query.stockStatus === 'low-stock' ? 'bg-amber-600 text-white shadow-xs' : 'bg-white text-amber-700 border border-amber-200 hover:bg-amber-50' %>">
            Low Stock (<%= stats.lowStockCount %>)
          </a>
          <a href="/seller/inventory?stockStatus=out-of-stock" class="px-3.5 py-2 rounded-xl font-bold whitespace-nowrap transition-colors <%= query.stockStatus === 'out-of-stock' ? 'bg-rose-700 text-white shadow-xs' : 'bg-white text-rose-700 border border-rose-200 hover:bg-rose-50' %>">
            Out of Stock (<%= stats.outOfStockCount %>)
          </a>
          <a href="/seller/inventory?stockStatus=in-stock" class="px-3.5 py-2 rounded-xl font-bold whitespace-nowrap transition-colors <%= query.stockStatus === 'in-stock' ? 'bg-emerald-700 text-white shadow-xs' : 'bg-white text-emerald-800 border border-emerald-200 hover:bg-emerald-50' %>">
            Healthy Stock (<%= stats.inStockCount %>)
          </a>
        </div>

        <!-- Search Form -->
        <form action="/seller/inventory" method="GET" class="bg-white p-3.5 sm:p-4 rounded-2xl sm:rounded-3xl border border-gray-200/80 shadow-xs flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 text-xs">
          <input type="hidden" name="stockStatus" value="<%= query.stockStatus || 'all' %>">

          <div class="relative flex-1">
            <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
            <input 
              type="text" 
              name="search" 
              value="<%= query.search || '' %>" 
              placeholder="Search inventory by title or SKU..." 
              class="w-full pl-9 pr-4 py-2 text-xs rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-emerald-500"
            >
          </div>

          <div class="flex items-center gap-2 flex-wrap">
            <select name="sort" onchange="this.form.submit()" class="px-3 py-2 border border-gray-200 rounded-xl bg-white focus:outline-none font-medium text-gray-700">
              <option value="stock-asc" <%= (!query.sort || query.sort === 'stock-asc') ? 'selected' : '' %>>Stock: Low to High</option>
              <option value="stock-desc" <%= query.sort === 'stock-desc' ? 'selected' : '' %>>Stock: High to Low</option>
              <option value="name-asc" <%= query.sort === 'name-asc' ? 'selected' : '' %>>Title A-Z</option>
            </select>

            <button type="submit" class="px-4 py-2 bg-[#123524] text-white font-bold rounded-xl hover:bg-[#1a4b33] transition-colors">
              Filter
            </button>
            <% if (query.search || (query.stockStatus && query.stockStatus !== 'all')) { %>
              <a href="/seller/inventory" class="px-3 py-2 text-xs text-gray-500 hover:text-gray-800 font-semibold">Reset</a>
            <% } %>
          </div>
        </form>
      </div>

      <!-- Inventory Table -->
      <div class="bg-white rounded-2xl sm:rounded-3xl border border-gray-200/80 overflow-hidden shadow-xs">
        <div class="overflow-x-auto -mx-4 sm:mx-0 px-4 sm:px-0">
          <table class="w-full text-left text-xs min-w-[720px]">
            <thead>
              <tr class="text-gray-400 uppercase tracking-wider text-[10px] border-b border-gray-100 bg-gray-50/70">
                <th class="py-3 px-4">Thumbnail</th>
                <th class="py-3 px-4">Product Name &amp; SKU</th>
                <th class="py-3 px-4">Category</th>
                <th class="py-3 px-4">Unit Price</th>
                <th class="py-3 px-4">Current Stock</th>
                <th class="py-3 px-4">Alert Threshold</th>
                <th class="py-3 px-4">Availability</th>
                <th class="py-3 px-4 text-right">Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% if (products && products.length > 0) { %>
                <% products.forEach(prod => { %>
                  <% 
                    const stock = Number(prod.stockQuantity) || 0;
                    const threshold = Number(prod.lowStockThreshold) || 10;
                    const isOutOfStock = stock <= 0;
                    const isLowStock = !isOutOfStock && stock <= threshold;
                  %>
                  <tr class="hover:bg-gray-50/60 transition-colors">
                    <td class="py-3.5 px-4">
                      <div class="w-10 h-10 bg-gray-50 rounded-xl p-1 border border-gray-100 flex items-center justify-center">
                        <img src="<%= prod.primaryImageUrl %>" alt="<%= prod.name %>" class="max-h-full max-w-full object-contain">
                      </div>
                    </td>

                    <td class="py-3.5 px-4 font-bold text-gray-900 max-w-xs">
                      <div class="truncate"><%= prod.name %></div>
                      <div class="text-[10px] text-emerald-800 font-mono font-semibold bg-emerald-50 px-1.5 py-0.5 rounded inline-block mt-0.5">
                        <%= prod.sku || 'NO-SKU' %>
                      </div>
                    </td>

                    <td class="py-3.5 px-4 whitespace-nowrap">
                      <span class="bg-gray-100 text-gray-700 px-2 py-0.5 rounded text-[10px] font-semibold">
                        <%= prod.category %>
                      </span>
                    </td>

                    <td class="py-3.5 px-4 whitespace-nowrap font-bold text-gray-900">
                      $<%= (prod.salePrice || prod.price || 0).toFixed(2) %>
                    </td>

                    <td class="py-3.5 px-4 whitespace-nowrap">
                      <span class="inline-flex items-center gap-1.5 font-bold text-sm <%= isOutOfStock ? 'text-rose-600' : (isLowStock ? 'text-amber-700' : 'text-[#123524]') %>">
                        <span class="w-2 h-2 rounded-full <%= isOutOfStock ? 'bg-rose-500' : (isLowStock ? 'bg-amber-500' : 'bg-emerald-500') %>"></span>
                        <span><%= stock %> units</span>
                      </span>
                    </td>

                    <td class="py-3.5 px-4 whitespace-nowrap text-gray-500 font-mono">
                      &le; <%= threshold %> units
                    </td>

                    <td class="py-3.5 px-4 whitespace-nowrap">
                      <% if (isOutOfStock) { %>
                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-bold bg-rose-100 text-rose-800">
                          Out of Stock
                        </span>
                      <% } else if (isLowStock) { %>
                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800">
                          Low Stock
                        </span>
                      <% } else { %>
                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">
                          In Stock
                        </span>
                      <% } %>
                    </td>

                    <td class="py-3.5 px-4 text-right whitespace-nowrap">
                      <button 
                        type="button" 
                        onclick="openStockModal('<%= prod._id %>', '<%= prod.name %>', '<%= prod.sku || '' %>', <%= stock %>)"
                        class="px-3 py-1.5 bg-[#123524] hover:bg-[#1a4b33] text-white rounded-lg text-xs font-bold transition-colors shadow-2xs cursor-pointer"
                      >
                        Adjust Stock
                      </button>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="8" class="py-12 text-center text-gray-400">
                    <i class="fa-solid fa-boxes-stacked text-3xl mb-2 block text-gray-300"></i>
                    No inventory items found matching your filters.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <!-- Pagination -->
        <% if (pagination && pagination.totalPages > 1) { %>
          <div class="p-3.5 sm:p-4 border-t border-gray-100 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs bg-gray-50/50">
            <span class="text-gray-500 font-medium text-center sm:text-left">
              Page <%= pagination.page %> of <%= pagination.totalPages %> (<%= pagination.totalItems %> items)
            </span>
            <div class="flex items-center gap-1.5 flex-wrap justify-center">
              <% if (pagination.hasPrevPage) { %>
                <a href="/seller/inventory?page=<%= pagination.page - 1 %>&stockStatus=<%= query.stockStatus || 'all' %>&search=<%= query.search || '' %>" class="px-2.5 sm:px-3 py-1.5 rounded-lg border border-gray-200 bg-white hover:bg-gray-50 font-bold text-gray-700">
                  &larr; Prev
                </a>
              <% } %>
              <% for(let p = 1; p <= pagination.totalPages; p++) { %>
                <a href="/seller/inventory?page=<%= p %>&stockStatus=<%= query.stockStatus || 'all' %>&search=<%= query.search || '' %>" class="px-2.5 sm:px-3 py-1.5 rounded-lg font-bold transition-colors <%= p === pagination.page ? 'bg-[#123524] text-white' : 'border border-gray-200 bg-white text-gray-700 hover:bg-gray-50' %>">
                  <%= p %>
                </a>
              <% } %>
              <% if (pagination.hasNextPage) { %>
                <a href="/seller/inventory?page=<%= pagination.page + 1 %>&stockStatus=<%= query.stockStatus || 'all' %>&search=<%= query.search || '' %>" class="px-2.5 sm:px-3 py-1.5 rounded-lg border border-gray-200 bg-white hover:bg-gray-50 font-bold text-gray-700">
                  Next &rarr;
                </a>
              <% } %>
            </div>
          </div>
        <% } %>
      </div>

    </main>
  </div>

  <!-- Stock Adjustment Modal -->
  <div id="sellerStockModal" class="fixed inset-0 bg-black/60 z-50 flex items-center justify-center p-3 sm:p-4 hidden">
    <div class="bg-white rounded-2xl sm:rounded-3xl max-w-md w-full p-4 sm:p-6 shadow-xl space-y-4 max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between border-b border-gray-100 pb-3">
        <div>
          <h3 class="font-heading font-bold text-base text-[#123524]">Adjust Store Stock Level</h3>
          <span class="text-xs text-gray-400" id="stockModalProdName"></span>
        </div>
        <button onclick="document.getElementById('sellerStockModal').classList.add('hidden')" class="text-gray-400 hover:text-gray-600 font-bold text-lg p-1">&times;</button>
      </div>

      <form action="/seller/inventory/adjust" method="POST" class="space-y-4 text-xs">
        <input type="hidden" name="productId" id="stockModalProdId">

        <div class="p-3 bg-gray-50 rounded-2xl flex items-center justify-between">
          <span class="text-gray-500 font-medium">Current Stock on Storefront:</span>
          <span class="font-bold text-base text-[#123524]" id="stockModalCurrentVal">0</span>
        </div>

        <div class="space-y-1">
          <label class="font-bold text-gray-700">Adjustment Operation</label>
          <select name="actionType" class="w-full px-3 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none font-semibold">
            <option value="add">Add Inbound Units (+)</option>
            <option value="subtract">Deduct Units (-)</option>
            <option value="set">Set Exact Count (=)</option>
          </select>
        </div>

        <div class="space-y-1">
          <label class="font-bold text-gray-700">Adjustment Units Count *</label>
          <input type="number" name="adjustmentAmount" required min="1" placeholder="e.g. 25" class="w-full px-3 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none font-bold">
        </div>

        <div class="space-y-1">
          <label class="font-bold text-gray-700">Reason for Adjustment</label>
          <input type="text" name="reason" placeholder="e.g. Inbound shipment, Physical recount" class="w-full px-3 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none">
        </div>

        <div class="flex items-center justify-end gap-2 pt-2 border-t border-gray-100">
          <button type="button" onclick="document.getElementById('sellerStockModal').classList.add('hidden')" class="px-4 py-2 text-gray-600 hover:bg-gray-100 rounded-xl font-bold">
            Cancel
          </button>
          <button type="submit" class="px-5 py-2 bg-[#123524] hover:bg-[#1a4b33] text-white font-bold rounded-xl shadow-xs transition-colors">
            Confirm Adjustment
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function openStockModal(id, name, sku, currentStock) {
      document.getElementById('stockModalProdId').value = id;
      document.getElementById('stockModalProdName').innerText = name + (sku ? ` (${sku})` : '');
      document.getElementById('stockModalCurrentVal').innerText = currentStock + ' units';
      document.getElementById('sellerStockModal').classList.remove('hidden');
    }
  </script>
</body>
</html>
