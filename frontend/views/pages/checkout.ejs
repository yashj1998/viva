<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body class="min-h-screen flex flex-col bg-[#fafaf9] text-[#16261d]">
  
  <%- include('../partials/utility-bar') %>
  <%- include('../partials/header') %>

  <!-- Checkout Header -->
  <div class="bg-white border-b border-gray-100 py-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <a href="/cart" class="text-xs text-gray-500 hover:text-[#123524] flex items-center gap-1">
          <i class="fa-solid fa-chevron-left text-[10px]"></i>
          <span>Back to Cart</span>
        </a>
      </div>
      <div class="flex items-center gap-2 text-xs font-semibold text-emerald-800">
        <i class="fa-solid fa-lock text-xs"></i>
        <span>256-Bit SSL Encrypted Checkout</span>
      </div>
    </div>
  </div>

  <main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
    <form action="/checkout" method="POST" class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <input type="hidden" name="totalAmount" value="<%= total %>">

      <!-- Left Column: Shipping & Payment Steps -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- Customer Sign In Prompt or Status Banner -->
        <% if (typeof customer !== 'undefined' && customer) { %>
          <div class="bg-emerald-50 border border-emerald-200 p-4 rounded-2xl flex items-center justify-between text-xs text-emerald-900 shadow-2xs">
            <div class="flex items-center gap-2.5">
              <div class="w-7 h-7 rounded-full bg-[#123524] text-white flex items-center justify-center font-bold text-xs">
                <%= customer.name ? customer.name.charAt(0).toUpperCase() : 'U' %>
              </div>
              <div>
                <span class="font-bold">Logged in as <%= customer.name %></span>
                <span class="text-[11px] text-emerald-700 block"><%= customer.email %></span>
              </div>
            </div>
            <a href="/account" class="font-bold text-emerald-800 hover:underline">My Account</a>
          </div>
        <% } else { %>
          <div class="bg-white border border-gray-200 p-4 rounded-2xl flex items-center justify-between text-xs text-gray-700 shadow-2xs">
            <div class="flex items-center gap-2">
              <i class="fa-regular fa-user text-emerald-700"></i>
              <span>Already have an account?</span>
            </div>
            <a href="/login?redirect=/checkout" class="font-bold text-[#123524] hover:underline flex items-center gap-1">
              <span>Sign in for 1-click checkout</span>
              <i class="fa-solid fa-arrow-right text-[10px]"></i>
            </a>
          </div>
        <% } %>

        <% 
          const custAddr = (typeof customer !== 'undefined' && customer && customer.address) ? customer.address : null;
          const defaultFirstName = (typeof customer !== 'undefined' && customer && customer.name) ? customer.name.split(' ')[0] : '';
          const defaultLastName = (typeof customer !== 'undefined' && customer && customer.name) ? (customer.name.split(' ').slice(1).join(' ') || '') : '';
          const defaultEmail = (typeof customer !== 'undefined' && customer) ? customer.email : '';
          const defaultPhone = (typeof customer !== 'undefined' && customer) ? (customer.phone || '') : '';
          const defaultStreet = custAddr ? custAddr.street : '';
          const defaultCity = custAddr ? custAddr.city : '';
          const defaultZip = custAddr ? custAddr.zip : '';
        %>

        <!-- Step 1: Contact Information -->
        <div class="bg-white rounded-3xl border border-gray-100 p-6 shadow-2xs space-y-4">
          <h2 class="font-heading font-bold text-base text-[#0d2a1c] flex items-center gap-2">
            <span class="w-6 h-6 rounded-full bg-[#123524] text-white text-xs flex items-center justify-center">1</span>
            <span>Contact Information</span>
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1">
              <label class="text-xs font-semibold text-gray-600">Email Address *</label>
              <input type="email" name="email" value="<%= defaultEmail %>" required placeholder="you@example.com" class="w-full text-xs p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524]">
            </div>
            <div class="space-y-1">
              <label class="text-xs font-semibold text-gray-600">Phone Number *</label>
              <input type="tel" name="phone" value="<%= defaultPhone %>" required placeholder="+1 (555) 000-0000" class="w-full text-xs p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524]">
            </div>
          </div>
        </div>

        <!-- Step 2: Shipping Address -->
        <div class="bg-white rounded-3xl border border-gray-100 p-6 shadow-2xs space-y-4">
          <h2 class="font-heading font-bold text-base text-[#0d2a1c] flex items-center gap-2">
            <span class="w-6 h-6 rounded-full bg-[#123524] text-white text-xs flex items-center justify-center">2</span>
            <span>Shipping Address</span>
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1">
              <label class="text-xs font-semibold text-gray-600">First Name *</label>
              <input type="text" name="firstName" value="<%= defaultFirstName %>" required placeholder="First Name" class="w-full text-xs p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524]">
            </div>
            <div class="space-y-1">
              <label class="text-xs font-semibold text-gray-600">Last Name *</label>
              <input type="text" name="lastName" value="<%= defaultLastName %>" required placeholder="Last Name" class="w-full text-xs p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524]">
            </div>
            <div class="sm:col-span-2 space-y-1">
              <label class="text-xs font-semibold text-gray-600">Street Address *</label>
              <input type="text" name="address" value="<%= defaultStreet %>" required placeholder="123 Main St, Apt 4B" class="w-full text-xs p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524]">
            </div>
            <div class="space-y-1">
              <label class="text-xs font-semibold text-gray-600">City *</label>
              <input type="text" name="city" value="<%= defaultCity %>" required placeholder="City" class="w-full text-xs p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524]">
            </div>
            <div class="space-y-1">
              <label class="text-xs font-semibold text-gray-600">ZIP / Postal Code *</label>
              <input type="text" name="zip" value="<%= defaultZip %>" required placeholder="ZIP code" class="w-full text-xs p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524]">
            </div>
          </div>
        </div>


        <!-- Step 3: Payment Method -->
        <div class="bg-white rounded-3xl border border-gray-100 p-6 shadow-2xs space-y-4">
          <h2 class="font-heading font-bold text-base text-[#0d2a1c] flex items-center gap-2">
            <span class="w-6 h-6 rounded-full bg-[#123524] text-white text-xs flex items-center justify-center">3</span>
            <span>Payment Method</span>
          </h2>

          <div class="space-y-3">
            <label class="flex items-center justify-between p-3.5 border-2 border-[#123524] bg-[#123524]/5 rounded-2xl cursor-pointer">
              <div class="flex items-center gap-3">
                <input type="radio" name="paymentMethod" value="Credit Card" checked class="text-[#123524] focus:ring-[#123524]">
                <span class="text-xs font-semibold text-gray-900">Credit or Debit Card</span>
              </div>
              <div class="flex items-center gap-2 text-gray-500 text-sm">
                <i class="fa-brands fa-cc-visa"></i>
                <i class="fa-brands fa-cc-mastercard"></i>
                <i class="fa-brands fa-cc-amex"></i>
              </div>
            </label>

            <!-- Card Inputs -->
            <div class="bg-gray-50 p-4 rounded-2xl border border-gray-200 space-y-3">
              <div class="space-y-1">
                <label class="text-[11px] font-semibold text-gray-600">Card Number</label>
                <input type="text" placeholder="4242 &bull;&bull;&bull;&bull; &bull;&bull;&bull;&bull; 4242" value="4242 8492 1092 4242" class="w-full text-xs p-2.5 bg-white border border-gray-200 rounded-xl font-mono outline-none">
              </div>
              <div class="grid grid-cols-2 gap-3">
                <div class="space-y-1">
                  <label class="text-[11px] font-semibold text-gray-600">Expiry Date</label>
                  <input type="text" placeholder="MM/YY" value="12/28" class="w-full text-xs p-2.5 bg-white border border-gray-200 rounded-xl outline-none">
                </div>
                <div class="space-y-1">
                  <label class="text-[11px] font-semibold text-gray-600">CVC / CVV</label>
                  <input type="text" placeholder="123" value="894" class="w-full text-xs p-2.5 bg-white border border-gray-200 rounded-xl outline-none">
                </div>
              </div>
            </div>

            <label class="flex items-center justify-between p-3.5 border border-gray-200 hover:border-gray-300 rounded-2xl cursor-pointer">
              <div class="flex items-center gap-3">
                <input type="radio" name="paymentMethod" value="PayPal" class="text-[#123524] focus:ring-[#123524]">
                <span class="text-xs font-semibold text-gray-900">PayPal</span>
              </div>
              <i class="fa-brands fa-paypal text-blue-600 text-sm"></i>
            </label>

            <label class="flex items-center justify-between p-3.5 border border-gray-200 hover:border-gray-300 rounded-2xl cursor-pointer">
              <div class="flex items-center gap-3">
                <input type="radio" name="paymentMethod" value="Apple Pay" class="text-[#123524] focus:ring-[#123524]">
                <span class="text-xs font-semibold text-gray-900">Apple Pay</span>
              </div>
              <i class="fa-brands fa-apple text-gray-900 text-sm"></i>
            </label>
          </div>
        </div>

      </div>

      <!-- Right Column: Order Summary -->
      <div class="lg:col-span-5 space-y-6">
        <div class="bg-white rounded-3xl border border-gray-100 p-6 sm:p-7 shadow-2xs space-y-6 sticky top-24">
          
          <h2 class="font-heading font-bold text-lg text-[#0d2a1c] pb-3 border-b border-gray-100">
            Order Review (<%= (cartItems || []).length %> Items)
          </h2>

          <!-- Line Items List -->
          <div class="space-y-3 max-h-60 overflow-y-auto no-scrollbar">
            <% (cartItems || []).forEach(function(item) { %>
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 bg-gray-50 rounded-xl p-1 flex items-center justify-center shrink-0 border border-gray-100">
                <img src="<%= item.image %>" alt="<%= item.name %>" class="max-h-full max-w-full object-contain">
              </div>
              <div class="flex-1 min-w-0 text-xs">
                <h4 class="font-semibold text-gray-800 truncate"><%= item.name %></h4>
                <p class="text-gray-400 text-[11px]">Qty: <%= item.quantity %></p>
              </div>
              <span class="text-xs font-bold text-[#0d2a1c]">$<%= (item.price * item.quantity).toFixed(2) %></span>
            </div>
            <% }); %>
          </div>

          <!-- Price Summary -->
          <div class="space-y-2 text-xs text-gray-600 pt-4 border-t border-gray-100">
            <div class="flex justify-between">
              <span>Subtotal</span>
              <span class="font-semibold text-gray-900">$<%= subtotal %></span>
            </div>
            <div class="flex justify-between">
              <span>Shipping</span>
              <span class="font-semibold text-emerald-700">
                <%= Number(shippingFee) === 0 ? 'FREE' : '$' + shippingFee %>
              </span>
            </div>
            <div class="flex justify-between">
              <span>Sales Tax</span>
              <span class="font-semibold text-gray-900">$<%= tax %></span>
            </div>
            <div class="flex justify-between pt-3 border-t border-gray-100 items-baseline">
              <span class="font-heading font-bold text-sm text-[#0d2a1c]">Total</span>
              <span class="font-heading font-bold text-2xl text-[#123524]">$<%= total %></span>
            </div>
          </div>

          <!-- Place Order Button -->
          <button 
            type="submit" 
            class="w-full bg-[#123524] hover:bg-[#17422e] text-white font-semibold text-sm py-4 px-6 rounded-full flex items-center justify-center gap-2 transition-all duration-200 transform hover:-translate-y-0.5 shadow-sm"
          >
            <i class="fa-solid fa-lock text-xs"></i>
            <span>Complete Purchase — $<%= total %></span>
          </button>

          <p class="text-[11px] text-gray-400 text-center leading-relaxed">
            By clicking "Complete Purchase", you agree to ViVA's Terms of Service and 30-Day Return Guarantee.
          </p>

        </div>
      </div>

    </form>
  </main>

  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>

</body>
</html>
