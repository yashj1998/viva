<%- include('../partials/head') %>
<%- include('../partials/utility-bar') %>
<%- include('../partials/header') %>
<%- include('../partials/nav-bar') %>

<main class="min-h-[75vh] bg-[#fafaf9] py-8 sm:py-10 px-4 sm:px-6 lg:px-8">
  <div class="max-w-6xl mx-auto space-y-6">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-gray-500">
      <a href="/" class="hover:text-[#123524] transition-colors">Home</a>
      <span>&bull;</span>
      <span class="text-gray-800 font-semibold">My Account</span>
    </nav>

    <!-- Alerts -->
    <% if (typeof message !== 'undefined' && message) { %>
      <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-semibold flex items-center justify-between shadow-2xs">
        <div class="flex items-center gap-2">
          <i class="fa-solid fa-circle-check text-emerald-600 text-sm"></i>
          <span><%= message %></span>
        </div>
        <button onclick="this.parentElement.remove()" class="text-emerald-700 hover:text-emerald-900">&times;</button>
      </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-semibold flex items-center justify-between shadow-2xs">
        <div class="flex items-center gap-2">
          <i class="fa-solid fa-triangle-exclamation text-rose-600 text-sm"></i>
          <span><%= error %></span>
        </div>
        <button onclick="this.parentElement.remove()" class="text-rose-700 hover:text-rose-900">&times;</button>
      </div>
    <% } %>

    <!-- Customer Welcome Header Banner -->
    <div class="bg-white rounded-3xl border border-gray-200/80 p-6 sm:p-8 shadow-xs flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div class="flex items-center gap-4">
        <div class="w-16 h-16 rounded-full bg-[#123524] text-white flex items-center justify-center font-heading font-bold text-2xl shadow-sm shrink-0 border-2 border-emerald-100">
          <%= customer.name ? customer.name.charAt(0).toUpperCase() : 'U' %>
        </div>
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <h1 class="font-heading font-bold text-xl text-[#123524] leading-tight">
              <%= customer.name %>
            </h1>
            <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800">
              Verified Shopper
            </span>
          </div>
          <p class="text-xs text-gray-500 flex items-center gap-2">
            <span><i class="fa-regular fa-envelope text-gray-400"></i> <%= customer.email %></span>
            <% if (customer.phone) { %>
              <span>&bull;</span>
              <span><i class="fa-solid fa-phone text-gray-400"></i> <%= customer.phone %></span>
            <% } %>
          </p>
        </div>
      </div>

      <!-- Quick Metrics & Sign Out -->
      <div class="flex items-center gap-4 flex-wrap">
        <div class="flex items-center gap-3 border-r border-gray-100 pr-4">
          <div class="text-right">
            <span class="text-[10px] uppercase font-bold text-gray-400 block">Orders</span>
            <span class="font-heading font-bold text-base text-[#123524]"><%= stats.totalOrders %></span>
          </div>
          <div class="text-right">
            <span class="text-[10px] uppercase font-bold text-gray-400 block">Total Spent</span>
            <span class="font-heading font-bold text-base text-[#123524]">$<%= stats.totalSpent %></span>
          </div>
        </div>

        <a href="/logout" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold text-rose-700 bg-rose-50 hover:bg-rose-100 transition-colors">
          <i class="fa-solid fa-arrow-right-from-bracket text-xs"></i>
          <span>Sign Out</span>
        </a>
      </div>
    </div>

    <!-- Navigation Tabs Strip -->
    <div class="flex items-center gap-2 border-b border-gray-200 overflow-x-auto pb-1 text-xs font-semibold">
      <a 
        href="/account?tab=overview" 
        class="px-4 py-2.5 rounded-t-xl transition-colors whitespace-nowrap <%= (!activeTab || activeTab === 'overview') ? 'border-b-2 border-[#123524] text-[#123524] font-bold bg-white' : 'text-gray-500 hover:text-[#123524]' %>"
      >
        <i class="fa-solid fa-chart-pie mr-1.5"></i> Overview
      </a>
      <a 
        href="/account?tab=orders" 
        class="px-4 py-2.5 rounded-t-xl transition-colors whitespace-nowrap <%= activeTab === 'orders' ? 'border-b-2 border-[#123524] text-[#123524] font-bold bg-white' : 'text-gray-500 hover:text-[#123524]' %>"
      >
        <i class="fa-solid fa-receipt mr-1.5"></i> Order History (<%= orders.length %>)
      </a>
      <a 
        href="/account?tab=addresses" 
        class="px-4 py-2.5 rounded-t-xl transition-colors whitespace-nowrap <%= activeTab === 'addresses' ? 'border-b-2 border-[#123524] text-[#123524] font-bold bg-white' : 'text-gray-500 hover:text-[#123524]' %>"
      >
        <i class="fa-solid fa-map-location-dot mr-1.5"></i> Shipping Address
      </a>
      <a 
        href="/account?tab=security" 
        class="px-4 py-2.5 rounded-t-xl transition-colors whitespace-nowrap <%= activeTab === 'security' ? 'border-b-2 border-[#123524] text-[#123524] font-bold bg-white' : 'text-gray-500 hover:text-[#123524]' %>"
      >
        <i class="fa-solid fa-shield-halved mr-1.5"></i> Profile &amp; Password
      </a>
    </div>

    <!-- TAB 1: OVERVIEW -->
    <% if (!activeTab || activeTab === 'overview') { %>
      <div class="space-y-6">
        <!-- 3-Pillar Status Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="bg-white p-5 rounded-2xl border border-gray-200/80 shadow-2xs space-y-1">
            <span class="text-[10px] font-bold uppercase tracking-wider text-gray-400">Total Purchases</span>
            <div class="font-heading font-bold text-2xl text-[#123524]"><%= stats.totalOrders %> Orders</div>
            <p class="text-[11px] text-gray-500">Lifetime items ordered</p>
          </div>

          <div class="bg-white p-5 rounded-2xl border border-gray-200/80 shadow-2xs space-y-1">
            <span class="text-[10px] font-bold uppercase tracking-wider text-amber-600">Active Deliveries</span>
            <div class="font-heading font-bold text-2xl text-amber-700"><%= stats.activeOrders %> in Transit</div>
            <p class="text-[11px] text-gray-500">Processing or out for delivery</p>
          </div>

          <div class="bg-white p-5 rounded-2xl border border-gray-200/80 shadow-2xs space-y-1">
            <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-600">ViVA Rewards</span>
            <div class="font-heading font-bold text-2xl text-emerald-700">Tier 1 VIP</div>
            <p class="text-[11px] text-gray-500">Free shipping privileges active</p>
          </div>
        </div>

        <!-- Merchant & Seller Portal Banner -->
        <div class="bg-gradient-to-r from-[#123524] to-[#1d4d35] rounded-3xl p-6 text-white shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div class="space-y-1">
            <div class="inline-flex items-center gap-2 bg-amber-400/20 text-amber-300 px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider">
              <i class="fa-solid fa-store text-[9px]"></i> ViVA Seller Partner
            </div>
            <h3 class="font-heading font-bold text-lg text-white">Sell Products &amp; Grow Your Business on ViVA</h3>
            <p class="text-xs text-gray-300 max-w-xl">
              Access your dedicated Seller Dashboard to manage your store catalog, real-time inventory, customer orders, and payouts.
            </p>
          </div>
          <div class="flex items-center gap-3 shrink-0">
            <a href="/seller/dashboard" class="px-5 py-2.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-[#123524] font-bold text-xs transition-colors shadow-xs flex items-center gap-2">
              <i class="fa-solid fa-gauge-high text-xs"></i>
              <span>Open Seller Dashboard</span>
            </a>
          </div>
        </div>

        <!-- Recent Orders Teaser -->
        <div class="bg-white rounded-3xl border border-gray-200/80 p-6 shadow-xs space-y-4">
          <div class="flex items-center justify-between border-b border-gray-100 pb-3">
            <div>
              <h3 class="font-heading font-bold text-base text-[#123524]">Recent Orders</h3>
              <p class="text-xs text-gray-500">Track and view details of your latest purchases</p>
            </div>
            <a href="/account?tab=orders" class="text-xs font-bold text-emerald-700 hover:underline">View All &rarr;</a>
          </div>

          <% if (orders && orders.length > 0) { %>
            <div class="divide-y divide-gray-100">
              <% orders.slice(0, 3).forEach(order => { %>
                <div class="py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
                  <div class="space-y-1">
                    <div class="flex items-center gap-2">
                      <span class="font-bold text-gray-900">Order #<%= order.orderNumber %></span>
                      <span class="text-[10px] font-bold px-2 py-0.5 rounded-full <%= order.status === 'Delivered' ? 'bg-emerald-100 text-emerald-800' : (order.status === 'Shipped' ? 'bg-indigo-100 text-indigo-800' : 'bg-amber-100 text-amber-800') %>">
                        <%= order.status %>
                      </span>
                    </div>
                    <div class="text-gray-500 text-[11px]">
                      Placed on <%= new Date(order.createdAt || Date.now()).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %> &bull; <%= (order.items || []).length %> item(s)
                    </div>
                  </div>

                  <div class="flex items-center gap-4">
                    <span class="font-bold text-sm text-gray-900">$<%= parseFloat(order.total || 0).toFixed(2) %></span>
                    <a href="/track-order" class="px-3.5 py-1.5 rounded-xl border border-gray-200 text-gray-700 hover:bg-gray-50 font-bold transition-colors">
                      Track Package
                    </a>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <div class="py-8 text-center text-gray-400 text-xs">
              <i class="fa-solid fa-bag-shopping text-2xl mb-2 block text-gray-300"></i>
              You haven't placed any orders yet.
              <div class="mt-3">
                <a href="/shop" class="inline-flex items-center gap-1.5 px-4 py-2 bg-[#123524] text-white rounded-xl font-bold hover:bg-[#1a4b33]">
                  Start Shopping &rarr;
                </a>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    <% } %>

    <!-- TAB 2: ORDER HISTORY -->
    <% if (activeTab === 'orders') { %>
      <div class="bg-white rounded-3xl border border-gray-200/80 p-6 sm:p-8 shadow-xs space-y-5">
        <div>
          <h3 class="font-heading font-bold text-lg text-[#123524]">Complete Order History</h3>
          <p class="text-xs text-gray-500">Itemized record of all past deliveries and store purchases</p>
        </div>

        <% if (orders && orders.length > 0) { %>
          <div class="space-y-4">
            <% orders.forEach(order => { %>
              <div class="border border-gray-200 rounded-2xl p-5 space-y-4 hover:border-emerald-300 transition-colors">
                <!-- Order Top Header -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-gray-100 pb-3 text-xs">
                  <div class="flex items-center gap-3">
                    <span class="font-bold text-[#123524] text-sm">#<%= order.orderNumber %></span>
                    <span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full uppercase tracking-wider <%= order.status === 'Delivered' ? 'bg-emerald-100 text-emerald-800' : (order.status === 'Shipped' ? 'bg-indigo-100 text-indigo-800' : 'bg-amber-100 text-amber-800') %>">
                      <%= order.status %>
                    </span>
                  </div>
                  <div class="text-gray-500">
                    Placed: <%= new Date(order.createdAt || Date.now()).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %>
                  </div>
                </div>

                <!-- Order Items Grid -->
                <div class="space-y-2">
                  <% (order.items || []).forEach(item => { %>
                    <div class="flex items-center justify-between text-xs py-1">
                      <div class="flex items-center gap-3">
                        <img src="<%= item.image || '/images/products/headphones.png' %>" alt="<%= item.name %>" class="w-10 h-10 rounded-xl object-contain border border-gray-100 bg-[#fafaf9] p-1">
                        <div>
                          <div class="font-bold text-gray-800"><%= item.name %></div>
                          <div class="text-[10px] text-gray-400">Qty: <%= item.quantity || 1 %> &bull; $<%= parseFloat(item.price || 0).toFixed(2) %> each</div>
                        </div>
                      </div>
                      <span class="font-bold text-gray-900">$<%= ((item.price || 0) * (item.quantity || 1)).toFixed(2) %></span>
                    </div>
                  <% }) %>
                </div>

                <!-- Order Footer -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-3 border-t border-gray-100 text-xs">
                  <div class="text-gray-500 text-[11px]">
                    <i class="fa-solid fa-location-dot text-gray-400 mr-1"></i>
                    Shipping to: <%= order.customer?.address || '742 Evergreen Terrace' %>, <%= order.customer?.city || 'Springfield' %>
                  </div>
                  <div class="flex items-center gap-3">
                    <span class="font-bold text-sm text-gray-900">Total: $<%= parseFloat(order.total || 0).toFixed(2) %></span>
                    <a href="/track-order" class="px-3 py-1.5 rounded-xl bg-emerald-50 text-emerald-800 hover:bg-emerald-100 font-bold transition-colors">
                      Track Order &rarr;
                    </a>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="py-12 text-center text-gray-400 text-xs">
            <i class="fa-solid fa-receipt text-3xl mb-2 block text-gray-300"></i>
            No orders found under this account.
          </div>
        <% } %>
      </div>
    <% } %>

    <!-- TAB 3: SAVED ADDRESSES -->
    <% if (activeTab === 'addresses') { %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <!-- Current Default Address -->
        <div class="bg-white rounded-3xl border border-gray-200/80 p-6 shadow-xs space-y-4">
          <div class="flex items-center justify-between border-b border-gray-100 pb-3">
            <h3 class="font-heading font-bold text-base text-[#123524]">Default Shipping Address</h3>
            <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800">Primary</span>
          </div>

          <% const addr = (customer.addresses && customer.addresses.length > 0) ? customer.addresses[0] : null; %>
          <% if (addr) { %>
            <div class="space-y-1.5 text-xs text-gray-700 bg-gray-50/70 p-4 rounded-2xl border border-gray-100 leading-relaxed">
              <div class="font-bold text-sm text-gray-900"><%= customer.name %></div>
              <div><%= addr.street %></div>
              <div><%= addr.city %>, <%= addr.state %> <%= addr.zip %></div>
              <div class="text-gray-500"><%= addr.country || 'United States' %></div>
              <% if (customer.phone) { %>
                <div class="text-gray-500 mt-2"><i class="fa-solid fa-phone text-xs mr-1 text-gray-400"></i> <%= customer.phone %></div>
              <% } %>
            </div>
          <% } else { %>
            <div class="p-6 text-center text-gray-400 text-xs bg-gray-50/70 rounded-2xl border border-dashed border-gray-200">
              No shipping address saved yet. Fill the form to add one.
            </div>
          <% } %>
        </div>

        <!-- Add / Edit Address Form -->
        <div class="bg-white rounded-3xl border border-gray-200/80 p-6 shadow-xs space-y-4">
          <h3 class="font-heading font-bold text-base text-[#123524]">Update Shipping Address</h3>
          
          <form action="/account/address" method="POST" class="space-y-3 text-xs">
            <div>
              <label class="block font-bold text-gray-700 mb-1">Street Address *</label>
              <input type="text" name="street" value="<%= addr ? addr.street : '' %>" required placeholder="742 Evergreen Terrace" class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 outline-none focus:ring-2 focus:ring-[#123524]">
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block font-bold text-gray-700 mb-1">City *</label>
                <input type="text" name="city" value="<%= addr ? addr.city : '' %>" required placeholder="Springfield" class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 outline-none focus:ring-2 focus:ring-[#123524]">
              </div>
              <div>
                <label class="block font-bold text-gray-700 mb-1">State / Region *</label>
                <input type="text" name="state" value="<%= addr ? addr.state : '' %>" required placeholder="OR" class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 outline-none focus:ring-2 focus:ring-[#123524]">
              </div>
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block font-bold text-gray-700 mb-1">ZIP / Postal Code *</label>
                <input type="text" name="zip" value="<%= addr ? addr.zip : '' %>" required placeholder="97477" class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 outline-none focus:ring-2 focus:ring-[#123524]">
              </div>
              <div>
                <label class="block font-bold text-gray-700 mb-1">Country</label>
                <input type="text" name="country" value="<%= addr ? (addr.country || 'United States') : 'United States' %>" class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 outline-none focus:ring-2 focus:ring-[#123524]">
              </div>
            </div>

            <div class="pt-2">
              <button type="submit" class="w-full py-3 bg-[#123524] hover:bg-[#1a4b33] text-white font-bold rounded-xl transition-colors shadow-xs">
                Save Shipping Address
              </button>
            </div>
          </form>
        </div>

      </div>
    <% } %>

    <!-- TAB 4: PROFILE & SECURITY -->
    <% if (activeTab === 'security') { %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <!-- Personal Info Form -->
        <div class="bg-white rounded-3xl border border-gray-200/80 p-6 shadow-xs space-y-4">
          <div class="border-b border-gray-100 pb-3">
            <h3 class="font-heading font-bold text-base text-[#123524]">Personal Information</h3>
            <p class="text-xs text-gray-500">Update your primary contact details</p>
          </div>

          <form action="/account/profile" method="POST" class="space-y-4 text-xs">
            <div>
              <label class="block font-bold text-gray-700 mb-1">Full Name</label>
              <input type="text" name="name" value="<%= customer.name %>" required class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 outline-none focus:ring-2 focus:ring-[#123524]">
            </div>

            <div>
              <label class="block font-bold text-gray-700 mb-1">Email Address</label>
              <input type="email" value="<%= customer.email %>" disabled class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 bg-gray-50 text-gray-500 cursor-not-allowed">
              <span class="text-[10px] text-gray-400 mt-1 block">To change your primary email, contact customer support.</span>
            </div>

            <div>
              <label class="block font-bold text-gray-700 mb-1">Phone Number</label>
              <input type="tel" name="phone" value="<%= customer.phone || '' %>" placeholder="+1 (555) 000-0000" class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 outline-none focus:ring-2 focus:ring-[#123524]">
            </div>

            <button type="submit" class="w-full py-3 bg-[#123524] hover:bg-[#1a4b33] text-white font-bold rounded-xl transition-colors shadow-xs">
              Save Profile Changes
            </button>
          </form>
        </div>

        <!-- Password Change Form -->
        <div class="bg-white rounded-3xl border border-gray-200/80 p-6 shadow-xs space-y-4">
          <div class="border-b border-gray-100 pb-3">
            <h3 class="font-heading font-bold text-base text-[#123524]">Security &amp; Password</h3>
            <p class="text-xs text-gray-500">Change your account login credentials</p>
          </div>

          <form action="/account/password" method="POST" class="space-y-4 text-xs">
            <div>
              <label class="block font-bold text-gray-700 mb-1">Current Password *</label>
              <input type="password" name="currentPassword" required placeholder="••••••••" class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 outline-none focus:ring-2 focus:ring-[#123524]">
            </div>

            <div>
              <label class="block font-bold text-gray-700 mb-1">New Password (Min 6 chars) *</label>
              <input type="password" name="newPassword" required minlength="6" placeholder="••••••••" class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 outline-none focus:ring-2 focus:ring-[#123524]">
            </div>

            <div>
              <label class="block font-bold text-gray-700 mb-1">Confirm New Password *</label>
              <input type="password" name="confirmNewPassword" required minlength="6" placeholder="••••••••" class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 outline-none focus:ring-2 focus:ring-[#123524]">
            </div>

            <button type="submit" class="w-full py-3 bg-[#123524] hover:bg-[#1a4b33] text-white font-bold rounded-xl transition-colors shadow-xs">
              Update Password
            </button>
          </form>
        </div>

      </div>
    <% } %>

  </div>
</main>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
