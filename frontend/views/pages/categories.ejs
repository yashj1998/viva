<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body class="min-h-screen flex flex-col bg-[#fafaf9] text-[#16261d]">
  
  <%- include('../partials/utility-bar') %>
  <%- include('../partials/header') %>
  <%- include('../partials/nav-bar') %>

  <!-- Categories Directory Header -->
  <div class="bg-[#f3efe3] border-b border-gray-200/60 py-10 sm:py-14 text-center">
    <div class="max-w-2xl mx-auto px-4 space-y-2">
      <span class="text-xs font-bold uppercase tracking-widest text-[#2c6b48]">All Departments</span>
      <h1 class="font-heading font-bold text-3xl sm:text-4xl text-[#0d2a1c] tracking-tight">
        Explore Every Category
      </h1>
      <p class="text-xs sm:text-sm text-gray-600">
        From everyday kitchenware to cutting-edge audio gear and seasonal fashion, find what you need.
      </p>
    </div>
  </div>

  <!-- Categories Grid -->
  <main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full space-y-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <% (categories || []).forEach(function(cat) { %>
      <a 
        href="/shop?category=<%= cat.slug %>" 
        class="bg-white rounded-3xl border border-gray-100 p-6 shadow-2xs hover:shadow-md transition-all duration-200 flex flex-col justify-between group"
      >
        <div class="space-y-4">
          <div class="w-14 h-14 rounded-2xl flex items-center justify-center text-xl transition-transform group-hover:scale-110 shadow-2xs" style="background-color: <%= cat.bgColor || '#f1f5f9' %>;">
            <i class="<%= cat.iconClass %>" style="color: <%= cat.iconColor || '#123524' %>;"></i>
          </div>

          <div>
            <h3 class="font-heading font-bold text-lg text-[#0d2a1c] group-hover:text-[#2c6b48] transition-colors">
              <%= cat.name %>
            </h3>
            <span class="text-xs text-gray-400 font-medium block mt-0.5">
              <%= cat.productCount || 12 %> Curated Products
            </span>
          </div>
        </div>

        <div class="pt-6 mt-6 border-t border-gray-50 flex items-center justify-between text-xs font-semibold text-[#123524] group-hover:text-[#2c6b48]">
          <span>Shop Department</span>
          <i class="fa-solid fa-arrow-right text-[10px] transform group-hover:translate-x-1 transition-transform"></i>
        </div>
      </a>
      <% }); %>
    </div>
  </main>

  <%- include('../partials/trust-strip') %>
  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>

</body>
</html>
