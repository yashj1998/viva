<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body class="min-h-screen flex flex-col bg-[#fafaf9] text-[#16261d]">
  
  <%- include('../partials/utility-bar') %>
  <%- include('../partials/header') %>
  <%- include('../partials/nav-bar') %>

  <!-- Brands Header -->
  <div class="bg-[#f3efe3] border-b border-gray-200/60 py-10 sm:py-14 text-center">
    <div class="max-w-4xl mx-auto px-4">
      <span class="text-xs font-bold uppercase tracking-widest text-[#2c6b48]">Authorized Brand Partners</span>
      <h1 class="font-heading font-bold text-3xl sm:text-4xl text-[#0d2a1c] tracking-tight mt-2">
        Curated Brands You Trust
      </h1>
      <p class="text-xs sm:text-sm text-gray-600 mt-2 max-w-xl mx-auto">
        We partner directly with leading heritage makers and modern innovators to bring authentic quality directly to your doorstep.
      </p>
    </div>
  </div>

  <!-- Brands Directory Grid -->
  <main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full space-y-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% (brands || []).forEach(function(brand) { %>
      <div class="bg-white rounded-3xl border border-gray-100 p-6 sm:p-7 shadow-2xs hover:shadow-md transition-all duration-200 flex flex-col justify-between group">
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <div class="w-12 h-12 rounded-2xl flex items-center justify-center text-lg text-[#123524] transition-transform group-hover:scale-110" style="background-color: <%= brand.bg %>;">
              <i class="<%= brand.logoIcon %>"></i>
            </div>
            <span class="text-xs font-semibold text-gray-400 bg-gray-50 px-2.5 py-1 rounded-full border border-gray-100">
              <%= brand.count %> Products
            </span>
          </div>

          <div>
            <h3 class="font-heading font-bold text-xl text-[#0d2a1c] group-hover:text-[#2c6b48] transition-colors">
              <%= brand.name %>
            </h3>
            <span class="text-xs font-medium text-[#2c6b48] block mt-0.5">
              <%= brand.tag %>
            </span>
            <p class="text-xs text-gray-500 mt-2 leading-relaxed">
              <%= brand.desc %>
            </p>
          </div>
        </div>

        <div class="pt-6 border-t border-gray-50 mt-6">
          <a href="/shop?q=<%= brand.name.toLowerCase() %>" class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#123524] hover:text-[#2c6b48] transition-colors">
            <span>Explore <%= brand.name %> Catalog</span>
            <i class="fa-solid fa-arrow-right text-[10px]"></i>
          </a>
        </div>
      </div>
      <% }); %>
    </div>

    <!-- Featured Brand Products -->
    <div class="space-y-6 pt-6">
      <h2 class="font-heading font-bold text-xl text-[#0d2a1c]">Featured Partner Items</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 sm:gap-5">
        <% (products || []).forEach(function(prod) { %>
          <%- include('../partials/product-card', { product: prod }) %>
        <% }); %>
      </div>
    </div>
  </main>

  <%- include('../partials/trust-strip') %>
  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>

</body>
</html>
