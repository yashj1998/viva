<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body class="min-h-screen flex flex-col bg-[#fafaf9] text-[#16261d]">
  
  <%- include('../partials/utility-bar') %>
  <%- include('../partials/header') %>
  <%- include('../partials/nav-bar') %>

  <!-- Inspiration Header -->
  <div class="bg-[#f7ece2] border-b border-[#ebd7c8] py-10 sm:py-14 text-center">
    <div class="max-w-3xl mx-auto px-4">
      <span class="text-xs font-bold uppercase tracking-widest text-[#2c6b48]">The Modern Living Journal</span>
      <h1 class="font-heading font-bold text-3xl sm:text-4xl lg:text-5xl text-[#0d2a1c] tracking-tight mt-2">
        Inspiration For Everyday Living
      </h1>
      <p class="text-xs sm:text-sm text-gray-600 mt-3 leading-relaxed">
        Design tips, curated spaces, and thoughtfully chosen essentials to help you live better every day.
      </p>
    </div>
  </div>

  <!-- Lookbooks Grid -->
  <main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full space-y-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <% (lookbooks || []).forEach(function(look) { %>
      <article class="bg-white rounded-3xl border border-gray-100 overflow-hidden shadow-2xs hover:shadow-md transition-all duration-200 flex flex-col justify-between group">
        <div>
          <!-- Article Image Banner -->
          <div class="h-56 p-6 flex items-center justify-center relative overflow-hidden" style="background-color: <%= look.bg %>;">
            <span class="absolute top-4 left-4 bg-white/90 backdrop-blur-xs text-[#123524] text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider">
              <%= look.category %>
            </span>
            <img src="<%= look.image %>" alt="<%= look.title %>" class="max-h-40 w-auto object-contain drop-shadow-sm group-hover:scale-105 transition-transform duration-300">
          </div>

          <!-- Content -->
          <div class="p-6 space-y-3">
            <div class="text-[11px] text-gray-400 font-medium">
              <i class="fa-regular fa-clock text-[10px]"></i> <%= look.readTime %>
            </div>
            <h2 class="font-heading font-bold text-lg text-[#0d2a1c] leading-snug group-hover:text-[#2c6b48] transition-colors">
              <%= look.title %>
            </h2>
            <p class="text-xs text-gray-600 leading-relaxed">
              <%= look.excerpt %>
            </p>
          </div>
        </div>

        <!-- Featured Items inside this look -->
        <div class="px-6 pb-6 pt-2 border-t border-gray-50">
          <div class="text-[11px] font-semibold text-gray-400 uppercase tracking-wider mb-2">Featured In This Story</div>
          <div class="flex flex-wrap gap-1.5">
            <% look.items.forEach(function(item) { %>
            <a href="/shop?q=<%= item.toLowerCase() %>" class="text-[11px] bg-gray-100 hover:bg-[#123524] hover:text-white px-2.5 py-1 rounded-full text-gray-700 font-medium transition-colors">
              <%= item %>
            </a>
            <% }); %>
          </div>
        </div>
      </article>
      <% }); %>
    </div>
  </main>

  <%- include('../partials/trust-strip') %>
  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>

</body>
</html>
