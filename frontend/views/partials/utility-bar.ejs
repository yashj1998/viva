<!-- Utility Trust Bar -->
<% const st = (typeof siteSettings !== 'undefined' && siteSettings) ? siteSettings : {}; %>
<div class="bg-[#123524] text-white text-[11px] sm:text-xs py-1.5 sm:py-2 px-3 sm:px-4 border-b border-[#1b4330]">
  <div class="max-w-7xl mx-auto flex items-center justify-center sm:justify-center gap-3 sm:gap-8 font-medium">
    <% if (st.announcementText) { %>
    <a href="<%= st.announcementUrl || '/shop' %>" class="flex items-center gap-1.5 hover:text-emerald-200 transition-colors truncate">
      <span class="text-xs sm:text-sm shrink-0">🎉</span>
      <span class="truncate sm:overflow-visible"><%= st.announcementText %></span>
    </a>
    <span class="hidden sm:inline text-white/40">|</span>
    <div class="hidden sm:flex items-center gap-1.5">
      <span class="text-sm">🔄</span>
      <span>30-Day Easy Returns</span>
    </div>
    <span class="hidden sm:inline text-white/40">|</span>
    <div class="hidden sm:flex items-center gap-1.5">
      <span class="text-sm">🔒</span>
      <span>100% Secure Checkout</span>
    </div>
    <span class="hidden md:inline text-white/40">|</span>
    <a href="/seller/dashboard" class="hidden md:inline-flex items-center gap-1.5 bg-white/10 hover:bg-white/20 text-emerald-200 hover:text-white px-2.5 py-0.5 rounded-full transition-all text-[11px] font-semibold">
      <i class="fa-solid fa-store text-[10px] text-amber-300"></i>
      <span>Sell on ViVA</span>
    </a>
    <% } else { %>
    <a href="/shop" class="flex items-center gap-1.5 hover:text-emerald-200 transition-colors truncate">
      <span class="text-xs sm:text-sm shrink-0">🎉</span>
      <span class="truncate sm:overflow-visible">FLASH SALE: Extra 25% Off All Living Essentials Today Only!</span>
    </a>
    <span class="hidden sm:inline text-white/40">|</span>
    <div class="hidden sm:flex items-center gap-1.5">
      <span class="text-sm">🔄</span>
      <span>30-Day Easy Returns</span>
    </div>
    <span class="hidden sm:inline text-white/40">|</span>
    <div class="hidden sm:flex items-center gap-1.5">
      <span class="text-sm">🔒</span>
      <span>100% Secure Checkout</span>
    </div>
    <span class="hidden md:inline text-white/40">|</span>
    <a href="/seller/dashboard" class="hidden md:inline-flex items-center gap-1.5 bg-white/10 hover:bg-white/20 text-emerald-200 hover:text-white px-2.5 py-0.5 rounded-full transition-all text-[11px] font-semibold">
      <i class="fa-solid fa-store text-[10px] text-amber-300"></i>
      <span>Sell on ViVA</span>
    </a>
    <% } %>
  </div>
</div>
