<!-- ==========================================================================
     ViVA E-Commerce — Floating Mobile App Bottom Navigation Bar
     Pixel-perfect match to modern phone app navigation with standalone cart button
     ========================================================================== -->

<% 
  const curPage = typeof activePage !== 'undefined' ? activePage : '';
  const currentCartCount = typeof cartCount !== 'undefined' ? cartCount : 2;
  const currentWishlistCount = typeof wishlistCount !== 'undefined' ? wishlistCount : 3;
%>

<!-- Outer Fixed Container (Mobile & Tablet: md:hidden) -->
<nav 
  id="viva-mobile-bottom-nav" 
  aria-label="Mobile Bottom Navigation"
  class="fixed bottom-4 sm:bottom-6 left-0 right-0 z-50 flex items-center justify-center gap-2.5 sm:gap-3 px-4 pointer-events-none md:hidden transition-transform duration-300"
  style="bottom: calc(0.85rem + env(safe-area-inset-bottom, 0px));"
>

  <!-- 1. Main Floating Pill Container -->
  <div class="pointer-events-auto bg-white/95 backdrop-blur-md rounded-full border border-black/[0.06] shadow-[0_10px_25px_-3px_rgba(0,0,0,0.1),0_4px_10px_-2px_rgba(0,0,0,0.04)] p-1.5 flex items-center gap-1 sm:gap-1.5 transition-all">
    
    <!-- Tab 1: Home -->
    <a 
      href="/" 
      id="mobile-tab-home"
      data-tab="home"
      class="mobile-nav-tab group relative flex items-center rounded-full transition-all duration-200 active:scale-95 <%= (curPage === 'home' || curPage === '') ? 'bg-[#ebedf0] text-gray-950 px-3.5 sm:px-4 py-2 font-semibold text-xs shadow-xs' : 'w-10 h-10 justify-center text-gray-400 hover:text-gray-900' %>"
      aria-label="Home"
    >
      <svg class="w-[19px] h-[19px] shrink-0 <%= (curPage === 'home' || curPage === '') ? 'text-gray-950 fill-current' : 'fill-current text-gray-400 group-hover:text-gray-900 transition-colors' %>" viewBox="0 0 24 24">
        <path d="M11.265 2.478a1.2 1.2 0 0 1 1.47 0l7.8 6.066A1.5 1.5 0 0 1 21 9.725V19.5A2.5 2.5 0 0 1 18.5 22h-13A2.5 2.5 0 0 1 3 19.5V9.725a1.5 1.5 0 0 1 .465-1.181l7.8-6.066Z"/>
      </svg>
      <span class="tab-label text-xs sm:text-[13px] font-semibold tracking-tight ml-2 <%= (curPage === 'home' || curPage === '') ? 'inline-block' : 'hidden' %>">Home</span>
    </a>

    <!-- Tab 2: Search (Opens Mobile Quick Search or Shop) -->
    <button 
      type="button"
      id="mobile-tab-search"
      data-tab="shop"
      class="mobile-nav-tab group relative flex items-center rounded-full transition-all duration-200 active:scale-95 cursor-pointer <%= curPage === 'shop' ? 'bg-[#ebedf0] text-gray-950 px-3.5 sm:px-4 py-2 font-semibold text-xs shadow-xs' : 'w-10 h-10 justify-center text-gray-400 hover:text-gray-900' %>"
      aria-label="Search"
    >
      <svg class="w-[19px] h-[19px] shrink-0 <%= curPage === 'shop' ? 'text-gray-950' : 'text-gray-400 group-hover:text-gray-900 transition-colors' %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="7.5"/>
        <path d="m16.5 16.5 4.5 4.5"/>
      </svg>
      <span class="tab-label text-xs sm:text-[13px] font-semibold tracking-tight ml-2 <%= curPage === 'shop' ? 'inline-block' : 'hidden' %>">Search</span>
    </button>

    <!-- Tab 3: Wishlist -->
    <a 
      href="/wishlist" 
      id="mobile-tab-wishlist"
      data-tab="wishlist"
      class="mobile-nav-tab group relative flex items-center rounded-full transition-all duration-200 active:scale-95 <%= curPage === 'wishlist' ? 'bg-[#ebedf0] text-gray-950 px-3.5 sm:px-4 py-2 font-semibold text-xs shadow-xs' : 'w-10 h-10 justify-center text-gray-400 hover:text-gray-900' %>"
      aria-label="Wishlist"
    >
      <svg class="w-[19px] h-[19px] shrink-0 <%= curPage === 'wishlist' ? 'text-gray-950' : 'text-gray-400 group-hover:text-gray-900 transition-colors' %>" viewBox="0 0 24 24" fill="<%= curPage === 'wishlist' ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round">
        <path d="M19.5 12.572 12 20l-7.5-7.428A5 5 0 1 1 12 6.006a5 5 0 1 1 7.5 6.572Z"/>
      </svg>
      <span class="tab-label text-xs sm:text-[13px] font-semibold tracking-tight ml-2 <%= curPage === 'wishlist' ? 'inline-block' : 'hidden' %>">Saved</span>
      <span id="mobile-bottom-wishlist-dot" class="absolute top-2 right-2 w-2 h-2 rounded-full bg-[#ea4335] ring-2 ring-white <%= (currentWishlistCount > 0 && curPage !== 'wishlist') ? '' : 'hidden' %>"></span>
    </a>

    <!-- Tab 4: Deals / Notifications -->
    <a 
      href="/deals" 
      id="mobile-tab-deals"
      data-tab="deals"
      class="mobile-nav-tab group relative flex items-center rounded-full transition-all duration-200 active:scale-95 <%= curPage === 'deals' ? 'bg-[#ebedf0] text-gray-950 px-3.5 sm:px-4 py-2 font-semibold text-xs shadow-xs' : 'w-10 h-10 justify-center text-gray-400 hover:text-gray-900' %>"
      aria-label="Deals & Offers"
    >
      <svg class="w-[19px] h-[19px] shrink-0 <%= curPage === 'deals' ? 'text-gray-950' : 'text-gray-400 group-hover:text-gray-900 transition-colors' %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/>
        <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/>
      </svg>
      <span class="tab-label text-xs sm:text-[13px] font-semibold tracking-tight ml-2 <%= curPage === 'deals' ? 'inline-block' : 'hidden' %>">Deals</span>
      <% if (curPage !== 'deals') { %>
        <span class="absolute top-2 right-2.5 w-1.5 h-1.5 rounded-full bg-[#ea4335]"></span>
      <% } %>
    </a>

  </div>

  <!-- 2. Standalone Floating Cart Button (Right Side Circle) -->
  <a 
    href="/cart" 
    id="mobile-bottom-cart-btn"
    aria-label="Shopping Cart"
    class="pointer-events-auto w-[50px] h-[50px] sm:w-13 sm:h-13 rounded-full bg-white/95 backdrop-blur-md shadow-[0_10px_25px_-3px_rgba(0,0,0,0.1),0_4px_10px_-2px_rgba(0,0,0,0.04)] border border-black/[0.06] flex items-center justify-center relative active:scale-90 transition-all text-gray-900 hover:text-[#123524] <%= curPage === 'cart' ? 'ring-2 ring-[#123524]' : '' %>"
  >
    <!-- Shopping Cart Icon -->
    <svg class="w-5 h-5 text-gray-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="9" cy="21" r="1"/>
      <circle cx="20" cy="21" r="1"/>
      <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
    </svg>

    <!-- Red Circular Notification Badge -->
    <span 
      id="mobile-bottom-cart-badge" 
      class="absolute -top-1 -right-1 bg-[#ea4335] text-white text-[10.5px] font-bold min-w-[20px] h-[20px] px-1 rounded-full flex items-center justify-center shadow-xs ring-2 ring-white leading-none transition-transform"
    >
      <%= currentCartCount %>
    </span>
  </a>

</nav>

<!-- 3. Mobile App Quick Search Slide-up Bottom Sheet -->
<div 
  id="mobile-search-sheet" 
  class="fixed inset-0 z-50 bg-black/40 backdrop-blur-xs opacity-0 pointer-events-none transition-opacity duration-200 md:hidden flex items-end"
  aria-modal="true" 
  role="dialog"
>
  <div 
    id="mobile-search-panel"
    class="w-full bg-white rounded-t-[28px] p-5 shadow-2xl border-t border-gray-100 transform translate-y-full transition-transform duration-300 max-h-[85vh] overflow-y-auto space-y-4"
  >
    <!-- Handle Bar -->
    <div class="w-12 h-1.5 bg-gray-300 rounded-full mx-auto -mt-1 mb-2"></div>

    <!-- Header & Close -->
    <div class="flex items-center justify-between pb-1">
      <h3 class="font-heading font-bold text-base text-[#0d2a1c] flex items-center gap-2">
        <i class="fa-solid fa-magnifying-glass text-emerald-700 text-sm"></i>
        <span>Search ViVA Store</span>
      </h3>
      <button 
        type="button" 
        id="close-mobile-search"
        class="w-8 h-8 rounded-full bg-gray-100 hover:bg-gray-200 text-gray-500 flex items-center justify-center text-xs transition-colors cursor-pointer"
        aria-label="Close search"
      >
        <i class="fa-solid fa-xmark text-sm"></i>
      </button>
    </div>

    <!-- Live Search Input Form -->
    <form action="/shop" method="GET" class="relative flex items-center">
      <input 
        type="text" 
        id="mobile-search-input"
        name="q" 
        placeholder="What are you looking for today?" 
        class="w-full bg-gray-100 hover:bg-gray-50 focus:bg-white text-sm text-[#16261d] placeholder-gray-400 pl-4 pr-12 py-3 rounded-2xl border border-gray-200 focus:border-[#123524] focus:ring-2 focus:ring-[#123524]/10 transition-all outline-none"
        autocomplete="off"
      >
      <button 
        type="submit" 
        class="absolute right-2 w-8 h-8 rounded-xl bg-[#123524] hover:bg-[#17422e] text-white flex items-center justify-center text-xs transition-transform active:scale-95"
        aria-label="Submit search"
      >
        <i class="fa-solid fa-arrow-right"></i>
      </button>
    </form>

    <!-- Trending Searches Tags -->
    <div class="pt-2">
      <div class="text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-2.5">
        Trending Searches
      </div>
      <div class="flex flex-wrap gap-2">
        <a href="/shop?q=Headphones" class="px-3 py-1.5 rounded-full bg-gray-100 hover:bg-[#123524] hover:text-white text-gray-700 text-xs font-medium transition-colors">
          🎧 Headphones
        </a>
        <a href="/shop?q=Linen" class="px-3 py-1.5 rounded-full bg-gray-100 hover:bg-[#123524] hover:text-white text-gray-700 text-xs font-medium transition-colors">
          👕 Linen Shirts
        </a>
        <a href="/shop?q=Coffee" class="px-3 py-1.5 rounded-full bg-gray-100 hover:bg-[#123524] hover:text-white text-gray-700 text-xs font-medium transition-colors">
          ☕ Coffee Machines
        </a>
        <a href="/shop?q=Lamp" class="px-3 py-1.5 rounded-full bg-gray-100 hover:bg-[#123524] hover:text-white text-gray-700 text-xs font-medium transition-colors">
          🛋️ Nordic Lamps
        </a>
        <a href="/shop?q=Serum" class="px-3 py-1.5 rounded-full bg-gray-100 hover:bg-[#123524] hover:text-white text-gray-700 text-xs font-medium transition-colors">
          ✨ Botanical Serum
        </a>
      </div>
    </div>

    <!-- Quick Department Links -->
    <div class="pt-2 border-t border-gray-100">
      <div class="text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-2.5">
        Popular Departments
      </div>
      <div class="grid grid-cols-2 gap-2">
        <a href="/shop?category=Electronics" class="flex items-center gap-2.5 p-2 rounded-xl bg-gray-50 hover:bg-emerald-50 text-xs text-gray-800 transition-colors">
          <span class="w-6 h-6 rounded-lg bg-emerald-100 text-emerald-800 flex items-center justify-center text-[10px] shrink-0">
            <i class="fa-solid fa-laptop"></i>
          </span>
          <span class="font-medium truncate">Electronics</span>
        </a>
        <a href="/shop?category=Fashion" class="flex items-center gap-2.5 p-2 rounded-xl bg-gray-50 hover:bg-amber-50 text-xs text-gray-800 transition-colors">
          <span class="w-6 h-6 rounded-lg bg-amber-100 text-amber-800 flex items-center justify-center text-[10px] shrink-0">
            <i class="fa-solid fa-shirt"></i>
          </span>
          <span class="font-medium truncate">Fashion</span>
        </a>
        <a href="/shop?category=Home%20%26%20Living" class="flex items-center gap-2.5 p-2 rounded-xl bg-gray-50 hover:bg-blue-50 text-xs text-gray-800 transition-colors">
          <span class="w-6 h-6 rounded-lg bg-blue-100 text-blue-800 flex items-center justify-center text-[10px] shrink-0">
            <i class="fa-solid fa-couch"></i>
          </span>
          <span class="font-medium truncate">Home & Living</span>
        </a>
        <a href="/shop?category=Beauty" class="flex items-center gap-2.5 p-2 rounded-xl bg-gray-50 hover:bg-rose-50 text-xs text-gray-800 transition-colors">
          <span class="w-6 h-6 rounded-lg bg-rose-100 text-rose-800 flex items-center justify-center text-[10px] shrink-0">
            <i class="fa-solid fa-wand-magic-sparkles"></i>
          </span>
          <span class="font-medium truncate">Beauty Care</span>
        </a>
      </div>
    </div>

    <!-- View All Catalog Button -->
    <div class="pt-2">
      <a href="/shop" class="w-full bg-[#123524] text-white text-xs font-semibold py-3 rounded-2xl flex items-center justify-center gap-2 hover:bg-[#17422e] transition-colors">
        <span>Browse All Products</span>
        <i class="fa-solid fa-arrow-right text-[10px]"></i>
      </a>
    </div>

  </div>
</div>

<!-- 4. Mobile Bottom Nav Logic (Client-Side) -->
<script>
  (function() {
    // Quick Search Sheet Open/Close
    const searchBtn = document.getElementById('mobile-tab-search');
    const sheet = document.getElementById('mobile-search-sheet');
    const panel = document.getElementById('mobile-search-panel');
    const closeBtn = document.getElementById('close-mobile-search');
    const searchInput = document.getElementById('mobile-search-input');

    function openSearch() {
      if (!sheet || !panel) return;
      sheet.classList.remove('opacity-0', 'pointer-events-none');
      sheet.classList.add('opacity-100', 'pointer-events-auto');
      panel.classList.remove('translate-y-full');
      panel.classList.add('translate-y-0');
      document.body.style.overflow = 'hidden';
      setTimeout(function() {
        if (searchInput) searchInput.focus();
      }, 200);
    }

    function closeSearch() {
      if (!sheet || !panel) return;
      sheet.classList.remove('opacity-100', 'pointer-events-auto');
      sheet.classList.add('opacity-0', 'pointer-events-none');
      panel.classList.remove('translate-y-0');
      panel.classList.add('translate-y-full');
      document.body.style.overflow = '';
    }

    if (searchBtn) {
      searchBtn.addEventListener('click', function(e) {
        e.preventDefault();
        openSearch();
      });
    }

    // Also attach mobile search trigger in top header to open this exact mobile sheet
    const topMobileSearchTrigger = document.querySelector('header a[href="/shop"].md\\:hidden');
    if (topMobileSearchTrigger) {
      topMobileSearchTrigger.addEventListener('click', function(e) {
        e.preventDefault();
        openSearch();
      });
    }

    if (closeBtn) {
      closeBtn.addEventListener('click', closeSearch);
    }

    if (sheet) {
      sheet.addEventListener('click', function(e) {
        if (e.target === sheet) closeSearch();
      });
    }

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeSearch();
    });

    // Auto active tab detection based on URL
    const pathname = window.location.pathname;
    const tabs = document.querySelectorAll('.mobile-nav-tab');
    
    // Determine active tab identifier
    let currentTab = '';
    if (pathname.includes('/shop') || pathname.includes('/categories')) {
      currentTab = 'shop';
    } else if (pathname.includes('/wishlist')) {
      currentTab = 'wishlist';
    } else if (pathname.includes('/deals')) {
      currentTab = 'deals';
    } else if (pathname === '/' || pathname === '') {
      currentTab = 'home';
    }

    if (currentTab) {
      tabs.forEach(function(tab) {
        const tabType = tab.getAttribute('data-tab');
        const label = tab.querySelector('.tab-label');
        const svg = tab.querySelector('svg');

        if (tabType === currentTab) {
          tab.className = 'mobile-nav-tab group relative flex items-center rounded-full transition-all duration-200 active:scale-95 bg-[#ebedf0] text-gray-950 px-3.5 sm:px-4 py-2 font-semibold text-xs shadow-xs';
          if (label) {
            label.classList.remove('hidden');
            label.classList.add('inline-block');
          }
          if (svg) {
            svg.classList.remove('text-gray-400');
            svg.classList.add('text-gray-950');
            if (tabType === 'home') svg.classList.add('fill-current');
          }
        } else {
          tab.className = 'mobile-nav-tab group relative flex items-center rounded-full transition-all duration-200 active:scale-95 w-10 h-10 justify-center text-gray-400 hover:text-gray-900';
          if (label) {
            label.classList.add('hidden');
            label.classList.remove('inline-block');
          }
          if (svg) {
            svg.classList.remove('text-gray-950');
            svg.classList.add('text-gray-400');
          }
        }
      });
    }
  })();
</script>
