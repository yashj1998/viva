<!-- Primary Navigation Bar -->
<% const current = typeof activePage !== 'undefined' ? activePage : ''; %>
<nav class="bg-white border-b border-gray-100 py-2 sm:py-2.5 relative z-30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-3 sm:gap-6 lg:gap-8 overflow-x-auto no-scrollbar scroll-smooth">
    
    <!-- All Categories Trigger Pill with Interactive Dropdown -->
    <div class="relative group shrink-0">
      <a 
        href="/categories" 
        id="all-categories-btn"
        class="bg-[#123524] hover:bg-[#1a4b33] text-white text-xs sm:text-sm font-semibold px-3.5 sm:px-5 py-1.5 sm:py-2 rounded-full flex items-center gap-2 sm:gap-2.5 transition-all duration-150 shadow-xs cursor-pointer"
        aria-label="All Categories"
      >
        <i class="fa-solid fa-bars text-xs"></i>
        <span>All Categories</span>
        <i class="fa-solid fa-chevron-down text-[8px] opacity-70 group-hover:rotate-180 transition-transform duration-200"></i>
      </a>

      <!-- Categories Quick Dropdown -->
      <div class="absolute left-0 top-full pt-2 w-64 max-w-[calc(100vw-2rem)] opacity-0 pointer-events-none translate-y-1 group-hover:opacity-100 group-hover:pointer-events-auto group-hover:translate-y-0 transition-all duration-150 z-50">
        <div class="bg-white rounded-2xl border border-gray-100 shadow-xl p-2.5 space-y-1 text-xs font-medium text-gray-700">
          <div class="px-3 py-1.5 text-[10px] font-bold text-gray-400 uppercase tracking-wider border-b border-gray-100 mb-1">
            Browse Categories
          </div>
          
          <a href="/shop?category=Electronics" class="flex items-center gap-3 px-3 py-2 rounded-xl hover:bg-emerald-50/60 hover:text-[#123524] transition-colors">
            <span class="w-6 h-6 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center text-xs">
              <i class="fa-solid fa-laptop"></i>
            </span>
            <span class="font-semibold">Electronics</span>
          </a>

          <a href="/shop?category=Fashion" class="flex items-center gap-3 px-3 py-2 rounded-xl hover:bg-emerald-50/60 hover:text-[#123524] transition-colors">
            <span class="w-6 h-6 rounded-lg bg-amber-50 text-amber-700 flex items-center justify-center text-xs">
              <i class="fa-solid fa-shirt"></i>
            </span>
            <span class="font-semibold">Fashion &amp; Apparel</span>
          </a>

          <a href="/shop?category=Home%20%26%20Living" class="flex items-center gap-3 px-3 py-2 rounded-xl hover:bg-emerald-50/60 hover:text-[#123524] transition-colors">
            <span class="w-6 h-6 rounded-lg bg-blue-50 text-blue-700 flex items-center justify-center text-xs">
              <i class="fa-solid fa-couch"></i>
            </span>
            <span class="font-semibold">Home &amp; Living</span>
          </a>

          <a href="/shop?category=Beauty" class="flex items-center gap-3 px-3 py-2 rounded-xl hover:bg-emerald-50/60 hover:text-[#123524] transition-colors">
            <span class="w-6 h-6 rounded-lg bg-rose-50 text-rose-700 flex items-center justify-center text-xs">
              <i class="fa-solid fa-wand-magic-sparkles"></i>
            </span>
            <span class="font-semibold">Beauty &amp; Personal Care</span>
          </a>

          <a href="/shop?category=Sports" class="flex items-center gap-3 px-3 py-2 rounded-xl hover:bg-emerald-50/60 hover:text-[#123524] transition-colors">
            <span class="w-6 h-6 rounded-lg bg-teal-50 text-teal-700 flex items-center justify-center text-xs">
              <i class="fa-solid fa-dumbbell"></i>
            </span>
            <span class="font-semibold">Sports &amp; Fitness</span>
          </a>

          <div class="pt-1.5 border-t border-gray-100 mt-1">
            <a href="/categories" class="flex items-center justify-between px-3 py-2 rounded-xl bg-gray-50 hover:bg-[#123524] hover:text-white text-[#123524] font-bold transition-all text-xs">
              <span>View All 9 Categories</span>
              <i class="fa-solid fa-arrow-right text-[10px]"></i>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Navigation Links -->
    <ul class="flex items-center gap-4 sm:gap-6 lg:gap-8 text-xs sm:text-sm font-medium text-gray-700 shrink-0">
      <li>
        <a href="/" class="<%= current === 'home' ? 'text-[#123524] font-semibold' : 'text-gray-700 hover:text-[#123524]' %> transition-colors">
          Home
        </a>
      </li>
      <li>
        <a href="/shop" class="<%= current === 'shop' ? 'text-[#123524] font-semibold' : 'text-gray-700 hover:text-[#123524]' %> transition-colors">
          Shop
        </a>
      </li>
      <li>
        <a href="/deals" class="<%= current === 'deals' ? 'text-[#123524] font-semibold' : 'text-gray-700 hover:text-[#123524]' %> transition-colors flex items-center gap-1.5">
          <span>Deals</span>
          <span class="w-1.5 h-1.5 rounded-full bg-[#e8756a]"></span>
        </a>
      </li>
      <li>
        <a href="/new-arrivals" class="<%= current === 'new-arrivals' ? 'text-[#123524] font-semibold' : 'text-gray-700 hover:text-[#123524]' %> transition-colors">
          New Arrivals
        </a>
      </li>
      <li>
        <a href="/brands" class="<%= current === 'brands' ? 'text-[#123524] font-semibold' : 'text-gray-700 hover:text-[#123524]' %> transition-colors">
          Brands
        </a>
      </li>
      <li>
        <a href="/inspiration" class="<%= current === 'inspiration' ? 'text-[#123524] font-semibold' : 'text-gray-700 hover:text-[#123524]' %> transition-colors">
          Inspiration
        </a>
      </li>
      <li>
        <a href="/track-order" class="<%= current === 'track-order' ? 'text-[#123524] font-semibold' : 'text-gray-700 hover:text-[#123524]' %> transition-colors">
          Track Order
        </a>
      </li>
      <li class="ml-auto sm:ml-0">
        <a href="/seller/dashboard" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-50 text-amber-900 border border-amber-200 hover:bg-amber-100 transition-colors font-bold text-xs">
          <i class="fa-solid fa-store text-[11px] text-amber-700"></i>
          <span>Seller Hub</span>
        </a>
      </li>
    </ul>

  </div>
</nav>
