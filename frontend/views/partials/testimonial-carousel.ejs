<!-- Social Proof / Customer Testimonials Section -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-6">
    <div class="flex items-center gap-2">
      <h2 class="font-heading font-bold text-lg sm:text-xl text-[#0d2a1c]">
        Loved By Thousands
      </h2>
      <span class="text-rose-400 text-sm">❤️</span>
    </div>

    <div class="flex items-center gap-2 text-xs sm:text-sm font-semibold text-gray-700">
      <span>4.8/5 Average Rating</span>
      <div class="flex text-[#f0a83e] text-xs">
        <% for(let i = 0; i < 5; i++) { %>
          <i class="fa-solid fa-star"></i>
        <% } %>
      </div>
    </div>
  </div>

  <div class="relative">
    <div class="swiper reviews-swiper">
      <div class="swiper-wrapper">
        
        <% (reviews || []).forEach(function(review) { %>
        <div class="swiper-slide h-auto">
          <div class="bg-white rounded-2xl border border-gray-100 p-5 sm:p-6 flex flex-col justify-between h-full shadow-2xs">
            
            <!-- Reviewer Header -->
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 rounded-full overflow-hidden shrink-0 border border-gray-100">
                <img 
                  src="<%= review.avatarUrl || '/images/avatars/sarah.jpg' %>" 
                  alt="<%= review.customerName %>" 
                  class="w-full h-full object-cover"
                  loading="lazy"
                >
              </div>
              
              <div>
                <div class="flex items-center gap-1.5">
                  <span class="font-semibold text-xs sm:text-sm text-[#16261d]">
                    <%= review.customerName %>
                  </span>
                  <% if (review.isVerified) { %>
                  <span class="text-[#16a34a] text-xs" title="Verified Buyer">
                    <i class="fa-solid fa-circle-check"></i>
                  </span>
                  <% } %>
                </div>

                <div class="flex text-[#f0a83e] text-[10px] mt-0.5">
                  <% for(let i = 0; i < (review.rating || 5); i++) { %>
                    <i class="fa-solid fa-star"></i>
                  <% } %>
                </div>
              </div>
            </div>

            <!-- Review Body -->
            <p class="text-xs sm:text-sm text-gray-600 leading-relaxed italic">
              "<%= review.body %>"
            </p>

          </div>
        </div>
        <% }); %>

      </div>
    </div>

    <!-- Navigation Arrows -->
    <button class="reviews-prev swiper-button-viva absolute -left-4 top-1/2 -translate-y-1/2 hidden md:flex" aria-label="Previous Reviews">
      <i class="fa-solid fa-chevron-left text-xs"></i>
    </button>
    <button class="reviews-next swiper-button-viva absolute -right-4 top-1/2 -translate-y-1/2 hidden md:flex" aria-label="Next Reviews">
      <i class="fa-solid fa-chevron-right text-xs"></i>
    </button>
  </div>
</section>
