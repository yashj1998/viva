<!-- Top Picks Deals Carousel Section -->
<% const settings = (typeof topPicksSettings !== 'undefined' && topPicksSettings) ? topPicksSettings : {}; %>
<% if (settings.isActive !== false) { %>
<section id="deals" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
  <div class="flex items-center justify-between mb-4 sm:mb-6">
    <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-3">
      <div class="flex items-center gap-2">
        <h2 class="font-heading font-bold text-lg sm:text-xl text-[#0d2a1c]">
          <%= settings.title || 'Top Picks For You' %>
        </h2>
        <span class="text-amber-400 text-sm"><%= settings.badge || '✨' %></span>
      </div>
      <% if (settings.subtitle) { %>
      <span class="text-xs text-gray-500 hidden md:inline">· <%= settings.subtitle %></span>
      <% } %>
    </div>

    <div class="flex items-center gap-4">
      <a href="<%= settings.seeAllUrl || '/shop' %>" class="text-xs sm:text-sm font-semibold text-[#123524] hover:text-[#2c6b48] flex items-center gap-1 transition-colors">
        <span><%= settings.seeAllText || 'See All Deals' %></span>
        <i class="fa-solid fa-arrow-right text-[10px]"></i>
      </a>

      <!-- Desktop Navigation Controls -->
      <div class="hidden sm:flex items-center gap-2">
        <button class="products-prev swiper-button-viva" aria-label="Previous Deals">
          <i class="fa-solid fa-chevron-left text-xs"></i>
        </button>
        <button class="products-next swiper-button-viva" aria-label="Next Deals">
          <i class="fa-solid fa-chevron-right text-xs"></i>
        </button>
      </div>
    </div>
  </div>

  <% if (products && products.length > 0) { %>
  <!-- Swiper Container -->
  <div class="swiper products-swiper !overflow-visible sm:!overflow-hidden">
    <div class="swiper-wrapper">
      <% (products || []).forEach(function(product) { %>
      <div class="swiper-slide h-auto">
        <%- include('product-card', { product: product }) %>
      </div>
      <% }); %>
    </div>
  </div>
  <% } else { %>
  <div class="bg-gray-50 rounded-2xl p-8 text-center text-gray-500 text-sm border border-gray-100">
    <p>No featured top picks selected yet. Check back soon!</p>
  </div>
  <% } %>
</section>
<% } %>

