<!-- Newsletter Signup Section -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
  <div class="bg-[#123524] rounded-3xl p-6 sm:p-10 lg:p-12 text-white relative overflow-hidden shadow-xs">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-center">
      
      <!-- Left Info -->
      <div class="lg:col-span-6 flex items-start sm:items-center gap-4 sm:gap-5">
        <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-white flex items-center justify-center shrink-0 text-[#123524] shadow-xs">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="16" x="2" y="4" rx="2"/>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
        </div>
        
        <div>
          <h2 class="font-heading font-bold text-xl sm:text-2xl text-white tracking-tight">
            Stay in the Loop
          </h2>
          <p class="text-xs sm:text-sm text-gray-300 mt-1 leading-relaxed max-w-md">
            Get exclusive deals, new arrivals and style inspiration straight to your inbox.
          </p>
        </div>
      </div>

      <!-- Right Form -->
      <div class="lg:col-span-6">
        <form id="newsletter-form" class="space-y-2">
          <div class="flex flex-col sm:flex-row items-center gap-2 bg-white rounded-2xl sm:rounded-full p-2 sm:p-1.5 shadow-sm">
            <input 
              type="email" 
              id="newsletter-email" 
              placeholder="Enter your email address" 
              required
              class="w-full bg-transparent text-sm text-[#16261d] placeholder-gray-400 pl-3 sm:pl-5 pr-3 py-2.5 outline-none rounded-xl sm:rounded-full"
            >
            <button 
              type="submit" 
              id="newsletter-btn"
              class="w-full sm:w-auto shrink-0 bg-[#3e8a5f] hover:bg-[#347551] text-white font-medium text-xs sm:text-sm px-6 sm:px-7 py-3 sm:py-2.5 rounded-xl sm:rounded-full transition-all duration-150 transform hover:scale-[1.02] shadow-xs active:scale-95"
            >
              Subscribe
            </button>
          </div>
          
          <div class="flex items-center justify-between px-3 text-[11px] text-gray-300">
            <div class="flex items-center gap-1.5">
              <i class="fa-solid fa-shield-halved text-emerald-300 text-xs"></i>
              <span>We respect your privacy. Unsubscribe anytime.</span>
            </div>
            <span id="newsletter-message" class="hidden font-medium"></span>
          </div>
        </form>
      </div>

    </div>
  </div>
</section>
