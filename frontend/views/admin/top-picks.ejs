<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Top Picks For You — ViVA Admin' %></title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { font-family: 'Inter', sans-serif; }
    .font-heading { font-family: 'Poppins', sans-serif; }
  </style>
</head>
<body class="bg-[#fafaf9] text-[#16261d] min-h-screen flex">
  
  <%- include('sidebar') %>

  <div class="flex-1 flex flex-col min-w-0">
    <%- include('topbar') %>

    <main class="p-6 sm:p-8 space-y-8 flex-1 overflow-y-auto">
      
      <!-- Notifications -->
      <% if (message) { %>
      <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs p-3.5 rounded-xl flex items-center justify-between shadow-2xs">
        <div class="flex items-center gap-2">
          <i class="fa-solid fa-circle-check text-emerald-600 text-sm"></i>
          <span class="font-medium"><%= message %></span>
        </div>
        <button onclick="this.parentElement.remove()" class="text-emerald-500 hover:text-emerald-800 text-base font-bold">&times;</button>
      </div>
      <% } %>

      <!-- Top Header & KPI Summary -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2.5">
            <div class="w-9 h-9 rounded-xl bg-amber-50 border border-amber-200/60 flex items-center justify-center text-amber-600 shadow-2xs">
              <i class="fa-solid fa-wand-magic-sparkles text-sm"></i>
            </div>
            <div>
              <h1 class="font-heading font-bold text-xl sm:text-2xl text-[#0d2a1c] tracking-tight">
                Top Picks For You
              </h1>
              <p class="text-xs text-gray-500">
                Full control over featured homepage deals, ordering priority, badges, and carousel appearance.
              </p>
            </div>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <a 
            href="/#deals" 
            target="_blank" 
            class="bg-white border border-gray-200/80 hover:border-[#123524] text-[#123524] hover:bg-[#123524]/5 px-3.5 py-2 rounded-xl text-xs font-semibold flex items-center gap-2 transition-colors shadow-2xs"
          >
            <i class="fa-solid fa-arrow-up-right-from-square text-[11px]"></i>
            <span>Preview on Storefront</span>
          </a>
        </div>
      </div>

      <!-- Quick Stats Strip -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-2xl border border-gray-200/70 p-4 shadow-2xs flex items-center justify-between">
          <div>
            <span class="text-[11px] font-semibold text-gray-400 uppercase tracking-wider">Curated Deals</span>
            <div class="font-heading font-bold text-2xl text-[#0d2a1c] mt-0.5"><%= (topPicks || []).length %> Items</div>
            <p class="text-[10px] text-gray-500 mt-0.5">Visible in carousel</p>
          </div>
          <div class="w-10 h-10 rounded-xl bg-emerald-50 text-[#123524] flex items-center justify-center text-base">
            <i class="fa-solid fa-box-open"></i>
          </div>
        </div>

        <div class="bg-white rounded-2xl border border-gray-200/70 p-4 shadow-2xs flex items-center justify-between">
          <div>
            <span class="text-[11px] font-semibold text-gray-400 uppercase tracking-wider">Storefront Status</span>
            <div class="font-heading font-bold text-base mt-1 flex items-center gap-1.5 <%= (settings && settings.isActive !== false) ? 'text-emerald-700' : 'text-amber-600' %>">
              <span class="w-2.5 h-2.5 rounded-full <%= (settings && settings.isActive !== false) ? 'bg-emerald-500' : 'bg-amber-500' %> animate-pulse"></span>
              <span><%= (settings && settings.isActive !== false) ? 'Live on Homepage' : 'Paused (Hidden)' %></span>
            </div>
            <p class="text-[10px] text-gray-500 mt-0.5">Carousel visibility toggle</p>
          </div>
          <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-700 flex items-center justify-center text-base">
            <i class="fa-solid fa-eye"></i>
          </div>
        </div>

        <div class="bg-white rounded-2xl border border-gray-200/70 p-4 shadow-2xs flex items-center justify-between">
          <div>
            <span class="text-[11px] font-semibold text-gray-400 uppercase tracking-wider">Max Display Limit</span>
            <div class="font-heading font-bold text-2xl text-[#0d2a1c] mt-0.5">
              <%= (settings && settings.maxDisplayCount) ? settings.maxDisplayCount : 10 %> Max
            </div>
            <p class="text-[10px] text-gray-500 mt-0.5">Configurable limit</p>
          </div>
          <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-700 flex items-center justify-center text-base">
            <i class="fa-solid fa-sliders"></i>
          </div>
        </div>

        <div class="bg-white rounded-2xl border border-gray-200/70 p-4 shadow-2xs flex items-center justify-between">
          <div>
            <span class="text-[11px] font-semibold text-gray-400 uppercase tracking-wider">Available in Catalog</span>
            <div class="font-heading font-bold text-2xl text-[#0d2a1c] mt-0.5"><%= (catalogProducts || []).length %> Products</div>
            <p class="text-[10px] text-gray-500 mt-0.5">Ready to add with 1 click</p>
          </div>
          <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-700 flex items-center justify-center text-base">
            <i class="fa-solid fa-plus"></i>
          </div>
        </div>
      </div>

      <!-- SECTION 1: Section Settings & Customization Card -->
      <div class="bg-white rounded-2xl border border-gray-200/70 p-6 shadow-2xs space-y-4">
        <div class="flex items-center justify-between pb-3 border-b border-gray-100">
          <div>
            <h2 class="font-heading font-bold text-base text-[#0d2a1c] flex items-center gap-2">
              <i class="fa-solid fa-gears text-[#2c6b48]"></i>
              <span>Carousel Section Settings</span>
            </h2>
            <p class="text-xs text-gray-500 mt-0.5">
              Configure the headline, subtitle, badges, and behavior for "Top Picks For You" on the storefront.
            </p>
          </div>
          <span class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-emerald-50 text-[#123524] border border-emerald-200/50">
            Live Storefront Controls
          </span>
        </div>

        <form action="/admin/top-picks/settings" method="POST" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            
            <div class="space-y-1">
              <label class="text-[11px] font-semibold text-gray-700">Section Title *</label>
              <input 
                type="text" 
                name="title" 
                required 
                value="<%= (settings && settings.title) ? settings.title : 'Top Picks For You' %>" 
                placeholder="e.g. Top Picks For You" 
                class="w-full text-xs p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524] transition-colors"
              >
            </div>

            <div class="space-y-1">
              <label class="text-[11px] font-semibold text-gray-700">Emoji / Icon Badge</label>
              <input 
                type="text" 
                name="badge" 
                value="<%= (settings && settings.badge) ? settings.badge : '✨' %>" 
                placeholder="e.g. ✨ or 🔥 or ⭐" 
                class="w-full text-xs p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524] transition-colors"
              >
            </div>

            <div class="space-y-1">
              <label class="text-[11px] font-semibold text-gray-700">"See All" Button Label</label>
              <input 
                type="text" 
                name="seeAllText" 
                value="<%= (settings && settings.seeAllText) ? settings.seeAllText : 'See All Deals' %>" 
                placeholder="e.g. See All Deals" 
                class="w-full text-xs p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524] transition-colors"
              >
            </div>

            <div class="space-y-1">
              <label class="text-[11px] font-semibold text-gray-700">"See All" Target Link</label>
              <input 
                type="text" 
                name="seeAllUrl" 
                value="<%= (settings && settings.seeAllUrl) ? settings.seeAllUrl : '/shop' %>" 
                placeholder="e.g. /shop or #deals" 
                class="w-full text-xs p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524] transition-colors"
              >
            </div>

            <div class="sm:col-span-2 lg:col-span-3 space-y-1">
              <label class="text-[11px] font-semibold text-gray-700">Section Subtitle / Tagline (Optional)</label>
              <input 
                type="text" 
                name="subtitle" 
                value="<%= (settings && settings.subtitle) ? settings.subtitle : 'Handpicked deals and trending items tailored for modern living' %>" 
                placeholder="e.g. Handpicked deals and trending items" 
                class="w-full text-xs p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524] transition-colors"
              >
            </div>

            <div class="space-y-1">
              <label class="text-[11px] font-semibold text-gray-700">Max Items in Carousel</label>
              <input 
                type="number" 
                name="maxDisplayCount" 
                min="1" 
                max="30" 
                value="<%= (settings && settings.maxDisplayCount) ? settings.maxDisplayCount : 10 %>" 
                class="w-full text-xs p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524] transition-colors"
              >
            </div>

          </div>

          <div class="pt-2 flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-t border-gray-100">
            <label class="flex items-center gap-2.5 cursor-pointer select-none">
              <input 
                type="checkbox" 
                name="isActive" 
                <%= (settings && settings.isActive !== false) ? 'checked' : '' %> 
                class="w-4 h-4 text-[#123524] border-gray-300 rounded focus:ring-[#123524]"
              >
              <span class="text-xs font-semibold text-gray-700">Display "Top Picks For You" section on homepage</span>
            </label>

            <button 
              type="submit" 
              class="bg-[#123524] hover:bg-[#17422e] text-white text-xs font-semibold py-2.5 px-5 rounded-xl transition-colors shadow-xs flex items-center justify-center gap-2"
            >
              <i class="fa-solid fa-floppy-disk text-xs"></i>
              <span>Save Section Settings</span>
            </button>
          </div>
        </form>
      </div>

      <!-- SECTION 2: Active Top Picks Management Table -->
      <div class="bg-white rounded-2xl border border-gray-200/70 p-6 shadow-2xs space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 border-b border-gray-100">
          <div>
            <h2 class="font-heading font-bold text-base text-[#0d2a1c] flex items-center gap-2">
              <i class="fa-solid fa-list-ol text-[#2c6b48]"></i>
              <span>Active Top Picks in Carousel (<%= (topPicks || []).length %>)</span>
            </h2>
            <p class="text-xs text-gray-500 mt-0.5">
              Items are ordered by position (lowest number appears first). You can edit pricing, custom deal tags, and sort order inline.
            </p>
          </div>
        </div>

        <% if (topPicks && topPicks.length > 0) { %>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead>
              <tr class="text-gray-400 uppercase tracking-wider text-[10px] border-b border-gray-100">
                <th class="pb-3 w-16">Position</th>
                <th class="pb-3">Product</th>
                <th class="pb-3">Category</th>
                <th class="pb-3">Pricing ($)</th>
                <th class="pb-3">Deal Tag / Badge</th>
                <th class="pb-3 text-center">Carousel Status</th>
                <th class="pb-3 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% (topPicks || []).forEach(function(product, index) { %>
              <tr class="hover:bg-gray-50/60 transition-colors group">
                
                <!-- Position / Sort Order -->
                <td class="py-3.5 pr-2">
                  <div class="flex items-center gap-1.5">
                    <span class="w-6 h-6 rounded-lg bg-emerald-50 text-[#123524] text-[11px] font-bold flex items-center justify-center border border-emerald-200/60">
                      #<%= product.sortOrder || (index + 1) %>
                    </span>
                  </div>
                </td>

                <!-- Product Thumbnail & Title -->
                <td class="py-3.5">
                  <div class="flex items-center gap-3">
                    <div class="w-11 h-11 bg-gray-50 rounded-xl p-1 border border-gray-100 flex items-center justify-center shrink-0">
                      <img src="<%= product.primaryImageUrl %>" alt="<%= product.name %>" class="max-h-full max-w-full object-contain">
                    </div>
                    <div class="min-w-0">
                      <a href="/product/<%= product.slug %>" target="_blank" class="font-semibold text-gray-800 hover:text-[#123524] hover:underline flex items-center gap-1 truncate text-xs">
                        <span><%= product.name %></span>
                        <i class="fa-solid fa-arrow-up-right-from-square text-[9px] text-gray-400"></i>
                      </a>
                      <div class="flex items-center gap-1 text-[10px] text-gray-400 mt-0.5">
                        <span class="text-amber-500"><i class="fa-solid fa-star text-[9px]"></i> <%= (product.ratingAvg || 4.8).toFixed(1) %></span>
                        <span>·</span>
                        <span><%= (product.ratingCount || 0) %> reviews</span>
                      </div>
                    </div>
                  </div>
                </td>

                <!-- Category -->
                <td class="py-3.5">
                  <span class="bg-gray-100 text-gray-700 px-2 py-0.5 rounded text-[10px] font-medium whitespace-nowrap">
                    <%= product.category %>
                  </span>
                </td>

                <!-- Pricing & Discount -->
                <td class="py-3.5">
                  <div class="flex flex-col">
                    <div class="flex items-baseline gap-1.5">
                      <span class="font-bold text-[#c8503f]">$<%= product.salePrice.toFixed(2) %></span>
                      <% if (product.price > product.salePrice) { %>
                      <span class="text-gray-400 line-through text-[10px]">$<%= product.price.toFixed(2) %></span>
                      <% } %>
                    </div>
                    <% if (product.discountPercent) { %>
                    <span class="text-emerald-700 text-[10px] font-semibold mt-0.5">
                      <%= product.discountPercent %>% OFF
                    </span>
                    <% } %>
                  </div>
                </td>

                <!-- Deal Tag / Badge -->
                <td class="py-3.5">
                  <% if (product.badgeText) { %>
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-[#123524] text-white shadow-2xs">
                    <span><%= product.badgeText %></span>
                  </span>
                  <% } else { %>
                  <span class="text-gray-400 text-[11px] italic">None (Standard)</span>
                  <% } %>
                </td>

                <!-- Carousel Status -->
                <td class="py-3.5 text-center">
                  <form action="/admin/top-picks/toggle/<%= product._id || product.slug %>" method="POST" class="inline">
                    <button 
                      type="submit" 
                      title="Click to pause or active in carousel"
                      class="px-2.5 py-1 rounded-full text-[10px] font-semibold inline-flex items-center gap-1 transition-colors <%= product.isTopPick ? 'bg-emerald-100 text-emerald-800 hover:bg-emerald-200' : 'bg-gray-100 text-gray-600 hover:bg-gray-200' %>"
                    >
                      <i class="fa-solid fa-circle text-[6px] <%= product.isTopPick ? 'text-emerald-500' : 'text-gray-400' %>"></i>
                      <span><%= product.isTopPick ? 'Active' : 'Paused' %></span>
                    </button>
                  </form>
                </td>

                <!-- Actions: Inline Edit Modal / Remove -->
                <td class="py-3.5 text-right whitespace-nowrap">
                    <!-- Quick Edit Trigger Button -->
                    <button 
                      type="button" 
                      class="btn-edit-top-pick p-1.5 text-gray-500 hover:text-[#123524] hover:bg-gray-100 rounded-lg transition-colors"
                      title="Edit Position & Badge"
                      data-id="<%= product._id || product.slug %>"
                      data-name="<%= product.name %>"
                      data-sort="<%= product.sortOrder || (index + 1) %>"
                      data-badge="<%= product.badgeText || '' %>"
                      data-price="<%= product.price %>"
                      data-saleprice="<%= product.salePrice %>"
                    >
                      <i class="fa-solid fa-pen-to-square text-xs"></i>
                    </button>

                    <!-- Remove from Top Picks (Leaves in catalog) -->
                    <form action="/admin/top-picks/remove/<%= product._id || product.slug %>" method="POST" onsubmit="return confirm('Remove this product from Top Picks carousel? It will remain safe in your store catalog.');" class="inline">
                      <button 
                        type="submit" 
                        class="p-1.5 text-gray-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition-colors" 
                        title="Remove from Top Picks"
                      >
                        <i class="fa-solid fa-circle-minus text-xs"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <% } else { %>
        <div class="p-8 text-center bg-gray-50 rounded-xl border border-dashed border-gray-200">
          <div class="w-12 h-12 rounded-full bg-amber-50 text-amber-600 flex items-center justify-center mx-auto mb-2 text-lg">
            <i class="fa-solid fa-star"></i>
          </div>
          <p class="font-semibold text-sm text-gray-700">No products are currently marked as Top Picks.</p>
          <p class="text-xs text-gray-500 mt-1">Use the section below to add products from your catalog to the homepage carousel.</p>
        </div>
        <% } %>
      </div>

      <!-- SECTION 3: Add to Top Picks (Two Methods) -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        
        <!-- Option A: Add from Existing Catalog -->
        <div class="bg-white rounded-2xl border border-gray-200/70 p-6 shadow-2xs space-y-4">
          <div class="pb-3 border-b border-gray-100">
            <h2 class="font-heading font-bold text-base text-[#0d2a1c] flex items-center gap-2">
              <i class="fa-solid fa-plus-circle text-[#2c6b48]"></i>
              <span>Add Existing Catalog Item to Top Picks</span>
            </h2>
            <p class="text-xs text-gray-500 mt-0.5">
              Select any existing product and feature it in the "Top Picks For You" carousel.
            </p>
          </div>

          <form action="/admin/top-picks/add-existing" method="POST" class="space-y-4">
            <div class="space-y-1">
              <label class="text-[11px] font-semibold text-gray-700">Select Product *</label>
              <select 
                name="productId" 
                required 
                class="w-full text-xs p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524] transition-colors"
              >
                <option value="">-- Choose a product from catalog (<%= (catalogProducts || []).length %> available) --</option>
                <% (catalogProducts || []).forEach(function(item) { %>
                <option value="<%= item._id || item.slug %>">
                  <%= item.name %> — [<%= item.category %>] — $<%= item.salePrice.toFixed(2) %>
                </option>
                <% }); %>
              </select>
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div class="space-y-1">
                <label class="text-[11px] font-semibold text-gray-700">Display Position (Sort Order)</label>
                <input 
                  type="number" 
                  name="sortOrder" 
                  value="<%= (topPicks || []).length + 1 %>" 
                  min="1" 
                  class="w-full text-xs p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524]"
                >
                <span class="text-[10px] text-gray-400">Lowest number shows first</span>
              </div>

              <div class="space-y-1">
                <label class="text-[11px] font-semibold text-gray-700">Highlight Tag (Badge)</label>
                <input 
                  type="text" 
                  name="badgeText" 
                  placeholder="e.g. HOT DEAL, BESTSELLER" 
                  class="w-full text-xs p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524]"
                >
                <span class="text-[10px] text-gray-400">Optional promo pill badge</span>
              </div>
            </div>

            <!-- Quick Badge Presets -->
            <div class="space-y-1 pt-1">
              <span class="text-[10px] text-gray-400 font-semibold uppercase">Popular Tag Presets:</span>
              <div class="flex flex-wrap gap-1.5 text-[10px]">
                <button type="button" onclick="document.getElementsByName('badgeText')[0].value='HOT DEAL'" class="px-2 py-0.5 rounded-md bg-amber-50 text-amber-800 border border-amber-200 hover:bg-amber-100">🔥 HOT DEAL</button>
                <button type="button" onclick="document.getElementsByName('badgeText')[0].value='BESTSELLER'" class="px-2 py-0.5 rounded-md bg-purple-50 text-purple-800 border border-purple-200 hover:bg-purple-100">⭐ BESTSELLER</button>
                <button type="button" onclick="document.getElementsByName('badgeText')[0].value='STAFF PICK'" class="px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-800 border border-emerald-200 hover:bg-emerald-100">✨ STAFF PICK</button>
                <button type="button" onclick="document.getElementsByName('badgeText')[0].value='FLASH SALE'" class="px-2 py-0.5 rounded-md bg-rose-50 text-rose-800 border border-rose-200 hover:bg-rose-100">⚡ FLASH SALE</button>
              </div>
            </div>

            <button 
              type="submit" 
              class="w-full bg-[#123524] hover:bg-[#17422e] text-white text-xs font-semibold py-2.5 px-4 rounded-xl transition-colors shadow-xs flex items-center justify-center gap-2"
            >
              <i class="fa-solid fa-star text-xs"></i>
              <span>Add to Top Picks Carousel</span>
            </button>
          </form>
        </div>

        <!-- Option B: Create New Product directly as Top Pick -->
        <div class="bg-white rounded-2xl border border-gray-200/70 p-6 shadow-2xs space-y-4">
          <div class="pb-3 border-b border-gray-100">
            <h2 class="font-heading font-bold text-base text-[#0d2a1c] flex items-center gap-2">
              <i class="fa-solid fa-box-tissue text-[#2c6b48]"></i>
              <span>Create New Product as Top Pick</span>
            </h2>
            <p class="text-xs text-gray-500 mt-0.5">
              Quickly create a brand new product and immediately include it in the Top Picks carousel.
            </p>
          </div>

          <form action="/admin/products/new" method="POST" class="space-y-3">
            <input type="hidden" name="isTopPick" value="on">

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div class="space-y-1 sm:col-span-2">
                <label class="text-[11px] font-semibold text-gray-700">Product Title *</label>
                <input type="text" name="name" required placeholder="e.g. Ergonomic Desk Mat" class="w-full text-xs p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524]">
              </div>

              <div class="space-y-1">
                <label class="text-[11px] font-semibold text-gray-700">Category *</label>
                <select name="category" class="w-full text-xs p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524]">
                  <% (categories || []).forEach(function(cat) { %>
                    <option value="<%= cat.name %>"><%= cat.name %></option>
                  <% }); %>
                </select>
              </div>

              <div class="space-y-1">
                <label class="text-[11px] font-semibold text-gray-700">Image Asset URL</label>
                <input type="text" name="primaryImageUrl" value="/images/products/headphones.png" class="w-full text-xs p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524]">
              </div>

              <div class="space-y-1">
                <label class="text-[11px] font-semibold text-gray-700">Regular Price ($)</label>
                <input type="number" step="0.01" name="price" required placeholder="49.99" class="w-full text-xs p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524]">
              </div>

              <div class="space-y-1">
                <label class="text-[11px] font-semibold text-gray-700">Sale Price ($)</label>
                <input type="number" step="0.01" name="salePrice" required placeholder="34.99" class="w-full text-xs p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524]">
              </div>
            </div>

            <button 
              type="submit" 
              class="w-full bg-[#2c6b48] hover:bg-[#123524] text-white text-xs font-semibold py-2.5 px-4 rounded-xl transition-colors shadow-xs flex items-center justify-center gap-2 mt-2"
            >
              <i class="fa-solid fa-plus text-xs"></i>
              <span>Save & Add to Top Picks</span>
            </button>
          </form>
        </div>

      </div>

    </main>
  </div>

  <!-- Edit Top Pick Modal -->
  <div id="editModal" class="fixed inset-0 z-50 bg-black/40 backdrop-blur-xs hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl border border-gray-200 space-y-4 animate-in fade-in zoom-in duration-150">
      <div class="flex items-center justify-between pb-3 border-b border-gray-100">
        <div>
          <h3 class="font-heading font-bold text-sm text-[#0d2a1c] flex items-center gap-2">
            <i class="fa-solid fa-sliders text-[#2c6b48]"></i>
            <span>Edit Top Pick Details</span>
          </h3>
          <p id="modalProductName" class="text-xs text-gray-500 truncate max-w-xs mt-0.5"></p>
        </div>
        <button onclick="closeEditModal()" class="text-gray-400 hover:text-gray-700 text-lg">&times;</button>
      </div>

      <form id="editForm" action="" method="POST" class="space-y-3.5">
        
        <div class="grid grid-cols-2 gap-3">
          <div class="space-y-1">
            <label class="text-[11px] font-semibold text-gray-700">Position (Sort Order)</label>
            <input type="number" id="modalSortOrder" name="sortOrder" required min="1" class="w-full text-xs p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524]">
            <span class="text-[10px] text-gray-400">Position in carousel</span>
          </div>

          <div class="space-y-1">
            <label class="text-[11px] font-semibold text-gray-700">Highlight Tag (Badge)</label>
            <input type="text" id="modalBadgeText" name="badgeText" placeholder="e.g. HOT DEAL" class="w-full text-xs p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524]">
            <span class="text-[10px] text-gray-400">Badge pill on card</span>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="space-y-1">
            <label class="text-[11px] font-semibold text-gray-700">Regular Price ($)</label>
            <input type="number" step="0.01" id="modalPrice" name="price" required class="w-full text-xs p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524]">
          </div>

          <div class="space-y-1">
            <label class="text-[11px] font-semibold text-gray-700">Sale Price ($)</label>
            <input type="number" step="0.01" id="modalSalePrice" name="salePrice" required class="w-full text-xs p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524]">
          </div>
        </div>

        <div class="pt-2 flex items-center justify-end gap-2 border-t border-gray-100">
          <button type="button" onclick="closeEditModal()" class="px-4 py-2 text-xs font-semibold text-gray-600 hover:bg-gray-100 rounded-xl transition-colors">
            Cancel
          </button>
          <button type="submit" class="bg-[#123524] hover:bg-[#17422e] text-white text-xs font-semibold py-2 px-4 rounded-xl transition-colors shadow-xs">
            Save Changes
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function openEditModal(id, name, sortOrder, badgeText, price, salePrice) {
      document.getElementById('modalProductName').textContent = name;
      document.getElementById('modalSortOrder').value = sortOrder;
      document.getElementById('modalBadgeText').value = badgeText || '';
      document.getElementById('modalPrice').value = price;
      document.getElementById('modalSalePrice').value = salePrice;
      document.getElementById('editForm').action = '/admin/top-picks/update/' + id;
      document.getElementById('editModal').classList.remove('hidden');
    }

    function closeEditModal() {
      document.getElementById('editModal').classList.add('hidden');
    }

    // Attach click handlers to edit buttons
    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('.btn-edit-top-pick').forEach(function(btn) {
        btn.addEventListener('click', function() {
          openEditModal(
            this.dataset.id,
            this.dataset.name,
            this.dataset.sort,
            this.dataset.badge,
            this.dataset.price,
            this.dataset.saleprice
          );
        });
      });
    });

    // Close modal on Escape key
    window.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeEditModal();
    });
  </script>

</body>
</html>
