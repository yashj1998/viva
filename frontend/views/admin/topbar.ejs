<!-- Admin Top Bar -->
<header class="bg-white border-b border-gray-200 px-6 py-3.5 flex items-center justify-between sticky top-0 z-30 shadow-xs">
  <div class="flex items-center gap-3">
    <div>
      <h1 class="font-heading font-bold text-base text-[#123524] flex items-center gap-2">
        <span><%= typeof title !== 'undefined' ? title.split('—')[0].trim() : 'Admin Console' %></span>
      </h1>
      <p class="text-[11px] text-gray-400 font-medium">ViVA Storefront Operations &bull; Real-time Database Sync</p>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <!-- Live Store Button -->
    <a href="/" target="_blank" class="text-xs font-semibold text-[#123524] bg-emerald-50 hover:bg-emerald-100/80 border border-emerald-200/80 px-3 py-1.5 rounded-full flex items-center gap-1.5 transition-colors shadow-xs">
      <i class="fa-solid fa-store text-emerald-700 text-xs"></i>
      <span>Storefront</span>
    </a>

    <!-- Activity / Audit Quick Link -->
    <a href="/admin/audit-logs" title="Activity Logs" class="w-8 h-8 rounded-full border border-gray-200 flex items-center justify-center text-gray-500 hover:text-[#123524] hover:bg-gray-50 transition-colors relative">
      <i class="fa-regular fa-bell text-xs"></i>
      <span class="w-2 h-2 rounded-full bg-emerald-500 absolute top-1.5 right-1.5 ring-2 ring-white"></span>
    </a>

    <!-- Current User Profile Chip -->
    <div class="flex items-center gap-2.5 pl-3 border-l border-gray-200">
      <div class="w-8 h-8 rounded-full bg-[#123524] text-white flex items-center justify-center font-bold text-xs shadow-xs">
        <%= (typeof currentUser !== 'undefined' && currentUser.name) ? currentUser.name.charAt(0).toUpperCase() : 'A' %>
      </div>
      <div class="text-left hidden sm:block">
        <div class="flex items-center gap-1.5">
          <span class="text-xs font-bold text-gray-800 leading-tight">
            <%= (typeof currentUser !== 'undefined' && currentUser.name) ? currentUser.name : 'Admin User' %>
          </span>
          <span class="text-[9px] uppercase font-bold tracking-wider px-1.5 py-0.2 rounded-full <%= (typeof currentUser !== 'undefined' && currentUser.role === 'admin') ? 'bg-emerald-100 text-emerald-800' : ((typeof currentUser !== 'undefined' && currentUser.role === 'manager') ? 'bg-blue-100 text-blue-800' : 'bg-amber-100 text-amber-800') %>">
            <%= (typeof currentUser !== 'undefined' && currentUser.role) ? currentUser.role : 'admin' %>
          </span>
        </div>
        <span class="text-[10px] text-gray-400 block truncate max-w-[150px]">
          <%= (typeof currentUser !== 'undefined' && currentUser.email) ? currentUser.email : 'admin@viva.com' %>
        </span>
      </div>
    </div>
  </div>
</header>
