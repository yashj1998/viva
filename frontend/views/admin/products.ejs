<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Manage Products — ViVA Admin' %></title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { font-family: 'Inter', sans-serif; }
    .font-heading { font-family: 'Poppins', sans-serif; }
  </style>
</head>
<body class="bg-[#fafaf9] text-[#16261d] min-h-screen flex">
  
  <%- include('sidebar') %>

  <div class="flex-1 flex flex-col min-w-0">
    <%- include('topbar') %>

    <main class="p-6 sm:p-8 space-y-6 flex-1 overflow-y-auto">
      
      <!-- Notifications -->
      <% if (message) { %>
        <div class="p-4 rounded-xl text-xs font-semibold flex items-center justify-between shadow-xs bg-emerald-50 text-emerald-800 border border-emerald-200">
          <div class="flex items-center gap-2">
            <i class="fa-solid fa-circle-check text-emerald-600"></i>
            <span><%= message %></span>
          </div>
          <button onclick="this.parentElement.remove()" class="text-emerald-700 hover:text-emerald-900 font-bold">&times;</button>
        </div>
      <% } %>

      <!-- Top Header -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h2 class="font-heading font-bold text-xl text-[#123524]">Products Catalog Management</h2>
          <p class="text-xs text-gray-500 mt-0.5">Manage live product listings, SKUs, pricing, discount calculations, variants, and stock availability.</p>
        </div>
        <div class="flex items-center gap-2 flex-wrap">
          <button 
            type="button" 
            onclick="document.getElementById('quickAddCard').classList.toggle('hidden')" 
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[#123524] text-white text-xs font-bold hover:bg-[#1a4b33] transition-colors shadow-xs"
          >
            <i class="fa-solid fa-plus text-[11px]"></i> Add New Product
          </button>
          <a href="/admin/inventory" class="inline-flex items-center gap-1.5 px-3.5 py-2.5 rounded-xl border border-amber-300 text-amber-900 bg-amber-50 hover:bg-amber-100 text-xs font-bold transition-colors shadow-2xs">
            <i class="fa-solid fa-warehouse text-amber-700 text-xs"></i> Stock Control
          </a>
          <a href="/admin/top-picks" class="inline-flex items-center gap-1.5 px-3.5 py-2.5 rounded-xl border border-gray-200 text-gray-700 bg-white hover:bg-gray-50 text-xs font-bold transition-colors shadow-2xs">
            <i class="fa-solid fa-wand-magic-sparkles text-amber-600 text-xs"></i> Top Picks Deals
          </a>
        </div>
      </div>

      <!-- Quick Add Product Drawer / Card (Collapsible) -->
      <div id="quickAddCard" class="bg-white rounded-2xl border border-gray-200/80 p-6 shadow-xs space-y-4 hidden">
        <div class="flex items-center justify-between border-b border-gray-100 pb-3">
          <h3 class="font-heading font-bold text-sm text-[#123524] flex items-center gap-2">
            <i class="fa-solid fa-plus-circle text-emerald-700 text-xs"></i>
            <span>Create New Product Entry</span>
          </h3>
          <button type="button" onclick="document.getElementById('quickAddCard').classList.add('hidden')" class="text-gray-400 hover:text-gray-600 text-sm font-bold">&times;</button>
        </div>

        <form action="/admin/products/new" method="POST" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-4 items-end text-xs">
          <div class="lg:col-span-2 space-y-1">
            <label class="font-bold text-gray-700">Product Name *</label>
            <input type="text" name="name" required placeholder="e.g. Sony ANC Wireless Headphones" class="w-full px-3 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none">
          </div>

          <div class="space-y-1">
            <label class="font-bold text-gray-700">SKU (Auto-gens if blank)</label>
            <input type="text" name="sku" placeholder="e.g. VIVA-ELE-001" class="w-full px-3 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none uppercase font-mono">
          </div>

          <div class="space-y-1">
            <label class="font-bold text-gray-700">Category *</label>
            <select name="category" class="w-full px-3 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none">
              <% (categories || []).forEach(cat => { %>
                <option value="<%= cat.name %>"><%= cat.name %></option>
              <% }) %>
            </select>
          </div>

          <div class="space-y-1">
            <label class="font-bold text-gray-700">Regular Price ($) *</label>
            <input type="number" step="0.01" name="price" required placeholder="99.99" class="w-full px-3 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none">
          </div>

          <div class="space-y-1">
            <label class="font-bold text-gray-700">Sale Price ($) *</label>
            <input type="number" step="0.01" name="salePrice" required placeholder="79.99" class="w-full px-3 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none text-[#c8503f] font-bold">
          </div>

          <div class="space-y-1">
            <label class="font-bold text-gray-700">Initial Stock</label>
            <input type="number" name="stockQuantity" value="50" min="0" class="w-full px-3 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none font-bold">
          </div>

          <div class="space-y-1">
            <label class="font-bold text-gray-700">Low Stock Alert Level</label>
            <input type="number" name="lowStockThreshold" value="10" min="1" class="w-full px-3 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none">
          </div>

          <div class="space-y-1">
            <label class="font-bold text-gray-700">Listing Status</label>
            <select name="status" class="w-full px-3 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none font-semibold">
              <option value="published">Published (Live)</option>
              <option value="draft">Draft (Hidden)</option>
              <option value="archived">Archived</option>
            </select>
          </div>

          <% if (!isSeller && sellers && sellers.length > 0) { %>
            <div class="space-y-1">
              <label class="font-bold text-gray-700">Assign Seller Store</label>
              <select name="seller" class="w-full px-3 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none font-semibold">
                <option value="">ViVA Flagship Direct</option>
                <% sellers.forEach(s => { %>
                  <option value="<%= s._id %>"><%= s.storeName || s.name %></option>
                <% }) %>
              </select>
            </div>
          <% } %>

          <div class="lg:col-span-3 space-y-1">
            <label class="font-bold text-gray-700">Primary Image Asset Path</label>
            <input type="text" name="primaryImageUrl" value="/images/products/headphones.png" class="w-full px-3 py-2 border border-gray-200 rounded-xl font-mono text-gray-700">
          </div>

          <div class="lg:col-span-6 flex items-center justify-between pb-1 pt-2 border-t border-gray-100">
            <label class="inline-flex items-center gap-2 cursor-pointer font-bold text-gray-700">
              <input type="checkbox" name="isTopPick" checked class="rounded text-emerald-600">
              <span>Feature in Top Picks Carousel</span>
            </label>
            <div class="flex items-center gap-2">
              <button type="button" onclick="document.getElementById('quickAddCard').classList.add('hidden')" class="px-4 py-2 text-gray-600 hover:bg-gray-100 rounded-xl font-bold">
                Cancel
              </button>
              <button type="submit" class="px-5 py-2 bg-[#123524] hover:bg-[#1a4b33] text-white font-bold rounded-xl shadow-xs transition-colors">
                Save &amp; Publish
              </button>
            </div>
          </div>
        </form>
      </div>

      <!-- Filters & Search Toolbar -->
      <form action="/admin/products" method="GET" class="bg-white p-4 rounded-2xl border border-gray-200/80 shadow-xs space-y-3">
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 text-xs">
          <!-- Search -->
          <div class="relative flex-1">
            <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
            <input 
              type="text" 
              name="search" 
              value="<%= query.search || '' %>" 
              placeholder="Search product title, SKU (e.g. VIVA-ELE-001), or category..." 
              class="w-full pl-9 pr-4 py-1.5 text-xs rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-emerald-500"
            >
          </div>

          <!-- Filters -->
          <div class="flex items-center gap-2 flex-wrap">
            <!-- Category Filter -->
            <select name="category" onchange="this.form.submit()" class="px-3 py-1.5 border border-gray-200 rounded-xl bg-white focus:outline-none font-medium text-gray-700">
              <option value="all">All Categories</option>
              <% (categories || []).forEach(cat => { %>
                <option value="<%= cat.name %>" <%= (query.category === cat.name) ? 'selected' : '' %>><%= cat.name %></option>
              <% }) %>
            </select>

            <!-- Stock Filter -->
            <select name="stock" onchange="this.form.submit()" class="px-3 py-1.5 border border-gray-200 rounded-xl bg-white focus:outline-none font-medium text-gray-700">
              <option value="all">All Stock Status</option>
              <option value="in-stock" <%= query.stock === 'in-stock' ? 'selected' : '' %>>In Stock (>0)</option>
              <option value="low-stock" <%= query.stock === 'low-stock' ? 'selected' : '' %>>Low Stock (&le;10)</option>
              <option value="out-of-stock" <%= query.stock === 'out-of-stock' ? 'selected' : '' %>>Out of Stock (0)</option>
            </select>

            <!-- Status Filter -->
            <select name="status" onchange="this.form.submit()" class="px-3 py-1.5 border border-gray-200 rounded-xl bg-white focus:outline-none font-medium text-gray-700">
              <option value="all">All Statuses</option>
              <option value="published" <%= query.status === 'published' ? 'selected' : '' %>>Published (Live)</option>
              <option value="draft" <%= query.status === 'draft' ? 'selected' : '' %>>Draft</option>
              <option value="archived" <%= query.status === 'archived' ? 'selected' : '' %>>Archived</option>
            </select>

            <% if (!isSeller && sellers && sellers.length > 0) { %>
              <!-- Seller Store Filter -->
              <select name="sellerId" onchange="this.form.submit()" class="px-3 py-1.5 border border-amber-300 rounded-xl bg-amber-50/60 focus:outline-none font-semibold text-amber-900 text-xs">
                <option value="">All Sellers &amp; Stores</option>
                <% sellers.forEach(s => { %>
                  <option value="<%= s._id %>" <%= (selectedSellerId == s._id.toString() || query.sellerId == s._id.toString()) ? 'selected' : '' %>>
                    <%= s.storeName || s.name %>
                  </option>
                <% }) %>
              </select>
            <% } %>

            <!-- Sort Filter -->
            <select name="sort" onchange="this.form.submit()" class="px-3 py-1.5 border border-gray-200 rounded-xl bg-white focus:outline-none font-medium text-gray-700">
              <option value="newest" <%= (!query.sort || query.sort === 'newest') ? 'selected' : '' %>>Newest First</option>
              <option value="price-asc" <%= query.sort === 'price-asc' ? 'selected' : '' %>>Price: Low to High</option>
              <option value="price-desc" <%= query.sort === 'price-desc' ? 'selected' : '' %>>Price: High to Low</option>
              <option value="stock-asc" <%= query.sort === 'stock-asc' ? 'selected' : '' %>>Stock: Low to High</option>
              <option value="name-asc" <%= query.sort === 'name-asc' ? 'selected' : '' %>>Name A-Z</option>
              <option value="top-picks" <%= query.sort === 'top-picks' ? 'selected' : '' %>>Top Picks First</option>
            </select>

            <button type="submit" class="px-4 py-1.5 bg-[#123524] text-white text-xs font-bold rounded-xl hover:bg-[#1a4b33] transition-colors">
              Filter
            </button>
            <% if (query.search || (query.category && query.category !== 'all') || (query.stock && query.stock !== 'all') || (query.status && query.status !== 'all') || query.sellerId || query.sort) { %>
              <a href="/admin/products" class="px-3 py-1.5 text-xs text-gray-500 hover:text-gray-800 font-semibold">Reset</a>
            <% } %>
          </div>
        </div>
      </form>

      <!-- Bulk Actions & Products Table -->
      <form id="bulkProductsForm" action="/admin/products/bulk" method="POST">
        <div class="bg-white rounded-2xl border border-gray-200/80 overflow-hidden shadow-xs">
          
          <!-- Bulk Controls Bar -->
          <div class="p-4 border-b border-gray-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-gray-50/50 text-xs">
            <div class="flex items-center gap-3">
              <label class="inline-flex items-center gap-2 cursor-pointer font-bold text-gray-700">
                <input type="checkbox" id="selectAllProds" onchange="toggleSelectAllProducts(this)" class="rounded text-emerald-600">
                <span>Select All</span>
              </label>
              <span id="prodSelectedCount" class="text-[11px] text-gray-400 font-medium">0 products selected</span>
            </div>

            <div class="flex items-center gap-2 flex-wrap">
              <span class="text-gray-500 font-medium">Bulk Action:</span>
              <select name="action" id="bulkActionSelect" onchange="handleBulkActionChange(this)" class="px-2.5 py-1 border border-gray-200 rounded-lg bg-white font-semibold">
                <option value="publish">Publish Selected</option>
                <option value="unpublish">Unpublish (Set to Draft)</option>
                <option value="setTopPick">Feature in Top Picks</option>
                <option value="removeTopPick">Remove from Top Picks</option>
                <option value="changeCategory">Reassign Category</option>
                <option value="delete">Delete Selected</option>
              </select>

              <select name="targetCategory" id="targetCatSelect" class="px-2.5 py-1 border border-gray-200 rounded-lg bg-white font-semibold hidden">
                <% (categories || []).forEach(cat => { %>
                  <option value="<%= cat.name %>"><%= cat.name %></option>
                <% }) %>
              </select>

              <button type="submit" onclick="return confirm('Execute this bulk action on selected items?')" class="px-3 py-1 bg-[#123524] hover:bg-[#1a4b33] text-white font-bold rounded-lg transition-colors">
                Apply
              </button>
            </div>
          </div>

          <!-- Table -->
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead>
                <tr class="text-gray-400 uppercase tracking-wider text-[10px] border-b border-gray-100 bg-gray-50/70">
                  <th class="py-3 px-4 w-10"></th>
                  <th class="py-3 px-4">Thumbnail</th>
                  <th class="py-3 px-4">Product Name &amp; SKU</th>
                  <% if (!isSeller) { %>
                    <th class="py-3 px-4">Merchant / Store</th>
                  <% } %>
                  <th class="py-3 px-4">Category</th>
                  <th class="py-3 px-4">Stock</th>
                  <th class="py-3 px-4">Price</th>
                  <th class="py-3 px-4">Sale Price</th>
                  <th class="py-3 px-4">Status</th>
                  <th class="py-3 px-4 text-center">Top Pick</th>
                  <th class="py-3 px-4 text-right">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                <% if (products && products.length > 0) { %>
                  <% products.forEach(product => { %>
                    <% 
                      const stock = Number(product.stockQuantity) || 0;
                      const threshold = Number(product.lowStockThreshold) || 10;
                      const isOutOfStock = stock <= 0;
                      const isLowStock = !isOutOfStock && stock <= threshold;
                    %>
                    <tr class="hover:bg-gray-50/70 transition-colors">
                      <!-- Select Checkbox -->
                      <td class="py-3 px-4">
                        <input type="checkbox" name="productIds" value="<%= product._id || product.slug %>" onchange="updateSelectedProductsCount()" class="prod-checkbox rounded text-emerald-600">
                      </td>

                      <!-- Thumbnail -->
                      <td class="py-3 px-4">
                        <div class="w-10 h-10 bg-gray-50 rounded-xl p-1 border border-gray-100 flex items-center justify-center cursor-pointer" onclick="viewProductQuickDetail('<%= product._id || product.slug %>')">
                          <img src="<%= product.primaryImageUrl %>" alt="<%= product.name %>" class="max-h-full max-w-full object-contain">
                        </div>
                      </td>

                      <!-- Name & SKU -->
                      <td class="py-3 px-4 font-bold text-gray-900 max-w-xs">
                        <button type="button" onclick="viewProductQuickDetail('<%= product._id || product.slug %>')" class="hover:text-emerald-700 hover:underline text-left flex items-center gap-1.5 font-bold">
                          <span class="truncate"><%= product.name %></span>
                        </button>
                        <div class="flex items-center gap-1.5 mt-0.5">
                          <span class="text-[10px] text-emerald-800 font-mono font-semibold bg-emerald-50 px-1.5 py-0.2 rounded">
                            <%= product.sku || 'NO-SKU' %>
                          </span>
                          <a href="/product/<%= product.slug %>" target="_blank" class="text-[10px] text-gray-400 hover:text-emerald-700 flex items-center gap-0.5" title="View live storefront PDP">
                            <span>PDP</span>
                            <i class="fa-solid fa-arrow-up-right-from-square text-[8px]"></i>
                          </a>
                        </div>
                      </td>

                      <% if (!isSeller) { %>
                        <!-- Merchant / Store -->
                        <td class="py-3 px-4 whitespace-nowrap">
                          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold <%= product.seller ? 'bg-amber-50 text-amber-900 border border-amber-200' : 'bg-gray-100 text-gray-600' %>">
                            <i class="fa-solid fa-store text-[9px] text-amber-700"></i>
                            <span><%= product.sellerName || (product.seller && (product.seller.storeName || product.seller.name)) || 'ViVA Direct' %></span>
                          </span>
                        </td>
                      <% } %>

                      <!-- Category -->
                      <td class="py-3 px-4 whitespace-nowrap">
                        <span class="bg-gray-100 text-gray-700 px-2 py-0.5 rounded text-[10px] font-semibold">
                          <%= product.category %>
                        </span>
                      </td>

                      <!-- Stock Quantity -->
                      <td class="py-3 px-4 whitespace-nowrap">
                        <span class="inline-flex items-center gap-1 font-semibold <%= isOutOfStock ? 'text-rose-600' : (isLowStock ? 'text-amber-700' : 'text-gray-700') %>">
                          <span class="w-1.5 h-1.5 rounded-full <%= isOutOfStock ? 'bg-rose-500' : (isLowStock ? 'bg-amber-500' : 'bg-emerald-500') %>"></span>
                          <span><%= stock %> units</span>
                        </span>
                      </td>

                      <!-- Regular Price -->
                      <td class="py-3 px-4 text-gray-400 line-through whitespace-nowrap">
                        $<%= (product.price || 0).toFixed(2) %>
                      </td>

                      <!-- Sale Price -->
                      <td class="py-3 px-4 font-bold text-[#c8503f] whitespace-nowrap">
                        $<%= (product.salePrice || product.price || 0).toFixed(2) %>
                        <% if (product.discountPercent) { %>
                          <span class="text-[9px] bg-rose-50 text-rose-700 px-1 py-0.2 rounded font-bold ml-1">
                            -<%= product.discountPercent %>%
                          </span>
                        <% } %>
                      </td>

                      <!-- Status Badge & One-Click Toggle -->
                      <td class="py-3 px-4 whitespace-nowrap">
                        <form action="/admin/products/status/<%= product._id || product.slug %>" method="POST" class="inline">
                          <button 
                            type="submit" 
                            class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider transition-colors <%= (product.status === 'draft') ? 'bg-gray-100 text-gray-600 hover:bg-gray-200' : (product.status === 'archived' ? 'bg-amber-100 text-amber-800 hover:bg-amber-200' : 'bg-emerald-100 text-emerald-800 hover:bg-emerald-200') %>"
                            title="Click to toggle Published / Draft status"
                          >
                            <span class="w-1.5 h-1.5 rounded-full <%= (product.status === 'draft') ? 'bg-gray-400' : (product.status === 'archived' ? 'bg-amber-500' : 'bg-emerald-500') %>"></span>
                            <span><%= product.status || 'published' %></span>
                          </button>
                        </form>
                      </td>

                      <!-- Top Pick Toggle -->
                      <td class="py-3 px-4 text-center whitespace-nowrap">
                        <form action="/admin/top-picks/toggle/<%= product._id || product.slug %>" method="POST" class="inline">
                          <button 
                            type="submit" 
                            class="px-2.5 py-1 rounded-full text-[10px] font-bold transition-colors <%= product.isTopPick ? 'bg-amber-50 text-amber-900 border border-amber-200/80 hover:bg-amber-100' : 'bg-gray-100 text-gray-500 hover:bg-gray-200' %>" 
                            title="Click to toggle Top Pick status"
                          >
                            <i class="fa-solid fa-star text-[9px] <%= product.isTopPick ? 'text-amber-500' : 'text-gray-300' %>"></i>
                            <span><%= product.isTopPick ? 'Top Pick' : 'Standard' %></span>
                          </button>
                        </form>
                      </td>

                      <!-- Actions -->
                      <td class="py-3 px-4 text-right whitespace-nowrap">
                        <div class="flex items-center justify-end gap-1.5">
                          <button 
                            type="button" 
                            onclick="viewProductQuickDetail('<%= product._id || product.slug %>')"
                            class="text-gray-600 hover:text-[#123524] hover:bg-gray-100 p-1.5 rounded-lg transition-colors font-bold" 
                            title="Quick View Product"
                          >
                            <i class="fa-solid fa-eye text-xs"></i>
                          </button>
                          <a 
                            href="/admin/products/edit/<%= product._id || product.slug %>" 
                            class="text-gray-600 hover:text-[#123524] hover:bg-gray-100 p-1.5 rounded-lg transition-colors font-bold" 
                            title="Edit Product Details &amp; Variants"
                          >
                            <i class="fa-solid fa-pen-to-square text-xs"></i>
                          </a>
                          <form action="/admin/products/delete/<%= product._id || product.slug %>" method="POST" onsubmit="return confirm('Delete this product permanently from the database?');" class="inline">
                            <button type="submit" class="text-gray-400 hover:text-rose-600 p-1.5 rounded-lg hover:bg-rose-50 transition-colors" title="Delete Product">
                              <i class="fa-regular fa-trash-can text-xs"></i>
                            </button>
                          </form>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="<%= !isSeller ? 11 : 10 %>" class="py-12 text-center text-gray-400">
                      <i class="fa-solid fa-box-open text-2xl mb-2 block text-gray-300"></i>
                      No products found matching your search or filters.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>

          <!-- Pagination Bar -->
          <% if (pagination && pagination.totalPages > 1) { %>
            <div class="p-4 border-t border-gray-100 flex items-center justify-between text-xs bg-gray-50/50">
              <span class="text-gray-500 font-medium">
                Showing page <%= pagination.page %> of <%= pagination.totalPages %> (<%= pagination.totalProducts %> total products)
              </span>
              <div class="flex items-center gap-1.5">
                <% if (pagination.hasPrevPage) { %>
                  <a href="/admin/products?page=<%= pagination.page - 1 %>&search=<%= query.search || '' %>&category=<%= query.category || 'all' %>&stock=<%= query.stock || 'all' %>&status=<%= query.status || 'all' %>&sellerId=<%= query.sellerId || '' %>&sort=<%= query.sort || 'newest' %>" class="px-3 py-1.5 rounded-lg border border-gray-200 bg-white hover:bg-gray-50 font-bold text-gray-700">
                    &larr; Prev
                  </a>
                <% } %>
                <% for(let p = 1; p <= pagination.totalPages; p++) { %>
                  <a href="/admin/products?page=<%= p %>&search=<%= query.search || '' %>&category=<%= query.category || 'all' %>&stock=<%= query.stock || 'all' %>&status=<%= query.status || 'all' %>&sellerId=<%= query.sellerId || '' %>&sort=<%= query.sort || 'newest' %>" class="px-3 py-1.5 rounded-lg font-bold transition-colors <%= p === pagination.page ? 'bg-[#123524] text-white' : 'border border-gray-200 bg-white text-gray-700 hover:bg-gray-50' %>">
                    <%= p %>
                  </a>
                <% } %>
                <% if (pagination.hasNextPage) { %>
                  <a href="/admin/products?page=<%= pagination.page + 1 %>&search=<%= query.search || '' %>&category=<%= query.category || 'all' %>&stock=<%= query.stock || 'all' %>&status=<%= query.status || 'all' %>&sellerId=<%= query.sellerId || '' %>&sort=<%= query.sort || 'newest' %>" class="px-3 py-1.5 rounded-lg border border-gray-200 bg-white hover:bg-gray-50 font-bold text-gray-700">
                    Next &rarr;
                  </a>
                <% } %>
              </div>
            </div>
          <% } %>
        </div>
      </form>

    </main>
  </div>

  <!-- Quick View Product Modal -->
  <div id="productQuickViewModal" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-xl space-y-4">
      <div class="flex items-center justify-between border-b border-gray-100 pb-3">
        <div>
          <h3 class="font-heading font-bold text-base text-[#123524]" id="modalProdTitle">Product Details</h3>
          <span class="text-[11px] text-gray-400 font-mono" id="modalProdSku"></span>
        </div>
        <button onclick="document.getElementById('productQuickViewModal').classList.add('hidden')" class="text-gray-400 hover:text-gray-600 text-lg font-bold">&times;</button>
      </div>

      <div class="grid grid-cols-3 gap-4 text-xs">
        <div class="col-span-1 bg-gray-50 rounded-xl p-2 border border-gray-100 flex items-center justify-center h-32">
          <img id="modalProdImg" src="" alt="Product" class="max-h-full max-w-full object-contain">
        </div>
        <div class="col-span-2 space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-gray-400">Category:</span>
            <span class="font-bold text-gray-800" id="modalProdCategory"></span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-gray-400">Price:</span>
            <span class="font-bold text-sm text-[#c8503f]" id="modalProdPrice"></span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-gray-400">Current Stock:</span>
            <span class="font-bold text-gray-800" id="modalProdStock"></span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-gray-400">Status:</span>
            <span class="font-bold uppercase text-[10px] px-2 py-0.5 rounded-full" id="modalProdStatus"></span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-gray-400">Seller:</span>
            <span class="font-semibold text-gray-700" id="modalProdSeller"></span>
          </div>
        </div>
      </div>

      <div class="space-y-1 text-xs border-t border-gray-100 pt-3">
        <span class="font-bold text-gray-700">Description:</span>
        <p class="text-gray-600 leading-relaxed text-[11px]" id="modalProdDesc"></p>
      </div>

      <div class="flex items-center justify-between border-t border-gray-100 pt-3 text-xs">
        <a id="modalProdLiveLink" href="#" target="_blank" class="text-emerald-700 hover:underline font-bold flex items-center gap-1">
          <span>View on Storefront</span>
          <i class="fa-solid fa-arrow-up-right-from-square text-[9px]"></i>
        </a>
        <a id="modalProdEditLink" href="#" class="px-4 py-2 bg-[#123524] hover:bg-[#1a4b33] text-white rounded-xl font-bold transition-colors">
          Full Edit
        </a>
      </div>
    </div>
  </div>

  <script>
    function toggleSelectAllProducts(master) {
      document.querySelectorAll('.prod-checkbox').forEach(cb => cb.checked = master.checked);
      updateSelectedProductsCount();
    }

    function updateSelectedProductsCount() {
      const selected = document.querySelectorAll('.prod-checkbox:checked').length;
      document.getElementById('prodSelectedCount').innerText = `${selected} products selected`;
    }

    function handleBulkActionChange(select) {
      const catSelect = document.getElementById('targetCatSelect');
      if (select.value === 'changeCategory') {
        catSelect.classList.remove('hidden');
      } else {
        catSelect.classList.add('hidden');
      }
    }

    async function viewProductQuickDetail(id) {
      try {
        const res = await fetch(`/admin/products/view/${id}`);
        const data = await res.json();
        if (data.success && data.product) {
          const p = data.product;
          document.getElementById('modalProdTitle').innerText = p.name;
          document.getElementById('modalProdSku').innerText = `SKU: ${p.sku || 'N/A'}`;
          document.getElementById('modalProdImg').src = p.primaryImageUrl || '/images/products/headphones.png';
          document.getElementById('modalProdCategory').innerText = p.category || 'General';
          document.getElementById('modalProdPrice').innerText = `$${(p.salePrice || p.price || 0).toFixed(2)}`;
          document.getElementById('modalProdStock').innerText = `${p.stockQuantity || 0} units`;
          
          const statusBadge = document.getElementById('modalProdStatus');
          statusBadge.innerText = p.status || 'published';
          statusBadge.className = `font-bold uppercase text-[10px] px-2 py-0.5 rounded-full ${p.status === 'draft' ? 'bg-gray-100 text-gray-700' : 'bg-emerald-100 text-emerald-800'}`;
          
          document.getElementById('modalProdSeller').innerText = p.sellerName || 'ViVA Official';
          document.getElementById('modalProdDesc').innerText = p.description || 'No description provided.';
          document.getElementById('modalProdLiveLink').href = `/product/${p.slug}`;
          document.getElementById('modalProdEditLink').href = `/admin/products/edit/${p._id || p.slug}`;

          document.getElementById('productQuickViewModal').classList.remove('hidden');
        }
      } catch (err) {
        console.error('Error fetching product quick view:', err);
      }
    }
  </script>

</body>
</html>
