<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Inventory Management — ViVA Admin' %></title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { font-family: 'Inter', sans-serif; }
    .font-heading { font-family: 'Poppins', sans-serif; }
  </style>
</head>
<body class="bg-[#fafaf9] text-[#16261d] min-h-screen flex">
  
  <%- include('sidebar') %>

  <!-- Main Content Area -->
  <div class="flex-1 flex flex-col min-w-0">
    <%- include('topbar') %>

    <main class="p-6 sm:p-8 space-y-6 flex-1 overflow-y-auto">
      
      <!-- Notifications -->
      <% if (message) { %>
        <div class="p-4 rounded-xl text-xs font-semibold flex items-center justify-between shadow-xs bg-emerald-50 text-emerald-800 border border-emerald-200">
          <div class="flex items-center gap-2">
            <i class="fa-solid fa-circle-check text-emerald-600"></i>
            <span><%= message %></span>
          </div>
          <button onclick="this.parentElement.remove()" class="text-emerald-700 hover:text-emerald-900 font-bold">&times;</button>
        </div>
      <% } %>

      <!-- Top Header & Primary Actions -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h2 class="font-heading font-bold text-xl text-[#123524]">Real-Time Inventory &amp; Stock Control</h2>
          <p class="text-xs text-gray-500 mt-0.5">Monitor stock availability, track low-stock thresholds, and review chronological inventory logs.</p>
        </div>
        <div class="flex items-center gap-2.5">
          <a href="/admin/products" class="inline-flex items-center gap-2 px-3.5 py-2.5 rounded-xl border border-gray-200 text-gray-700 bg-white hover:bg-gray-50 text-xs font-bold transition-colors shadow-2xs">
            <i class="fa-solid fa-boxes-stacked text-emerald-700 text-xs"></i> Products Catalog
          </a>
        </div>
      </div>

      <!-- KPI Metrics Strip -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="bg-white p-4 rounded-2xl border border-gray-200/80 shadow-xs">
          <div class="flex items-center justify-between text-gray-400">
            <span class="text-[10px] font-bold uppercase tracking-wider">Total Units in Stock</span>
            <i class="fa-solid fa-boxes-stacked text-emerald-700 text-xs"></i>
          </div>
          <div class="text-2xl font-bold font-heading text-[#123524] mt-1"><%= stats.totalStockUnits.toLocaleString() %></div>
          <p class="text-[10px] text-gray-400 mt-0.5">Across <%= stats.totalProducts %> product listings</p>
        </div>

        <div class="bg-white p-4 rounded-2xl border border-gray-200/80 shadow-xs">
          <div class="flex items-center justify-between text-emerald-600">
            <span class="text-[10px] font-bold uppercase tracking-wider">Healthy Stock</span>
            <i class="fa-solid fa-circle-check text-xs"></i>
          </div>
          <div class="text-2xl font-bold font-heading text-emerald-700 mt-1"><%= stats.inStockCount %></div>
          <p class="text-[10px] text-gray-400 mt-0.5">Above minimum threshold</p>
        </div>

        <div class="bg-white p-4 rounded-2xl border border-gray-200/80 shadow-xs">
          <div class="flex items-center justify-between text-amber-600">
            <span class="text-[10px] font-bold uppercase tracking-wider">Low Stock Warnings</span>
            <i class="fa-solid fa-triangle-exclamation text-xs"></i>
          </div>
          <div class="text-2xl font-bold font-heading text-amber-700 mt-1"><%= stats.lowStockCount %></div>
          <p class="text-[10px] text-amber-700 font-semibold mt-0.5">Immediate re-order advised</p>
        </div>

        <div class="bg-white p-4 rounded-2xl border border-gray-200/80 shadow-xs">
          <div class="flex items-center justify-between text-rose-600">
            <span class="text-[10px] font-bold uppercase tracking-wider">Out of Stock</span>
            <i class="fa-solid fa-circle-xmark text-xs"></i>
          </div>
          <div class="text-2xl font-bold font-heading text-rose-700 mt-1"><%= stats.outOfStockCount %></div>
          <p class="text-[10px] text-rose-700 font-semibold mt-0.5">Unavailable on storefront</p>
        </div>
      </div>

      <!-- Filters & Search Toolbar -->
      <div class="space-y-3">
        <!-- Stock Status Tabs -->
        <div class="flex items-center gap-1.5 flex-wrap text-xs">
          <a href="/admin/inventory?stockStatus=all" class="px-3 py-1.5 rounded-xl font-bold transition-colors <%= (!query.stockStatus || query.stockStatus === 'all') ? 'bg-[#123524] text-white shadow-2xs' : 'bg-white text-gray-600 border border-gray-200 hover:bg-gray-50' %>">
            All Items (<%= stats.totalProducts %>)
          </a>
          <a href="/admin/inventory?stockStatus=low-stock" class="px-3 py-1.5 rounded-xl font-bold transition-colors <%= query.stockStatus === 'low-stock' ? 'bg-amber-600 text-white shadow-2xs' : 'bg-white text-amber-700 border border-amber-200 hover:bg-amber-50' %>">
            Low Stock Warnings (<%= stats.lowStockCount %>)
          </a>
          <a href="/admin/inventory?stockStatus=out-of-stock" class="px-3 py-1.5 rounded-xl font-bold transition-colors <%= query.stockStatus === 'out-of-stock' ? 'bg-rose-700 text-white shadow-2xs' : 'bg-white text-rose-700 border border-rose-200 hover:bg-rose-50' %>">
            Out of Stock (<%= stats.outOfStockCount %>)
          </a>
          <a href="/admin/inventory?stockStatus=in-stock" class="px-3 py-1.5 rounded-xl font-bold transition-colors <%= query.stockStatus === 'in-stock' ? 'bg-emerald-700 text-white shadow-2xs' : 'bg-white text-emerald-800 border border-emerald-200 hover:bg-emerald-50' %>">
            Healthy Stock (<%= stats.inStockCount %>)
          </a>
        </div>

        <!-- Search, Category & Sort Bar -->
        <form action="/admin/inventory" method="GET" class="bg-white p-3 rounded-2xl border border-gray-200/80 shadow-xs flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
          <input type="hidden" name="stockStatus" value="<%= query.stockStatus || 'all' %>">
          <div class="relative flex-1">
            <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
            <input 
              type="text" 
              name="search" 
              value="<%= query.search || '' %>" 
              placeholder="Search by product name, SKU, or category..." 
              class="w-full pl-9 pr-4 py-1.5 text-xs rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-emerald-500"
            >
          </div>

          <div class="flex items-center gap-2 flex-wrap">
            <% if (!isSeller && sellers && sellers.length > 0) { %>
              <!-- Seller Store Filter -->
              <select name="sellerId" onchange="this.form.submit()" class="text-xs px-3 py-1.5 border border-amber-300 rounded-xl bg-amber-50/60 focus:outline-none font-semibold text-amber-900">
                <option value="">All Sellers &amp; Stores</option>
                <% sellers.forEach(s => { %>
                  <option value="<%= s._id %>" <%= (selectedSellerId == s._id.toString() || query.sellerId == s._id.toString()) ? 'selected' : '' %>>
                    <%= s.storeName || s.name %>
                  </option>
                <% }) %>
              </select>
            <% } %>

            <select name="category" onchange="this.form.submit()" class="text-xs px-3 py-1.5 border border-gray-200 rounded-xl bg-white focus:outline-none font-medium text-gray-700">
              <option value="all">All Categories</option>
              <% (categories || []).forEach(cat => { %>
                <option value="<%= cat.name %>" <%= (query.category === cat.name) ? 'selected' : '' %>><%= cat.name %></option>
              <% }) %>
            </select>

            <select name="sort" onchange="this.form.submit()" class="text-xs px-3 py-1.5 border border-gray-200 rounded-xl bg-white focus:outline-none font-medium text-gray-700">
              <option value="stock-asc" <%= (!query.sort || query.sort === 'stock-asc') ? 'selected' : '' %>>Stock: Low to High</option>
              <option value="stock-desc" <%= query.sort === 'stock-desc' ? 'selected' : '' %>>Stock: High to Low</option>
              <option value="name-asc" <%= query.sort === 'name-asc' ? 'selected' : '' %>>Product Name A-Z</option>
              <option value="newest" <%= query.sort === 'newest' ? 'selected' : '' %>>Newest Listed</option>
            </select>

            <button type="submit" class="px-4 py-1.5 bg-[#123524] text-white text-xs font-bold rounded-xl hover:bg-[#1a4b33] transition-colors">
              Filter
            </button>
            <% if (query.search || (query.category && query.category !== 'all') || (query.stockStatus && query.stockStatus !== 'all') || query.sellerId) { %>
              <a href="/admin/inventory" class="px-3 py-1.5 text-xs text-gray-500 hover:text-gray-800 font-semibold">Reset</a>
            <% } %>
          </div>
        </form>
      </div>

      <!-- Inventory Table -->
      <div class="bg-white rounded-2xl border border-gray-200/80 overflow-hidden shadow-xs">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead>
              <tr class="text-gray-400 uppercase tracking-wider text-[10px] border-b border-gray-100 bg-gray-50/70">
                <th class="py-3 px-4">Thumbnail</th>
                <th class="py-3 px-4">Product Name &amp; SKU</th>
                <% if (!isSeller) { %>
                  <th class="py-3 px-4">Merchant / Store</th>
                <% } %>
                <th class="py-3 px-4">Category</th>
                <th class="py-3 px-4">Unit Price</th>
                <th class="py-3 px-4">Current Stock</th>
                <th class="py-3 px-4">Alert Threshold</th>
                <th class="py-3 px-4">Availability</th>
                <th class="py-3 px-4 text-right">Stock Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% if (products && products.length > 0) { %>
                <% products.forEach(prod => { %>
                  <% 
                    const stock = Number(prod.stockQuantity) || 0;
                    const threshold = Number(prod.lowStockThreshold) || 10;
                    const isOutOfStock = stock <= 0;
                    const isLowStock = !isOutOfStock && stock <= threshold;
                  %>
                  <tr class="hover:bg-gray-50/70 transition-colors">
                    
                    <!-- Thumbnail -->
                    <td class="py-3 px-4">
                      <div class="w-10 h-10 bg-gray-50 rounded-xl p-1 border border-gray-100 flex items-center justify-center">
                        <img src="<%= prod.primaryImageUrl %>" alt="<%= prod.name %>" class="max-h-full max-w-full object-contain">
                      </div>
                    </td>

                    <!-- Name & SKU -->
                    <td class="py-3 px-4 font-bold text-gray-900 max-w-xs">
                      <div class="truncate text-gray-900"><%= prod.name %></div>
                      <div class="text-[10px] text-emerald-800 font-mono font-semibold bg-emerald-50 px-1.5 py-0.5 rounded inline-block mt-0.5">
                        <%= prod.sku || 'NO-SKU' %>
                      </div>
                    </td>

                    <% if (!isSeller) { %>
                      <!-- Merchant / Store -->
                      <td class="py-3 px-4 whitespace-nowrap">
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold <%= prod.seller ? 'bg-amber-50 text-amber-900 border border-amber-200' : 'bg-gray-100 text-gray-600' %>">
                          <i class="fa-solid fa-store text-[9px] text-amber-700"></i>
                          <span><%= prod.sellerName || (prod.seller && (prod.seller.storeName || prod.seller.name)) || 'ViVA Direct' %></span>
                        </span>
                      </td>
                    <% } %>

                    <!-- Category -->
                    <td class="py-3 px-4 whitespace-nowrap">
                      <span class="bg-gray-100 text-gray-700 px-2 py-0.5 rounded text-[10px] font-semibold">
                        <%= prod.category %>
                      </span>
                    </td>

                    <!-- Price -->
                    <td class="py-3 px-4 whitespace-nowrap font-bold text-gray-900">
                      $<%= (prod.salePrice || prod.price || 0).toFixed(2) %>
                    </td>

                    <!-- Current Stock -->
                    <td class="py-3 px-4 whitespace-nowrap">
                      <span class="inline-flex items-center gap-1.5 font-bold text-sm <%= isOutOfStock ? 'text-rose-600' : (isLowStock ? 'text-amber-700' : 'text-[#123524]') %>">
                        <span class="w-2 h-2 rounded-full <%= isOutOfStock ? 'bg-rose-500' : (isLowStock ? 'bg-amber-500' : 'bg-emerald-500') %>"></span>
                        <span><%= stock %> units</span>
                      </span>
                    </td>

                    <!-- Threshold -->
                    <td class="py-3 px-4 whitespace-nowrap text-gray-500 font-mono">
                      &le; <%= threshold %> units
                    </td>

                    <!-- Availability Badge -->
                    <td class="py-3 px-4 whitespace-nowrap">
                      <% if (isOutOfStock) { %>
                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-bold bg-rose-100 text-rose-800">
                          <i class="fa-solid fa-circle-xmark text-[9px]"></i> Out of Stock
                        </span>
                      <% } else if (isLowStock) { %>
                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800">
                          <i class="fa-solid fa-triangle-exclamation text-[9px]"></i> Low Stock Warning
                        </span>
                      <% } else { %>
                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">
                          <i class="fa-solid fa-circle-check text-[9px]"></i> In Stock
                        </span>
                      <% } %>
                    </td>

                    <!-- Actions -->
                    <td class="py-3 px-4 text-right whitespace-nowrap">
                      <div class="inline-flex items-center gap-1.5">
                        <button 
                          type="button" 
                          data-id="<%= prod._id %>"
                          data-name="<%= prod.name %>"
                          data-sku="<%= prod.sku || '' %>"
                          data-stock="<%= stock %>"
                          onclick="openStockAdjustModal(this.dataset.id, this.dataset.name, this.dataset.sku, parseInt(this.dataset.stock))"
                          class="px-2.5 py-1.5 bg-[#123524] hover:bg-[#1a4b33] text-white rounded-lg text-xs font-bold transition-colors flex items-center gap-1"
                        >
                          <i class="fa-solid fa-sliders text-[10px]"></i>
                          <span>Adjust</span>
                        </button>
                        <button 
                          type="button" 
                          data-id="<%= prod._id %>"
                          data-name="<%= prod.name %>"
                          onclick="openHistoryModal(this.dataset.id, this.dataset.name)"
                          class="px-2.5 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg text-xs font-semibold transition-colors flex items-center gap-1"
                          title="View stock movement logs"
                        >
                          <i class="fa-solid fa-clock-rotate-left text-[10px]"></i>
                          <span>Logs</span>
                        </button>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="<%= !isSeller ? 9 : 8 %>" class="py-12 text-center text-gray-400">
                    <i class="fa-solid fa-boxes-stacked text-2xl mb-2 block text-gray-300"></i>
                    No inventory items found matching your filters.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <!-- Pagination Bar -->
        <% if (pagination && pagination.totalPages > 1) { %>
          <div class="p-4 border-t border-gray-100 flex items-center justify-between text-xs bg-gray-50/50">
            <span class="text-gray-500 font-medium">
              Showing page <%= pagination.page %> of <%= pagination.totalPages %> (<%= pagination.totalItems %> total items)
            </span>
            <div class="flex items-center gap-1.5">
              <% if (pagination.hasPrevPage) { %>
                <a href="/admin/inventory?page=<%= pagination.page - 1 %>&stockStatus=<%= query.stockStatus || 'all' %>&search=<%= query.search || '' %>&category=<%= query.category || 'all' %>&sellerId=<%= query.sellerId || '' %>&sort=<%= query.sort || 'stock-asc' %>" class="px-3 py-1.5 rounded-lg border border-gray-200 bg-white hover:bg-gray-50 font-bold text-gray-700">
                  &larr; Prev
                </a>
              <% } %>
              <% for(let p = 1; p <= pagination.totalPages; p++) { %>
                <a href="/admin/inventory?page=<%= p %>&stockStatus=<%= query.stockStatus || 'all' %>&search=<%= query.search || '' %>&category=<%= query.category || 'all' %>&sellerId=<%= query.sellerId || '' %>&sort=<%= query.sort || 'stock-asc' %>" class="px-3 py-1.5 rounded-lg font-bold transition-colors <%= p === pagination.page ? 'bg-[#123524] text-white' : 'border border-gray-200 bg-white text-gray-700 hover:bg-gray-50' %>">
                  <%= p %>
                </a>
              <% } %>
              <% if (pagination.hasNextPage) { %>
                <a href="/admin/inventory?page=<%= pagination.page + 1 %>&stockStatus=<%= query.stockStatus || 'all' %>&search=<%= query.search || '' %>&category=<%= query.category || 'all' %>&sellerId=<%= query.sellerId || '' %>&sort=<%= query.sort || 'stock-asc' %>" class="px-3 py-1.5 rounded-lg border border-gray-200 bg-white hover:bg-gray-50 font-bold text-gray-700">
                  Next &rarr;
                </a>
              <% } %>
            </div>
          </div>
        <% } %>
      </div>

    </main>
  </div>

  <!-- Stock Adjustment Modal -->
  <div id="stockAdjustModal" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl space-y-4">
      <div class="flex items-center justify-between border-b border-gray-100 pb-3">
        <div>
          <h3 class="font-heading font-bold text-base text-[#123524]">Adjust Stock Level</h3>
          <span class="text-[11px] text-gray-400" id="adjustProdName"></span>
        </div>
        <button onclick="document.getElementById('stockAdjustModal').classList.add('hidden')" class="text-gray-400 hover:text-gray-600 text-lg">&times;</button>
      </div>

      <form action="/admin/inventory/adjust" method="POST" class="space-y-4 text-xs">
        <input type="hidden" name="productId" id="adjustProdId">
        
        <div class="bg-gray-50 p-3 rounded-xl border border-gray-200/80 flex items-center justify-between">
          <span class="text-gray-600 font-medium">Current Stock in DB:</span>
          <span class="font-bold text-sm text-[#123524]" id="currentStockDisplay">0</span>
        </div>

        <div class="space-y-1">
          <label class="font-bold text-gray-700">New Total Stock Quantity</label>
          <input type="number" min="0" name="newStock" id="adjustNewStockInput" required class="w-full px-3 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none font-bold text-sm">
          <span class="text-[10px] text-gray-400">Set the precise current on-hand unit count</span>
        </div>

        <div class="space-y-1">
          <label class="font-bold text-gray-700">Reason for Stock Adjustment</label>
          <select name="reason" class="w-full px-3 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none font-medium">
            <option value="Restock">Restock (Received Batch)</option>
            <option value="Manual Adjustment">Manual Inventory Count</option>
            <option value="Return">Customer Return Restocked</option>
            <option value="Damaged/Loss">Damaged / Expired / Loss</option>
          </select>
        </div>

        <div class="space-y-1">
          <label class="font-bold text-gray-700">Audit Note / PO Number</label>
          <input type="text" name="note" placeholder="e.g. Received PO-8824 from supplier" class="w-full px-3 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none">
        </div>

        <div class="flex items-center justify-end gap-2 pt-2 border-t border-gray-100">
          <button type="button" onclick="document.getElementById('stockAdjustModal').classList.add('hidden')" class="px-4 py-2 text-gray-600 hover:bg-gray-100 rounded-xl font-bold">
            Cancel
          </button>
          <button type="submit" class="px-5 py-2 bg-[#123524] hover:bg-[#1a4b33] text-white font-bold rounded-xl transition-colors shadow-xs">
            Save Stock
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Stock Movement History Modal -->
  <div id="historyModal" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-xl space-y-4">
      <div class="flex items-center justify-between border-b border-gray-100 pb-3">
        <div>
          <h3 class="font-heading font-bold text-base text-[#123524]">Stock Movement History</h3>
          <span class="text-[11px] text-gray-400" id="historyProdName">Audit trail</span>
        </div>
        <button onclick="document.getElementById('historyModal').classList.add('hidden')" class="text-gray-400 hover:text-gray-600 text-lg">&times;</button>
      </div>

      <div id="historyListContainer" class="max-h-80 overflow-y-auto divide-y divide-gray-100 text-xs space-y-2">
        <div class="p-6 text-center text-gray-400">Loading audit history...</div>
      </div>
    </div>
  </div>

  <script>
    function openStockAdjustModal(id, name, sku, currentStock) {
      document.getElementById('adjustProdId').value = id;
      document.getElementById('adjustProdName').innerText = `${name} (${sku})`;
      document.getElementById('currentStockDisplay').innerText = `${currentStock} units`;
      document.getElementById('adjustNewStockInput').value = currentStock;
      document.getElementById('stockAdjustModal').classList.remove('hidden');
    }

    async function openHistoryModal(productId, name) {
      document.getElementById('historyProdName').innerText = name;
      const container = document.getElementById('historyListContainer');
      container.innerHTML = '<div class="p-6 text-center text-gray-400">Loading audit history...</div>';
      document.getElementById('historyModal').classList.remove('hidden');

      try {
        const res = await fetch(`/admin/inventory/history/${productId}`);
        const data = await res.json();
        if (data.success && data.logs && data.logs.length > 0) {
          container.innerHTML = '';
          data.logs.forEach(log => {
            const isPositive = log.changeAmount > 0;
            const row = document.createElement('div');
            row.className = 'py-2.5 flex items-center justify-between gap-3';
            row.innerHTML = `
              <div>
                <div class="flex items-center gap-2">
                  <span class="font-bold text-gray-900">${log.reason}</span>
                  <span class="text-[10px] text-gray-400">${new Date(log.createdAt).toLocaleString()}</span>
                </div>
                <div class="text-[11px] text-gray-500">${log.note || 'No notes attached'}</div>
                <div class="text-[10px] text-gray-400">By: ${log.updatedBy}</div>
              </div>
              <div class="text-right">
                <span class="font-mono font-bold text-xs px-2 py-0.5 rounded-full ${isPositive ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800'}">
                  ${isPositive ? '+' : ''}${log.changeAmount}
                </span>
                <div class="text-[10px] text-gray-400 mt-1">${log.previousStock} &rarr; ${log.newStock}</div>
              </div>
            `;
            container.appendChild(row);
          });
        } else {
          container.innerHTML = '<div class="p-8 text-center text-gray-400">No stock movement logs recorded for this item yet.</div>';
        }
      } catch (e) {
        container.innerHTML = '<div class="p-6 text-center text-rose-600">Error loading logs</div>';
      }
    }
  </script>
</body>
</html>
