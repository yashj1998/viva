<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Hero & Promo Banners — ViVA Admin' %></title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { font-family: 'Inter', sans-serif; }
    .font-heading { font-family: 'Poppins', sans-serif; }
  </style>
</head>
<body class="bg-[#fafaf9] text-[#16261d] min-h-screen flex">
  
  <%- include('sidebar') %>

  <!-- Main Content Area -->
  <div class="flex-1 flex flex-col min-w-0">
    <%- include('topbar') %>

    <main class="p-6 sm:p-8 space-y-8 flex-1 overflow-y-auto">
      
      <!-- Feedback Message -->
      <% if (message) { %>
        <div class="p-4 rounded-xl text-xs font-semibold flex items-center justify-between shadow-xs bg-emerald-50 text-emerald-800 border border-emerald-200">
          <div class="flex items-center gap-2">
            <i class="fa-solid fa-circle-check text-emerald-600"></i>
            <span><%= message %></span>
          </div>
          <button onclick="this.parentElement.remove()" class="text-emerald-700 hover:text-emerald-900">&times;</button>
        </div>
      <% } %>

      <!-- Header & Actions -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h2 class="font-heading font-bold text-xl text-[#123524]">Hero Carousel &amp; Promo Banners</h2>
          <p class="text-xs text-gray-500 mt-0.5">Control homepage marketing visual assets, discount badges, and promotional CTAs.</p>
        </div>
        <div class="flex items-center gap-2">
          <button 
            onclick="document.getElementById('addSlideModal').classList.remove('hidden')"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[#123524] text-white text-xs font-bold hover:bg-[#1a4b33] transition-colors shadow-xs"
          >
            <i class="fa-solid fa-plus text-[11px]"></i> Add Hero Slide
          </button>
          <a href="/#hero" target="_blank" class="inline-flex items-center gap-1.5 px-3.5 py-2.5 rounded-xl border border-gray-200 text-gray-700 bg-white hover:bg-gray-50 text-xs font-bold transition-colors shadow-2xs">
            <i class="fa-solid fa-eye text-emerald-700 text-xs"></i> View on Site
          </a>
        </div>
      </div>

      <!-- SECTION 1: HERO CAROUSEL SLIDES -->
      <div class="space-y-4">
        <div class="flex items-center gap-2">
          <i class="fa-solid fa-panorama text-emerald-700 text-sm"></i>
          <h3 class="font-heading font-bold text-base text-[#123524]">Homepage Hero Carousel Slides</h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <% heroSlides.forEach((slide, idx) => { %>
            <div class="bg-white rounded-2xl border border-gray-200/80 p-5 shadow-xs flex flex-col justify-between space-y-4">
              
              <!-- Slide Preview Box -->
              <div class="rounded-xl p-5 relative overflow-hidden flex items-center justify-between border border-black/5" style="background-color: <%= slide.bgColor || '#f3efe3' %>;">
                <div class="space-y-2 max-w-[65%] z-10">
                  <span class="text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-black/10 text-gray-800">
                    <%= slide.badgeText || 'SALE HIGHLIGHT' %>
                  </span>
                  <h4 class="font-heading font-bold text-base text-[#123524] leading-tight"><%= slide.headline %></h4>
                  <p class="text-[11px] text-gray-600 line-clamp-2"><%= slide.subcopy %></p>
                  <span class="inline-block text-[10px] font-bold px-3 py-1 rounded-full bg-[#123524] text-white shadow-2xs">
                    <%= slide.ctaLabel %>
                  </span>
                </div>
                <div class="w-24 h-24 shrink-0 flex items-center justify-center">
                  <img src="<%= slide.imageUrl || '/images/hero-composite.png' %>" alt="Hero Composite" class="max-h-full object-contain drop-shadow-md">
                </div>
              </div>

              <!-- Slide Edit Form -->
              <form action="/admin/banners/hero/update/<%= slide._id || idx %>" method="POST" class="space-y-3 text-xs">
                <div class="grid grid-cols-2 gap-3">
                  <div>
                    <label class="block font-bold text-gray-600 mb-1">Headline</label>
                    <input type="text" name="headline" value="<%= slide.headline %>" required class="w-full px-2.5 py-1.5 border border-gray-200 rounded-lg">
                  </div>
                  <div>
                    <label class="block font-bold text-gray-600 mb-1">Badge Text</label>
                    <input type="text" name="badgeText" value="<%= slide.badgeText %>" class="w-full px-2.5 py-1.5 border border-gray-200 rounded-lg">
                  </div>
                </div>

                <div>
                  <label class="block font-bold text-gray-600 mb-1">Subcopy</label>
                  <input type="text" name="subcopy" value="<%= slide.subcopy %>" class="w-full px-2.5 py-1.5 border border-gray-200 rounded-lg">
                </div>

                <div class="grid grid-cols-3 gap-2">
                  <div>
                    <label class="block font-bold text-gray-600 mb-1">CTA Label</label>
                    <input type="text" name="ctaLabel" value="<%= slide.ctaLabel %>" class="w-full px-2.5 py-1.5 border border-gray-200 rounded-lg">
                  </div>
                  <div>
                    <label class="block font-bold text-gray-600 mb-1">CTA URL</label>
                    <input type="text" name="ctaUrl" value="<%= slide.ctaUrl %>" class="w-full px-2.5 py-1.5 border border-gray-200 rounded-lg">
                  </div>
                  <div>
                    <label class="block font-bold text-gray-600 mb-1">Bg Color</label>
                    <input type="text" name="bgColor" value="<%= slide.bgColor || '#f3efe3' %>" class="w-full px-2.5 py-1.5 border border-gray-200 rounded-lg font-mono">
                  </div>
                </div>

                <div class="grid grid-cols-3 gap-2">
                  <div class="col-span-2">
                    <label class="block font-bold text-gray-600 mb-1">Image URL</label>
                    <input type="text" name="imageUrl" value="<%= slide.imageUrl %>" class="w-full px-2.5 py-1.5 border border-gray-200 rounded-lg">
                  </div>
                  <div>
                    <label class="block font-bold text-gray-600 mb-1">Sort Order</label>
                    <input type="number" name="sortOrder" value="<%= slide.sortOrder || (idx + 1) %>" class="w-full px-2.5 py-1.5 border border-gray-200 rounded-lg">
                  </div>
                </div>

                <div class="pt-2 flex items-center justify-between border-t border-gray-100">
                  <label class="inline-flex items-center gap-1.5 cursor-pointer">
                    <input type="checkbox" name="isActive" <%= slide.isActive !== false ? 'checked' : '' %> class="rounded text-emerald-600">
                    <span class="text-gray-700 font-semibold">Active Slide</span>
                  </label>

                  <div class="flex items-center gap-2">
                    <button type="submit" class="px-3 py-1.5 bg-[#123524] hover:bg-[#1a4b33] text-white font-bold rounded-lg shadow-2xs">
                      Update Slide
                    </button>
                    <button 
                      type="submit" 
                      formaction="/admin/banners/hero/delete/<%= slide._id || idx %>" 
                      onclick="return confirm('Delete this hero slide?')" 
                      class="px-2.5 py-1.5 text-rose-600 hover:bg-rose-50 rounded-lg"
                    >
                      <i class="fa-regular fa-trash-can"></i>
                    </button>
                  </div>
                </div>
              </form>

            </div>
          <% }) %>
        </div>
      </div>

      <!-- SECTION 2: 3-UP PROMOTIONAL BANNER CARDS -->
      <div class="space-y-4 pt-4 border-t border-gray-200">
        <div class="flex items-center gap-2">
          <i class="fa-solid fa-rectangle-ad text-emerald-700 text-sm"></i>
          <h3 class="font-heading font-bold text-base text-[#123524]">Homepage 3-Column Promo Cards</h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <% promoBanners.forEach((banner, idx) => { %>
            <div class="bg-white rounded-2xl border border-gray-200/80 p-5 shadow-xs space-y-4">
              
              <!-- Promo Card Preview -->
              <div class="rounded-xl p-4 flex items-center justify-between relative overflow-hidden border border-black/5" style="background-color: <%= banner.themeBg || '#eef1e6' %>;">
                <div class="space-y-1.5 max-w-[65%] z-10">
                  <span class="text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-white/70 text-gray-800">
                    <%= banner.badgeLabel %>
                  </span>
                  <h4 class="font-heading font-bold text-sm text-[#123524] leading-tight"><%= banner.title %></h4>
                  <span class="text-[10px] font-bold text-emerald-800 hover:underline">
                    <%= banner.ctaLabel %> &rarr;
                  </span>
                </div>
                <div class="w-16 h-16 shrink-0 flex items-center justify-center">
                  <img src="<%= banner.imageUrl %>" alt="<%= banner.title %>" class="max-h-full object-contain drop-shadow">
                </div>
              </div>

              <!-- Promo Card Form -->
              <form action="/admin/banners/promo/update/<%= banner._id || idx %>" method="POST" class="space-y-3 text-xs">
                <div>
                  <label class="block font-bold text-gray-600 mb-1">Title</label>
                  <input type="text" name="title" value="<%= banner.title %>" required class="w-full px-2.5 py-1.5 border border-gray-200 rounded-lg">
                </div>

                <div class="grid grid-cols-2 gap-2">
                  <div>
                    <label class="block font-bold text-gray-600 mb-1">Badge Tag</label>
                    <input type="text" name="badgeLabel" value="<%= banner.badgeLabel %>" class="w-full px-2.5 py-1.5 border border-gray-200 rounded-lg">
                  </div>
                  <div>
                    <label class="block font-bold text-gray-600 mb-1">Theme Bg Color</label>
                    <input type="text" name="themeBg" value="<%= banner.themeBg %>" class="w-full px-2.5 py-1.5 border border-gray-200 rounded-lg font-mono">
                  </div>
                </div>

                <div class="grid grid-cols-2 gap-2">
                  <div>
                    <label class="block font-bold text-gray-600 mb-1">CTA Label</label>
                    <input type="text" name="ctaLabel" value="<%= banner.ctaLabel %>" class="w-full px-2.5 py-1.5 border border-gray-200 rounded-lg">
                  </div>
                  <div>
                    <label class="block font-bold text-gray-600 mb-1">Target URL</label>
                    <input type="text" name="ctaUrl" value="<%= banner.ctaUrl %>" class="w-full px-2.5 py-1.5 border border-gray-200 rounded-lg">
                  </div>
                </div>

                <div>
                  <label class="block font-bold text-gray-600 mb-1">Image URL</label>
                  <input type="text" name="imageUrl" value="<%= banner.imageUrl %>" class="w-full px-2.5 py-1.5 border border-gray-200 rounded-lg">
                </div>

                <div class="pt-2 flex justify-end">
                  <button type="submit" class="px-3 py-1.5 bg-[#123524] hover:bg-[#1a4b33] text-white font-bold rounded-lg shadow-2xs">
                    Update Card
                  </button>
                </div>
              </form>

            </div>
          <% }) %>
        </div>
      </div>

    </main>
  </div>

  <!-- Add Hero Slide Modal -->
  <div id="addSlideModal" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-xl space-y-4">
      <div class="flex items-center justify-between border-b border-gray-100 pb-3">
        <h3 class="font-heading font-bold text-base text-[#123524]">Add New Hero Slide</h3>
        <button onclick="document.getElementById('addSlideModal').classList.add('hidden')" class="text-gray-400 hover:text-gray-600 text-lg">&times;</button>
      </div>

      <form action="/admin/banners/hero/new" method="POST" class="space-y-3 text-xs">
        <div>
          <label class="block font-bold text-gray-700 mb-1">Main Headline</label>
          <input type="text" name="headline" required placeholder="e.g. Modern Living Essentials" class="w-full px-3 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none">
        </div>

        <div>
          <label class="block font-bold text-gray-700 mb-1">Subcopy Description</label>
          <textarea name="subcopy" rows="2" placeholder="Discover curated home and electronics products." class="w-full px-3 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none"></textarea>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block font-bold text-gray-700 mb-1">Badge Text</label>
            <input type="text" name="badgeText" value="NEW SEASON · SPECIAL DEALS" class="w-full px-3 py-2 border border-gray-200 rounded-xl">
          </div>
          <div>
            <label class="block font-bold text-gray-700 mb-1">Background Tint</label>
            <input type="text" name="bgColor" value="#f3efe3" class="w-full px-3 py-2 border border-gray-200 rounded-xl font-mono">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block font-bold text-gray-700 mb-1">CTA Label</label>
            <input type="text" name="ctaLabel" value="Shop Now →" class="w-full px-3 py-2 border border-gray-200 rounded-xl">
          </div>
          <div>
            <label class="block font-bold text-gray-700 mb-1">CTA URL</label>
            <input type="text" name="ctaUrl" value="/shop" class="w-full px-3 py-2 border border-gray-200 rounded-xl">
          </div>
        </div>

        <div>
          <label class="block font-bold text-gray-700 mb-1">Hero Composite Image URL</label>
          <input type="text" name="imageUrl" value="/images/hero-composite.png" class="w-full px-3 py-2 border border-gray-200 rounded-xl">
        </div>

        <div class="pt-3 flex items-center justify-end gap-2 border-t border-gray-100">
          <button type="button" onclick="document.getElementById('addSlideModal').classList.add('hidden')" class="px-4 py-2 rounded-xl text-gray-600 hover:bg-gray-100 font-semibold">Cancel</button>
          <button type="submit" class="px-4 py-2 rounded-xl bg-[#123524] text-white font-bold hover:bg-[#1a4b33] shadow-xs">Publish Slide</button>
        </div>
      </form>
    </div>
  </div>

</body>
</html>
