<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Audit Trail & Logs — ViVA Admin' %></title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { font-family: 'Inter', sans-serif; }
    .font-heading { font-family: 'Poppins', sans-serif; }
  </style>
</head>
<body class="bg-[#fafaf9] text-[#16261d] min-h-screen flex">
  
  <%- include('sidebar') %>

  <!-- Main Content Area -->
  <div class="flex-1 flex flex-col min-w-0">
    <%- include('topbar') %>

    <main class="p-6 sm:p-8 space-y-6 flex-1 overflow-y-auto">
      
      <!-- Header -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h2 class="font-heading font-bold text-xl text-[#123524]">Security Audit Trail &amp; Activity Log</h2>
          <p class="text-xs text-gray-500 mt-0.5">Immutable record of administrative operations, price modifications, login events, and policy adjustments.</p>
        </div>
        <span class="text-xs font-mono px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 font-bold">
          <%= logs.length %> Events Logged
        </span>
      </div>

      <!-- Filters & Search -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4">
        <div class="flex items-center gap-1.5 flex-wrap text-xs">
          <a href="/admin/audit-logs?module=all" class="px-3 py-1.5 rounded-xl font-bold transition-colors <%= (!query.module || query.module === 'all') ? 'bg-[#123524] text-white shadow-2xs' : 'bg-white text-gray-600 border border-gray-200 hover:bg-gray-50' %>">
            All Modules
          </a>
          <a href="/admin/audit-logs?module=Products" class="px-3 py-1.5 rounded-xl font-bold transition-colors <%= query.module === 'Products' ? 'bg-[#123524] text-white shadow-2xs' : 'bg-white text-gray-600 border border-gray-200 hover:bg-gray-50' %>">
            Products
          </a>
          <a href="/admin/audit-logs?module=Orders" class="px-3 py-1.5 rounded-xl font-bold transition-colors <%= query.module === 'Orders' ? 'bg-[#123524] text-white shadow-2xs' : 'bg-white text-gray-600 border border-gray-200 hover:bg-gray-50' %>">
            Orders
          </a>
          <a href="/admin/audit-logs?module=Settings" class="px-3 py-1.5 rounded-xl font-bold transition-colors <%= query.module === 'Settings' ? 'bg-[#123524] text-white shadow-2xs' : 'bg-white text-gray-600 border border-gray-200 hover:bg-gray-50' %>">
            Settings
          </a>
          <a href="/admin/audit-logs?module=Users" class="px-3 py-1.5 rounded-xl font-bold transition-colors <%= query.module === 'Users' ? 'bg-[#123524] text-white shadow-2xs' : 'bg-white text-gray-600 border border-gray-200 hover:bg-gray-50' %>">
            Users
          </a>
          <a href="/admin/audit-logs?module=Auth" class="px-3 py-1.5 rounded-xl font-bold transition-colors <%= query.module === 'Auth' ? 'bg-[#123524] text-white shadow-2xs' : 'bg-white text-gray-600 border border-gray-200 hover:bg-gray-50' %>">
            Auth
          </a>
        </div>

        <form action="/admin/audit-logs" method="GET" class="relative max-w-xs w-full">
          <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
          <input 
            type="text" 
            name="search" 
            value="<%= query.search || '' %>" 
            placeholder="Search action, email, IP..." 
            class="w-full pl-9 pr-4 py-1.5 text-xs bg-white rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 shadow-2xs"
          >
        </form>
      </div>

      <!-- Audit Logs Table -->
      <div class="bg-white rounded-2xl border border-gray-200/80 overflow-hidden shadow-xs">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-xs">
            <thead>
              <tr class="bg-gray-50/70 border-b border-gray-200 text-gray-400 uppercase font-bold text-[10px] tracking-wider">
                <th class="py-3 px-5">Timestamp</th>
                <th class="py-3 px-5">Staff User</th>
                <th class="py-3 px-5">Action &amp; Module</th>
                <th class="py-3 px-5">Action Details</th>
                <th class="py-3 px-5 text-right">IP Origin</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% if (logs && logs.length > 0) { %>
                <% logs.forEach(log => { %>
                  <tr class="hover:bg-gray-50/60 transition-colors">
                    <!-- Timestamp -->
                    <td class="py-3.5 px-5 text-gray-500 whitespace-nowrap">
                      <div class="font-medium text-gray-800"><%= new Date(log.createdAt).toLocaleDateString() %></div>
                      <div class="text-[10px] text-gray-400"><%= new Date(log.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' }) %></div>
                    </td>

                    <!-- Staff User -->
                    <td class="py-3.5 px-5 whitespace-nowrap">
                      <div class="font-bold text-gray-900"><%= log.userEmail %></div>
                      <span class="text-[9px] uppercase tracking-wider font-bold px-1.5 py-0.2 rounded <%= log.userRole === 'admin' ? 'bg-emerald-100 text-emerald-800' : 'bg-blue-100 text-blue-800' %>">
                        <%= log.userRole %>
                      </span>
                    </td>

                    <!-- Action & Module -->
                    <td class="py-3.5 px-5 whitespace-nowrap">
                      <span class="inline-block font-mono text-[10px] font-bold px-2 py-0.5 rounded bg-gray-100 text-gray-800 mb-0.5">
                        <%= log.action %>
                      </span>
                      <div class="text-[10px] text-emerald-700 font-semibold"><%= log.module %></div>
                    </td>

                    <!-- Details -->
                    <td class="py-3.5 px-5 text-gray-600 max-w-md">
                      <p class="leading-relaxed"><%= log.details || 'No additional parameters' %></p>
                    </td>

                    <!-- IP Address -->
                    <td class="py-3.5 px-5 text-right font-mono text-[11px] text-gray-400 whitespace-nowrap">
                      <%= log.ipAddress || '127.0.0.1' %>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="5" class="py-12 text-center text-gray-400">
                    <i class="fa-solid fa-clipboard-check text-2xl mb-2 block text-gray-300"></i>
                    No audit records found matching your filters.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

    </main>
  </div>

</body>
</html>
