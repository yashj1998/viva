<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Edit Product — ViVA Admin' %></title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { font-family: 'Inter', sans-serif; }
    .font-heading { font-family: 'Poppins', sans-serif; }
  </style>
</head>
<body class="bg-[#fafaf9] text-[#16261d] min-h-screen flex">
  
  <%- include('sidebar') %>

  <div class="flex-1 flex flex-col min-w-0">
    <%- include('topbar') %>

    <main class="p-6 sm:p-8 space-y-8 flex-1 overflow-y-auto max-w-6xl w-full">
      
      <!-- Notifications -->
      <% if (message) { %>
      <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs p-3.5 rounded-xl flex items-center justify-between shadow-2xs">
        <div class="flex items-center gap-2">
          <i class="fa-solid fa-circle-check text-emerald-600 text-sm"></i>
          <span class="font-medium"><%= message %></span>
        </div>
        <button onclick="this.parentElement.remove()" class="text-emerald-500 hover:text-emerald-800 text-base font-bold">&times;</button>
      </div>
      <% } %>

      <!-- Top Header & Breadcrumb -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2 text-xs text-gray-500 mb-1.5">
            <a href="/admin/products" class="hover:text-[#123524] transition-colors flex items-center gap-1 font-semibold">
              <i class="fa-solid fa-arrow-left text-[10px]"></i>
              <span>Back to Catalog</span>
            </a>
            <span>/</span>
            <span class="text-gray-400">Edit Product</span>
          </div>
          <h1 class="font-heading font-bold text-xl sm:text-2xl text-[#0d2a1c] tracking-tight flex items-center gap-2.5">
            <span>Edit: <%= product.name %></span>
          </h1>
          <p class="text-xs text-gray-500 mt-0.5">
            SKU: <span class="font-mono font-bold text-emerald-800"><%= product.sku || 'UNASSIGNED' %></span> &bull; All modifications save directly to the MongoDB database.
          </p>
        </div>

        <div class="flex items-center gap-2.5">
          <a 
            href="/product/<%= product.slug %>" 
            target="_blank" 
            class="bg-white border border-gray-200/80 hover:border-[#123524] text-[#123524] hover:bg-[#123524]/5 px-3.5 py-2 rounded-xl text-xs font-semibold flex items-center gap-2 transition-colors shadow-2xs"
          >
            <i class="fa-solid fa-arrow-up-right-from-square text-[11px]"></i>
            <span>View Live on Site</span>
          </a>
        </div>
      </div>

      <!-- Main Edit Form -->
      <form action="/admin/products/edit/<%= product._id || product.slug %>" method="POST" class="space-y-6">
        
        <!-- Section 1: Basic Information & Identifiers -->
        <div class="bg-white rounded-2xl border border-gray-200/70 p-6 shadow-2xs space-y-4">
          <h2 class="font-heading font-bold text-sm text-[#0d2a1c] flex items-center gap-2 pb-3 border-b border-gray-100">
            <i class="fa-solid fa-info-circle text-[#2c6b48]"></i>
            <span>1. Basic Product Identity &amp; Classification</span>
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            
            <div class="sm:col-span-2 space-y-1">
              <label class="text-[11px] font-semibold text-gray-700">Product Title *</label>
              <input 
                type="text" 
                name="name" 
                required 
                value="<%= product.name %>" 
                class="w-full text-xs p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524] transition-colors"
              >
            </div>

            <div class="space-y-1">
              <label class="text-[11px] font-semibold text-gray-700">Product SKU *</label>
              <div class="flex items-center gap-1.5">
                <input 
                  type="text" 
                  name="sku" 
                  id="skuInput"
                  required 
                  value="<%= product.sku || '' %>" 
                  class="w-full text-xs p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524] transition-colors font-mono font-bold uppercase text-emerald-900"
                >
                <button type="button" onclick="generateRandomSku()" class="px-2.5 py-2.5 bg-gray-100 hover:bg-gray-200 rounded-xl text-[10px] font-bold text-gray-700 shrink-0" title="Generate SKU">
                  <i class="fa-solid fa-arrows-rotate"></i>
                </button>
              </div>
            </div>

            <div class="space-y-1">
              <label class="text-[11px] font-semibold text-gray-700">Listing Status *</label>
              <select name="status" class="w-full text-xs p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524] transition-colors font-bold">
                <option value="published" <%= product.status === 'published' ? 'selected' : '' %>>Published (Live)</option>
                <option value="draft" <%= product.status === 'draft' ? 'selected' : '' %>>Draft (Hidden)</option>
                <option value="archived" <%= product.status === 'archived' ? 'selected' : '' %>>Archived</option>
              </select>
            </div>

            <div class="space-y-1">
              <label class="text-[11px] font-semibold text-gray-700">URL Slug *</label>
              <input 
                type="text" 
                name="slug" 
                required 
                value="<%= product.slug %>" 
                class="w-full text-xs p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524] transition-colors font-mono text-gray-600"
              >
            </div>

            <div class="space-y-1">
              <label class="text-[11px] font-semibold text-gray-700">Category *</label>
              <select name="category" class="w-full text-xs p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524] transition-colors">
                <% (categories || []).forEach(function(cat) { %>
                  <option value="<%= cat.name %>" <%= product.category === cat.name ? 'selected' : '' %>><%= cat.name %></option>
                <% }); %>
              </select>
            </div>

            <div class="space-y-1">
              <label class="text-[11px] font-semibold text-gray-700">Brand Name</label>
              <input 
                type="text" 
                name="brand" 
                value="<%= product.brand || 'ViVA Essentials' %>" 
                placeholder="e.g. ViVA Essentials, Sony, Apple" 
                class="w-full text-xs p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524] transition-colors"
              >
            </div>

            <div class="space-y-1">
              <label class="text-[11px] font-semibold text-gray-700">Promo Badge / Tag</label>
              <input 
                type="text" 
                name="badgeText" 
                value="<%= product.badgeText || '' %>" 
                placeholder="e.g. HOT DEAL, BESTSELLER, STAFF PICK" 
                class="w-full text-xs p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524] transition-colors"
              >
            </div>

          </div>
        </div>

        <!-- Section 2: Pricing, Stock & Inventory Controls -->
        <div class="bg-white rounded-2xl border border-gray-200/70 p-6 shadow-2xs space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-gray-100">
            <h2 class="font-heading font-bold text-sm text-[#0d2a1c] flex items-center gap-2">
              <i class="fa-solid fa-dollar-sign text-[#2c6b48]"></i>
              <span>2. Pricing, Discount &amp; Inventory Controls</span>
            </h2>
            <div id="discountDisplayBadge" class="text-xs font-bold px-2.5 py-1 rounded-full bg-rose-50 text-rose-700 border border-rose-200">
              <%= product.discountPercent ? `-${product.discountPercent}% Off` : 'No Discount' %>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
            
            <div class="space-y-1">
              <label class="text-[11px] font-semibold text-gray-700">Regular Price ($) *</label>
              <input 
                type="number" 
                step="0.01" 
                id="editPriceInput"
                name="price" 
                required 
                value="<%= product.price %>" 
                oninput="calculateLiveDiscount()"
                class="w-full text-xs p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524] transition-colors font-semibold"
              >
            </div>

            <div class="space-y-1">
              <label class="text-[11px] font-semibold text-gray-700">Sale Price ($) *</label>
              <input 
                type="number" 
                step="0.01" 
                id="editSalePriceInput"
                name="salePrice" 
                required 
                value="<%= product.salePrice %>" 
                oninput="calculateLiveDiscount()"
                class="w-full text-xs p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524] transition-colors font-bold text-[#c8503f]"
              >
            </div>

            <div class="space-y-1">
              <label class="text-[11px] font-semibold text-gray-700">Stock Quantity *</label>
              <input 
                type="number" 
                name="stockQuantity" 
                min="0" 
                value="<%= product.stockQuantity || 0 %>" 
                class="w-full text-xs p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524] transition-colors font-bold"
              >
            </div>

            <div class="space-y-1">
              <label class="text-[11px] font-semibold text-gray-700">Low Stock Alert Level</label>
              <input 
                type="number" 
                name="lowStockThreshold" 
                min="1" 
                value="<%= product.lowStockThreshold || 10 %>" 
                class="w-full text-xs p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524] transition-colors font-mono"
              >
            </div>

            <div class="space-y-1">
              <label class="text-[11px] font-semibold text-gray-700">Carousel Position</label>
              <input 
                type="number" 
                name="sortOrder" 
                min="0" 
                value="<%= product.sortOrder || 0 %>" 
                class="w-full text-xs p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524] transition-colors"
              >
            </div>

          </div>

          <div class="pt-2 border-t border-gray-100 flex items-center gap-3">
            <label class="flex items-center gap-2.5 cursor-pointer select-none">
              <input 
                type="checkbox" 
                name="isTopPick" 
                <%= product.isTopPick ? 'checked' : '' %> 
                class="w-4 h-4 text-[#123524] border-gray-300 rounded focus:ring-[#123524]"
              >
              <span class="text-xs font-semibold text-gray-700">Feature in "Top Picks For You" Deals on Homepage</span>
            </label>
          </div>
        </div>

        <!-- Section 3: Media & Gallery -->
        <div class="bg-white rounded-2xl border border-gray-200/70 p-6 shadow-2xs space-y-4">
          <h2 class="font-heading font-bold text-sm text-[#0d2a1c] flex items-center gap-2 pb-3 border-b border-gray-100">
            <i class="fa-solid fa-images text-[#2c6b48]"></i>
            <span>3. Product Imagery &amp; Gallery</span>
          </h2>

          <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
            
            <div class="lg:col-span-8 space-y-4">
              <div class="space-y-1">
                <label class="text-[11px] font-semibold text-gray-700">Primary Product Image URL *</label>
                <input 
                  type="text" 
                  name="primaryImageUrl" 
                  required 
                  value="<%= product.primaryImageUrl %>" 
                  onchange="document.getElementById('previewImg').src = this.value"
                  class="w-full text-xs p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524] transition-colors"
                >
                <span class="text-[10px] text-gray-400">Path to image asset, e.g. /images/products/headphones.png or external HTTPS link</span>
              </div>

              <div class="space-y-1">
                <label class="text-[11px] font-semibold text-gray-700">Additional Gallery Image URLs (1 per line or comma-separated)</label>
                <% 
                  const galleryStr = (product.galleryImages && Array.isArray(product.galleryImages)) 
                    ? product.galleryImages.join('\n') 
                    : ''; 
                %>
                <textarea 
                  name="galleryImages" 
                  rows="3" 
                  placeholder="/images/products/headphones.png&#10;/images/banners/armchair.png" 
                  class="w-full text-xs p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524] transition-colors font-mono"
                ><%= galleryStr %></textarea>
                <span class="text-[10px] text-gray-400">These will appear as interactive thumbnails below the main product photo on the PDP</span>
              </div>
            </div>

            <!-- Image Preview Box -->
            <div class="lg:col-span-4 flex flex-col items-center justify-center p-4 bg-gray-50 rounded-2xl border border-gray-200/80">
              <span class="text-[10px] uppercase font-semibold text-gray-400 mb-2">Live Thumbnail Preview</span>
              <div class="w-32 h-32 bg-white rounded-xl p-2 border border-gray-200 flex items-center justify-center shadow-2xs">
                <img 
                  id="previewImg" 
                  src="<%= product.primaryImageUrl %>" 
                  alt="<%= product.name %>" 
                  class="max-h-full max-w-full object-contain"
                  onerror="this.src='/images/products/headphones.png'"
                >
              </div>
            </div>

          </div>
        </div>

        <!-- Section 4: Variants & Options -->
        <div class="bg-white rounded-2xl border border-gray-200/70 p-6 shadow-2xs space-y-4">
          <h2 class="font-heading font-bold text-sm text-[#0d2a1c] flex items-center gap-2 pb-3 border-b border-gray-100">
            <i class="fa-solid fa-palette text-[#2c6b48]"></i>
            <span>4. Color &amp; Size Variants</span>
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1">
              <label class="text-[11px] font-semibold text-gray-700">Color Options (Comma-separated)</label>
              <% 
                const colorsStr = (product.colors && Array.isArray(product.colors)) 
                  ? product.colors.join(', ') 
                  : ''; 
              %>
              <input 
                type="text" 
                name="colors" 
                value="<%= colorsStr %>" 
                placeholder="e.g. Classic Black, Natural Beige, Forest Green" 
                class="w-full text-xs p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524] transition-colors"
              >
              <span class="text-[10px] text-gray-400">Generates clickable color pills on the Product Detail Page</span>
            </div>

            <div class="space-y-1">
              <label class="text-[11px] font-semibold text-gray-700">Size / Edition Options (Comma-separated)</label>
              <% 
                const sizesStr = (product.sizes && Array.isArray(product.sizes)) 
                  ? product.sizes.join(', ') 
                  : ''; 
              %>
              <input 
                type="text" 
                name="sizes" 
                value="<%= sizesStr %>" 
                placeholder="e.g. Standard, Pro, XL" 
                class="w-full text-xs p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524] transition-colors"
              >
              <span class="text-[10px] text-gray-400">Generates clickable edition/size buttons on the storefront</span>
            </div>
          </div>
        </div>

        <!-- Section 5: Long Description & Feature Bullets -->
        <div class="bg-white rounded-2xl border border-gray-200/70 p-6 shadow-2xs space-y-4">
          <h2 class="font-heading font-bold text-sm text-[#0d2a1c] flex items-center gap-2 pb-3 border-b border-gray-100">
            <i class="fa-solid fa-align-left text-[#2c6b48]"></i>
            <span>5. Narrative Description &amp; Highlights</span>
          </h2>

          <div class="space-y-4">
            <div class="space-y-1">
              <label class="text-[11px] font-semibold text-gray-700">Detailed Product Description</label>
              <textarea 
                name="description" 
                rows="4" 
                class="w-full text-xs p-3 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524] transition-colors leading-relaxed"
                placeholder="Write an engaging overview of the product..."
              ><%= product.description || '' %></textarea>
            </div>

            <div class="space-y-1">
              <label class="text-[11px] font-semibold text-gray-700">Key Feature Bullet Points (1 per line)</label>
              <% 
                const featuresStr = (product.features && Array.isArray(product.features)) 
                  ? product.features.join('\n') 
                  : ''; 
              %>
              <textarea 
                name="features" 
                rows="4" 
                class="w-full text-xs p-3 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524] transition-colors leading-relaxed"
                placeholder="High quality craftsmanship designed for longevity&#10;Ergonomic, modern minimalist aesthetic&#10;Eco-friendly sustainable materials"
              ><%= featuresStr %></textarea>
            </div>
          </div>
        </div>

        <!-- Submit Bar -->
        <div class="bg-white rounded-2xl border border-gray-200/70 p-5 shadow-2xs flex items-center justify-between gap-4 sticky bottom-4">
          <a 
            href="/admin/products" 
            class="text-xs font-semibold text-gray-600 hover:text-gray-900 px-4 py-2.5 rounded-xl hover:bg-gray-100 transition-colors"
          >
            Cancel &amp; Exit
          </a>

          <div class="flex items-center gap-3">
            <button 
              type="submit" 
              class="bg-[#123524] hover:bg-[#17422e] text-white text-xs font-semibold py-2.5 px-6 rounded-xl transition-colors shadow-xs flex items-center gap-2"
            >
              <i class="fa-solid fa-floppy-disk text-xs"></i>
              <span>Save &amp; Update Database</span>
            </button>
          </div>
        </div>

      </form>

    </main>
  </div>

  <script>
    function generateRandomSku() {
      const cat = '<%= (product.category || "GEN").slice(0, 3).toUpperCase() %>';
      const num = Math.floor(100 + Math.random() * 900);
      document.getElementById('skuInput').value = `VIVA-${cat}-${num}`;
    }

    function calculateLiveDiscount() {
      const price = parseFloat(document.getElementById('editPriceInput').value) || 0;
      const salePrice = parseFloat(document.getElementById('editSalePriceInput').value) || price;
      const badge = document.getElementById('discountDisplayBadge');

      if (price > salePrice && price > 0) {
        const pct = Math.round(((price - salePrice) / price) * 100);
        badge.innerText = `-${pct}% Off`;
        badge.className = 'text-xs font-bold px-2.5 py-1 rounded-full bg-rose-50 text-rose-700 border border-rose-200';
      } else {
        badge.innerText = 'No Discount';
        badge.className = 'text-xs font-bold px-2.5 py-1 rounded-full bg-gray-100 text-gray-600 border border-gray-200';
      }
    }
  </script>

</body>
</html>
