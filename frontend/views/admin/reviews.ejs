<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Customer Reviews — ViVA Admin' %></title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { font-family: 'Inter', sans-serif; }
    .font-heading { font-family: 'Poppins', sans-serif; }
  </style>
</head>
<body class="bg-[#fafaf9] text-[#16261d] min-h-screen flex">
  
  <%- include('sidebar') %>

  <!-- Main Content Area -->
  <div class="flex-1 flex flex-col min-w-0">
    <%- include('topbar') %>

    <main class="p-6 sm:p-8 space-y-6 flex-1 overflow-y-auto">
      
      <!-- Feedback Message -->
      <% if (message) { %>
        <div class="p-4 rounded-xl text-xs font-semibold flex items-center justify-between shadow-xs bg-emerald-50 text-emerald-800 border border-emerald-200">
          <div class="flex items-center gap-2">
            <i class="fa-solid fa-circle-check text-emerald-600"></i>
            <span><%= message %></span>
          </div>
          <button onclick="this.parentElement.remove()" class="text-emerald-700 hover:text-emerald-900">&times;</button>
        </div>
      <% } %>

      <!-- Header & Actions -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h2 class="font-heading font-bold text-xl text-[#123524]">Customer Reviews &amp; Social Proof</h2>
          <p class="text-xs text-gray-500 mt-0.5">Curate customer testimonials featured in the homepage social proof carousel.</p>
        </div>
        <div class="flex items-center gap-2">
          <button 
            onclick="document.getElementById('addReviewModal').classList.remove('hidden')"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[#123524] text-white text-xs font-bold hover:bg-[#1a4b33] transition-colors shadow-xs"
          >
            <i class="fa-solid fa-plus text-[11px]"></i> Add Testimonial
          </button>
          <a href="/#testimonials" target="_blank" class="inline-flex items-center gap-1.5 px-3.5 py-2.5 rounded-xl border border-gray-200 text-gray-700 bg-white hover:bg-gray-50 text-xs font-bold transition-colors shadow-2xs">
            <i class="fa-solid fa-eye text-emerald-700 text-xs"></i> View on Site
          </a>
        </div>
      </div>

      <!-- Reviews Grid / Table -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% reviews.forEach((rev, idx) => { %>
          <div class="bg-white rounded-2xl border border-gray-200/80 p-5 shadow-xs flex flex-col justify-between space-y-4">
            
            <div class="space-y-3">
              <!-- Customer Header -->
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <img src="<%= rev.avatarUrl || '/images/avatars/sarah.jpg' %>" alt="<%= rev.customerName %>" class="w-10 h-10 rounded-full object-cover border border-gray-200">
                  <div>
                    <h4 class="font-bold text-gray-900 text-xs"><%= rev.customerName %></h4>
                    <div class="flex items-center text-amber-400 text-[10px] gap-0.5 mt-0.5">
                      <% for(let s=0; s<rev.rating; s++) { %>
                        <i class="fa-solid fa-star"></i>
                      <% } %>
                    </div>
                  </div>
                </div>

                <form action="/admin/reviews/toggle/<%= rev._id || idx %>" method="POST">
                  <button type="submit" class="px-2 py-0.5 rounded-full text-[9px] font-bold uppercase tracking-wider transition-colors <%= rev.isVerified ? 'bg-emerald-100 text-emerald-800' : 'bg-gray-100 text-gray-500' %>" title="Click to toggle verified buyer badge">
                    <i class="fa-solid fa-certificate text-[9px] mr-1"></i>
                    <%= rev.isVerified ? 'Verified' : 'Unverified' %>
                  </button>
                </form>
              </div>

              <!-- Review Body -->
              <p class="text-xs text-gray-600 italic leading-relaxed bg-[#fafaf9] p-3 rounded-xl border border-gray-100">
                "<%= rev.body %>"
              </p>
            </div>

            <!-- Footer & Delete -->
            <div class="flex items-center justify-between pt-2 border-t border-gray-100 text-[11px] text-gray-400">
              <span>Sort Order: #<%= rev.sortOrder || (idx + 1) %></span>
              <form action="/admin/reviews/delete/<%= rev._id || idx %>" method="POST" onsubmit="return confirm('Delete this review?')" class="inline">
                <button type="submit" class="text-gray-400 hover:text-rose-600 transition-colors p-1" title="Delete Review">
                  <i class="fa-regular fa-trash-can text-xs"></i>
                </button>
              </form>
            </div>

          </div>
        <% }) %>
      </div>

    </main>
  </div>

  <!-- Add Review Modal -->
  <div id="addReviewModal" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl space-y-4">
      <div class="flex items-center justify-between border-b border-gray-100 pb-3">
        <h3 class="font-heading font-bold text-base text-[#123524]">Add Customer Review</h3>
        <button onclick="document.getElementById('addReviewModal').classList.add('hidden')" class="text-gray-400 hover:text-gray-600 text-lg">&times;</button>
      </div>

      <form action="/admin/reviews/new" method="POST" class="space-y-3 text-xs">
        <div>
          <label class="block font-bold text-gray-700 mb-1">Customer Full Name</label>
          <input type="text" name="customerName" required placeholder="e.g. Rachel Adams" class="w-full px-3 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none">
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block font-bold text-gray-700 mb-1">Rating Stars (1-5)</label>
            <select name="rating" class="w-full px-3 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none">
              <option value="5" selected>5 Stars (★★★★★)</option>
              <option value="4">4 Stars (★★★★☆)</option>
              <option value="3">3 Stars (★★★☆☆)</option>
            </select>
          </div>

          <div>
            <label class="block font-bold text-gray-700 mb-1">Sort Order</label>
            <input type="number" name="sortOrder" value="1" class="w-full px-3 py-2 border border-gray-200 rounded-xl">
          </div>
        </div>

        <div>
          <label class="block font-bold text-gray-700 mb-1">Avatar Image URL</label>
          <input type="text" name="avatarUrl" value="/images/avatars/sarah.jpg" class="w-full px-3 py-2 border border-gray-200 rounded-xl">
        </div>

        <div>
          <label class="block font-bold text-gray-700 mb-1">Review Feedback</label>
          <textarea name="body" required rows="3" placeholder="Share the verified customer experience..." class="w-full px-3 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none"></textarea>
        </div>

        <div>
          <label class="inline-flex items-center gap-2 cursor-pointer font-bold text-gray-700">
            <input type="checkbox" name="isVerified" checked class="rounded text-emerald-600">
            <span>Verified Purchase Badge</span>
          </label>
        </div>

        <div class="pt-3 flex items-center justify-end gap-2 border-t border-gray-100">
          <button type="button" onclick="document.getElementById('addReviewModal').classList.add('hidden')" class="px-4 py-2 rounded-xl text-gray-600 hover:bg-gray-100 font-semibold">Cancel</button>
          <button type="submit" class="px-4 py-2 rounded-xl bg-[#123524] text-white font-bold hover:bg-[#1a4b33] shadow-xs">Publish Review</button>
        </div>
      </form>
    </div>
  </div>

</body>
</html>
