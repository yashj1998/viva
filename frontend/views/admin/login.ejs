<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'ViVA Admin Portal — Sign In' %></title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { font-family: 'Inter', sans-serif; }
    .font-heading { font-family: 'Poppins', sans-serif; }
  </style>
</head>
<body class="min-h-screen bg-[#f3efe3] flex flex-col items-center justify-center p-4">
  
  <div class="w-full max-w-md bg-white rounded-3xl border border-gray-200/80 p-8 sm:p-10 shadow-lg space-y-6">
    
    <!-- Logo & Header -->
    <div class="text-center space-y-2">
      <div class="w-12 h-12 rounded-2xl bg-[#123524] text-emerald-400 flex items-center justify-center mx-auto text-xl shadow-xs">
        <i class="fa-solid fa-shield-halved"></i>
      </div>
      <h1 class="font-heading font-bold text-2xl text-[#0d2a1c] tracking-tight">ViVA Admin Portal</h1>
      <p class="text-xs text-gray-500">Sign in to manage catalog, orders, and customer operations.</p>
    </div>

    <!-- Error Alert -->
    <% if (error) { %>
    <div class="bg-rose-50 border border-rose-200 text-rose-700 text-xs p-3 rounded-xl flex items-center gap-2">
      <i class="fa-solid fa-circle-exclamation"></i>
      <span><%= error %></span>
    </div>
    <% } %>

    <!-- Login Form -->
    <form action="/admin/login" method="POST" class="space-y-4">
      <div class="space-y-1.5">
        <label for="email" class="text-xs font-semibold text-gray-700">Administrator Email</label>
        <div class="relative">
          <span class="absolute left-3.5 top-3 text-gray-400 text-xs">
            <i class="fa-regular fa-envelope"></i>
          </span>
          <input 
            type="email" 
            id="email" 
            name="email" 
            value="admin@viva.com" 
            required
            placeholder="admin@viva.com"
            class="w-full text-xs pl-9 pr-3 py-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524] focus:ring-2 focus:ring-[#123524]/10 transition-all"
          >
        </div>
      </div>

      <div class="space-y-1.5">
        <label for="password" class="text-xs font-semibold text-gray-700">Password</label>
        <div class="relative">
          <span class="absolute left-3.5 top-3 text-gray-400 text-xs">
            <i class="fa-solid fa-lock"></i>
          </span>
          <input 
            type="password" 
            id="password" 
            name="password" 
            value="admin123" 
            required
            placeholder="&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;"
            class="w-full text-xs pl-9 pr-3 py-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:border-[#123524] focus:ring-2 focus:ring-[#123524]/10 transition-all"
          >
        </div>
      </div>

      <div class="bg-amber-50 rounded-xl p-2.5 border border-amber-200/80 text-[11px] text-amber-900 flex items-center justify-between">
        <span>Default credentials:</span>
        <code class="font-mono font-bold bg-white px-2 py-0.5 rounded text-[10px]">admin@viva.com / admin123</code>
      </div>

      <button 
        type="submit" 
        class="w-full bg-[#123524] hover:bg-[#17422e] text-white font-semibold text-xs sm:text-sm py-3 px-4 rounded-xl transition-all duration-150 transform hover:scale-[1.01] shadow-xs"
      >
        Sign In to Console
      </button>
    </form>

    <div class="text-center pt-2 border-t border-gray-100">
      <a href="/" class="text-xs text-gray-500 hover:text-[#123524] font-medium flex items-center justify-center gap-1.5 transition-colors">
        <i class="fa-solid fa-arrow-left text-[10px]"></i>
        <span>Return to Public Storefront</span>
      </a>
    </div>

  </div>

</body>
</html>
