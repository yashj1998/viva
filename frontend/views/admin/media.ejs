<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Media Library — ViVA Admin' %></title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { font-family: 'Inter', sans-serif; }
    .font-heading { font-family: 'Poppins', sans-serif; }
  </style>
</head>
<body class="bg-[#fafaf9] text-[#16261d] min-h-screen flex">
  
  <%- include('sidebar') %>

  <!-- Main Content Area -->
  <div class="flex-1 flex flex-col min-w-0">
    <%- include('topbar') %>

    <main class="p-6 sm:p-8 space-y-6 flex-1 overflow-y-auto">
      
      <!-- Feedback Message -->
      <% if (message) { %>
        <div class="p-4 rounded-xl text-xs font-semibold flex items-center justify-between shadow-xs bg-emerald-50 text-emerald-800 border border-emerald-200">
          <div class="flex items-center gap-2">
            <i class="fa-solid fa-circle-check text-emerald-600"></i>
            <span><%= message %></span>
          </div>
          <button onclick="this.parentElement.remove()" class="text-emerald-700 hover:text-emerald-900">&times;</button>
        </div>
      <% } %>

      <!-- Header & Actions -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h2 class="font-heading font-bold text-xl text-[#123524]">Media &amp; Image Assets Library</h2>
          <p class="text-xs text-gray-500 mt-0.5">Browse product imagery, promo banners, and storefront visual assets with 1-click URL copying.</p>
        </div>
        <button 
          onclick="document.getElementById('addMediaModal').classList.remove('hidden')"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[#123524] text-white text-xs font-bold hover:bg-[#1a4b33] transition-colors shadow-xs shrink-0"
        >
          <i class="fa-solid fa-cloud-arrow-up text-[11px]"></i> Add Media Asset
        </button>
      </div>

      <!-- Filters & Search -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4">
        <div class="flex items-center gap-1.5 flex-wrap text-xs">
          <a href="/admin/media?category=all" class="px-3 py-1.5 rounded-xl font-bold transition-colors <%= (!query.category || query.category === 'all') ? 'bg-[#123524] text-white shadow-2xs' : 'bg-white text-gray-600 border border-gray-200 hover:bg-gray-50' %>">
            All Assets
          </a>
          <a href="/admin/media?category=Products" class="px-3 py-1.5 rounded-xl font-bold transition-colors <%= query.category === 'Products' ? 'bg-[#123524] text-white shadow-2xs' : 'bg-white text-gray-600 border border-gray-200 hover:bg-gray-50' %>">
            Products
          </a>
          <a href="/admin/media?category=Banners" class="px-3 py-1.5 rounded-xl font-bold transition-colors <%= query.category === 'Banners' ? 'bg-[#123524] text-white shadow-2xs' : 'bg-white text-gray-600 border border-gray-200 hover:bg-gray-50' %>">
            Banners
          </a>
          <a href="/admin/media?category=Avatars" class="px-3 py-1.5 rounded-xl font-bold transition-colors <%= query.category === 'Avatars' ? 'bg-[#123524] text-white shadow-2xs' : 'bg-white text-gray-600 border border-gray-200 hover:bg-gray-50' %>">
            Avatars
          </a>
        </div>

        <form action="/admin/media" method="GET" class="relative max-w-xs w-full">
          <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
          <input 
            type="text" 
            name="search" 
            value="<%= query.search || '' %>" 
            placeholder="Search assets..." 
            class="w-full pl-9 pr-4 py-1.5 text-xs bg-white rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 shadow-2xs"
          >
        </form>
      </div>

      <!-- Media Assets Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-5">
        <% media.forEach(item => { %>
          <div class="bg-white rounded-2xl border border-gray-200/80 p-4 shadow-xs flex flex-col justify-between space-y-3 group hover:border-emerald-300 transition-colors">
            <!-- Thumbnail Box -->
            <div class="h-36 rounded-xl bg-gray-50 border border-gray-100 flex items-center justify-center p-3 relative overflow-hidden">
              <img src="<%= item.path %>" alt="<%= item.name %>" class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-300">
              <span class="absolute top-2 left-2 text-[9px] font-bold uppercase tracking-wider bg-white/90 backdrop-blur px-2 py-0.5 rounded-md text-gray-700 shadow-2xs">
                <%= item.category %>
              </span>
            </div>

            <!-- Asset Info -->
            <div class="space-y-1">
              <h4 class="font-bold text-gray-900 text-xs truncate" title="<%= item.name %>"><%= item.name %></h4>
              <div class="flex items-center justify-between text-[10px] text-gray-400">
                <span class="truncate max-w-[130px] font-mono"><%= item.path %></span>
                <span><%= item.size || 'IMG' %></span>
              </div>
            </div>

            <!-- 1-Click Copy & View -->
            <div class="pt-2 border-t border-gray-100 flex items-center gap-2">
              <button 
                type="button" 
                onclick="copyPath('<%= item.path %>', this)"
                class="flex-1 py-1.5 px-2.5 bg-emerald-50 hover:bg-emerald-100 text-emerald-800 rounded-lg text-xs font-bold transition-colors flex items-center justify-center gap-1.5"
              >
                <i class="fa-regular fa-copy text-xs"></i>
                <span>Copy URL</span>
              </button>
              <a 
                href="<%= item.path %>" 
                target="_blank" 
                class="p-1.5 border border-gray-200 hover:bg-gray-50 text-gray-500 rounded-lg text-xs" 
                title="Open in new tab"
              >
                <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
              </a>
            </div>
          </div>
        <% }) %>
      </div>

    </main>
  </div>

  <!-- Add Media Modal -->
  <div id="addMediaModal" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl space-y-4">
      <div class="flex items-center justify-between border-b border-gray-100 pb-3">
        <h3 class="font-heading font-bold text-base text-[#123524]">Add Media Resource</h3>
        <button onclick="document.getElementById('addMediaModal').classList.add('hidden')" class="text-gray-400 hover:text-gray-600 text-lg">&times;</button>
      </div>

      <form action="/admin/media/new" method="POST" class="space-y-3 text-xs">
        <div>
          <label class="block font-bold text-gray-700 mb-1">Asset Display Name</label>
          <input type="text" name="name" required placeholder="e.g. Summer Promo Shoes" class="w-full px-3 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none">
        </div>

        <div>
          <label class="block font-bold text-gray-700 mb-1">Image URL / Local Path</label>
          <input type="text" name="path" required placeholder="e.g. /images/products/new-item.png or https://..." class="w-full px-3 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none font-mono">
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block font-bold text-gray-700 mb-1">Asset Category</label>
            <select name="category" class="w-full px-3 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none">
              <option value="Products">Products</option>
              <option value="Banners">Banners</option>
              <option value="Avatars">Avatars</option>
              <option value="Branding">Branding</option>
              <option value="Custom Uploads">Custom Uploads</option>
            </select>
          </div>

          <div>
            <label class="block font-bold text-gray-700 mb-1">File Size / Label</label>
            <input type="text" name="size" placeholder="e.g. 120 KB" class="w-full px-3 py-2 border border-gray-200 rounded-xl">
          </div>
        </div>

        <div class="pt-3 flex items-center justify-end gap-2 border-t border-gray-100">
          <button type="button" onclick="document.getElementById('addMediaModal').classList.add('hidden')" class="px-4 py-2 rounded-xl text-gray-600 hover:bg-gray-100 font-semibold">Cancel</button>
          <button type="submit" class="px-4 py-2 rounded-xl bg-[#123524] text-white font-bold hover:bg-[#1a4b33] shadow-xs">Register Asset</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Clipboard JS -->
  <script>
    function copyPath(path, btn) {
      navigator.clipboard.writeText(path).then(() => {
        const original = btn.innerHTML;
        btn.innerHTML = '<i class="fa-solid fa-check text-xs"></i><span>Copied!</span>';
        btn.classList.remove('bg-emerald-50', 'text-emerald-800');
        btn.classList.add('bg-emerald-600', 'text-white');
        setTimeout(() => {
          btn.innerHTML = original;
          btn.classList.remove('bg-emerald-600', 'text-white');
          btn.classList.add('bg-emerald-50', 'text-emerald-800');
        }, 1800);
      });
    }
  </script>

</body>
</html>
