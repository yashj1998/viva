<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Customer Inquiries — ViVA Admin' %></title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { font-family: 'Inter', sans-serif; }
    .font-heading { font-family: 'Poppins', sans-serif; }
  </style>
</head>
<body class="bg-[#fafaf9] text-[#16261d] min-h-screen flex">
  
  <%- include('sidebar') %>

  <!-- Main Content Area -->
  <div class="flex-1 flex flex-col min-w-0">
    <%- include('topbar') %>

    <main class="p-6 sm:p-8 space-y-6 flex-1 overflow-y-auto">
      
      <!-- Feedback Message -->
      <% if (message) { %>
        <div class="p-4 rounded-xl text-xs font-semibold flex items-center justify-between shadow-xs bg-emerald-50 text-emerald-800 border border-emerald-200">
          <div class="flex items-center gap-2">
            <i class="fa-solid fa-circle-check text-emerald-600"></i>
            <span><%= message %></span>
          </div>
          <button onclick="this.parentElement.remove()" class="text-emerald-700 hover:text-emerald-900">&times;</button>
        </div>
      <% } %>

      <!-- Header & Stats -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h2 class="font-heading font-bold text-xl text-[#123524]">Customer Messages &amp; Inquiries</h2>
          <p class="text-xs text-gray-500 mt-0.5">Manage customer inquiries, order tracking questions, and support requests.</p>
        </div>
      </div>

      <!-- Quick Status Filter Strip -->
      <div class="flex items-center gap-2 flex-wrap text-xs">
        <a href="/admin/inquiries?status=all" class="px-3 py-1.5 rounded-xl font-bold transition-colors <%= (!query.status || query.status === 'all') ? 'bg-[#123524] text-white shadow-2xs' : 'bg-white text-gray-600 border border-gray-200 hover:bg-gray-50' %>">
          All Inquiries (<%= stats.total %>)
        </a>
        <a href="/admin/inquiries?status=New" class="px-3 py-1.5 rounded-xl font-bold transition-colors <%= query.status === 'New' ? 'bg-rose-600 text-white shadow-2xs' : 'bg-white text-rose-700 border border-rose-200 hover:bg-rose-50' %>">
          New Unread (<%= stats.newCount %>)
        </a>
        <a href="/admin/inquiries?status=In Progress" class="px-3 py-1.5 rounded-xl font-bold transition-colors <%= query.status === 'In Progress' ? 'bg-amber-600 text-white shadow-2xs' : 'bg-white text-amber-700 border border-amber-200 hover:bg-amber-50' %>">
          In Progress (<%= stats.inProgressCount %>)
        </a>
        <a href="/admin/inquiries?status=Resolved" class="px-3 py-1.5 rounded-xl font-bold transition-colors <%= query.status === 'Resolved' ? 'bg-emerald-700 text-white shadow-2xs' : 'bg-white text-emerald-800 border border-emerald-200 hover:bg-emerald-50' %>">
          Resolved (<%= stats.resolvedCount %>)
        </a>
      </div>

      <!-- Search Bar -->
      <form action="/admin/inquiries" method="GET" class="bg-white p-3 rounded-2xl border border-gray-200/80 shadow-xs flex items-center gap-3">
        <div class="relative flex-1">
          <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
          <input 
            type="text" 
            name="search" 
            value="<%= query.search || '' %>" 
            placeholder="Search customer name, email, or message subject..." 
            class="w-full pl-9 pr-4 py-1.5 text-xs rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-emerald-500"
          >
        </div>
        <button type="submit" class="px-4 py-1.5 bg-[#123524] text-white text-xs font-bold rounded-xl hover:bg-[#1a4b33] transition-colors">
          Filter
        </button>
        <% if (query.search || (query.status && query.status !== 'all')) { %>
          <a href="/admin/inquiries" class="px-3 py-1.5 text-xs text-gray-500 hover:text-gray-800 font-semibold">Reset</a>
        <% } %>
      </form>

      <!-- Inquiries Table -->
      <div class="bg-white rounded-2xl border border-gray-200/80 overflow-hidden shadow-xs">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-xs">
            <thead>
              <tr class="bg-gray-50/70 border-b border-gray-200 text-gray-400 uppercase font-bold text-[10px] tracking-wider">
                <th class="py-3 px-5">Customer</th>
                <th class="py-3 px-5">Subject &amp; Message</th>
                <th class="py-3 px-5">Date Received</th>
                <th class="py-3 px-5">Status</th>
                <th class="py-3 px-5 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% if (inquiries && inquiries.length > 0) { %>
                <% inquiries.forEach(inq => { %>
                  <tr class="hover:bg-gray-50/60 transition-colors">
                    <td class="py-4 px-5">
                      <div class="font-bold text-gray-900"><%= inq.name %></div>
                      <a href="mailto:<%= inq.email %>" class="text-[11px] text-emerald-700 hover:underline block"><%= inq.email %></a>
                      <% if (inq.phone) { %>
                        <div class="text-[10px] text-gray-400"><%= inq.phone %></div>
                      <% } %>
                    </td>

                    <td class="py-4 px-5 max-w-sm">
                      <div class="font-bold text-gray-900 mb-0.5"><%= inq.subject %></div>
                      <p class="text-gray-500 line-clamp-2 text-[11px] leading-relaxed"><%= inq.message %></p>
                      <% if (inq.adminNotes) { %>
                        <div class="mt-1 text-[10px] text-amber-800 bg-amber-50 px-2 py-0.5 rounded border border-amber-200/60 inline-block font-medium">
                          Note: <%= inq.adminNotes %>
                        </div>
                      <% } %>
                    </td>

                    <td class="py-4 px-5 text-gray-500 whitespace-nowrap">
                      <div><%= inq.createdAt ? new Date(inq.createdAt).toLocaleDateString() : 'Recent' %></div>
                      <div class="text-[10px] text-gray-400"><%= inq.createdAt ? new Date(inq.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : '' %></div>
                    </td>

                    <td class="py-4 px-5 whitespace-nowrap">
                      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider <%= inq.status === 'New' ? 'bg-rose-100 text-rose-800' : (inq.status === 'In Progress' ? 'bg-amber-100 text-amber-800' : 'bg-emerald-100 text-emerald-800') %>">
                        <span class="w-1.5 h-1.5 rounded-full <%= inq.status === 'New' ? 'bg-rose-600' : (inq.status === 'In Progress' ? 'bg-amber-600' : 'bg-emerald-600') %>"></span>
                        <span><%= inq.status %></span>
                      </span>
                    </td>

                    <td class="py-4 px-5 text-right whitespace-nowrap space-x-1">
                      <button 
                        type="button"
                        onclick="openInquiryModal('<%= inq._id %>', '<%= inq.name %>', '<%= inq.email %>', '<%= inq.phone || '' %>', '<%= inq.subject.replace(/'/g, '\\\'') %>', '<%= inq.message.replace(/'/g, '\\\'').replace(/\n/g, ' ') %>', '<%= inq.status %>', '<%= (inq.adminNotes || '').replace(/'/g, '\\\'') %>')"
                        class="px-2.5 py-1.5 bg-emerald-50 text-emerald-800 hover:bg-emerald-100 rounded-lg font-bold text-xs transition-colors"
                      >
                        View &amp; Update
                      </button>

                      <form action="/admin/inquiries/delete/<%= inq._id %>" method="POST" onsubmit="return confirm('Delete this inquiry?')" class="inline">
                        <button type="submit" class="p-1.5 text-gray-400 hover:text-rose-600 rounded-lg hover:bg-rose-50 transition-colors">
                          <i class="fa-regular fa-trash-can text-xs"></i>
                        </button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="5" class="py-12 text-center text-gray-400">
                    <i class="fa-regular fa-envelope-open text-2xl mb-2 block text-gray-300"></i>
                    No customer inquiries found matching your filters.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

    </main>
  </div>

  <!-- Inquiry Details & Update Modal -->
  <div id="inquiryModal" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-xl space-y-4">
      <div class="flex items-center justify-between border-b border-gray-100 pb-3">
        <h3 class="font-heading font-bold text-base text-[#123524]">Inquiry Details</h3>
        <button onclick="document.getElementById('inquiryModal').classList.add('hidden')" class="text-gray-400 hover:text-gray-600 text-lg">&times;</button>
      </div>

      <div class="space-y-3 text-xs">
        <div class="bg-gray-50 p-3.5 rounded-xl border border-gray-200/80 space-y-1.5">
          <div class="flex items-center justify-between">
            <span class="font-bold text-gray-900" id="modalCustomerName"></span>
            <div class="flex items-center gap-2">
              <a href="#" id="modalEmailLink" class="text-emerald-700 font-bold hover:underline flex items-center gap-1">
                <i class="fa-regular fa-envelope"></i> Email Customer
              </a>
            </div>
          </div>
          <div class="text-[11px] text-gray-500" id="modalCustomerPhone"></div>
        </div>

        <div>
          <div class="font-bold text-gray-800 text-sm mb-1" id="modalSubject"></div>
          <div class="p-3 bg-[#fafaf9] rounded-xl border border-gray-200 text-gray-700 leading-relaxed max-h-48 overflow-y-auto" id="modalMessage"></div>
        </div>

        <form id="inquiryStatusForm" method="POST" class="space-y-3 pt-2 border-t border-gray-100">
          <div>
            <label class="block font-bold text-gray-700 mb-1">Ticket Status</label>
            <select name="status" id="modalStatusSelect" class="w-full px-3 py-2 border border-gray-200 rounded-xl font-semibold">
              <option value="New">New (Unresolved)</option>
              <option value="In Progress">In Progress (Follow-up Needed)</option>
              <option value="Resolved">Resolved (Completed)</option>
            </select>
          </div>

          <div>
            <label class="block font-bold text-gray-700 mb-1">Internal Admin Notes</label>
            <textarea name="adminNotes" id="modalAdminNotes" rows="2" placeholder="Document staff actions, tracking codes, or responses provided..." class="w-full px-3 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none"></textarea>
          </div>

          <div class="pt-2 flex items-center justify-end gap-2">
            <button type="button" onclick="document.getElementById('inquiryModal').classList.add('hidden')" class="px-4 py-2 rounded-xl text-gray-600 hover:bg-gray-100 font-semibold">Close</button>
            <button type="submit" class="px-4 py-2 rounded-xl bg-[#123524] text-white font-bold hover:bg-[#1a4b33] shadow-xs">Save Status</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    function openInquiryModal(id, name, email, phone, subject, message, status, adminNotes) {
      document.getElementById('modalCustomerName').innerText = name;
      document.getElementById('modalCustomerPhone').innerText = phone ? 'Phone: ' + phone : 'No phone provided';
      document.getElementById('modalEmailLink').href = 'mailto:' + email + '?subject=' + encodeURIComponent('Re: ' + subject);
      document.getElementById('modalSubject').innerText = subject;
      document.getElementById('modalMessage').innerText = message;
      document.getElementById('modalStatusSelect').value = status;
      document.getElementById('modalAdminNotes').value = adminNotes || '';
      document.getElementById('inquiryStatusForm').action = '/admin/inquiries/status/' + id;
      document.getElementById('inquiryModal').classList.remove('hidden');
    }
  </script>

</body>
</html>
