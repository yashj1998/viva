<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Orders & Fulfillment — ViVA Admin' %></title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { font-family: 'Inter', sans-serif; }
    .font-heading { font-family: 'Poppins', sans-serif; }
  </style>
</head>
<body class="bg-[#fafaf9] text-[#16261d] min-h-screen flex">
  
  <%- include('sidebar') %>

  <!-- Main Content Area -->
  <div class="flex-1 flex flex-col min-w-0">
    <%- include('topbar') %>

    <main class="p-6 sm:p-8 space-y-6 flex-1 overflow-y-auto">
      
      <!-- Notifications -->
      <% if (message) { %>
        <div class="p-4 rounded-xl text-xs font-semibold flex items-center justify-between shadow-xs bg-emerald-50 text-emerald-800 border border-emerald-200">
          <div class="flex items-center gap-2">
            <i class="fa-solid fa-circle-check text-emerald-600"></i>
            <span><%= message %></span>
          </div>
          <button onclick="this.parentElement.remove()" class="text-emerald-700 hover:text-emerald-900 font-bold">&times;</button>
        </div>
      <% } %>

      <!-- Top Stats Strip -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="bg-white p-4 rounded-2xl border border-gray-200/80 shadow-xs">
          <span class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">Gross Orders</span>
          <div class="text-2xl font-bold font-heading text-[#123524] mt-1"><%= stats.totalOrders %></div>
          <p class="text-[10px] text-emerald-600 font-semibold mt-0.5">$<%= stats.totalRevenue %> total sales</p>
        </div>
        <div class="bg-white p-4 rounded-2xl border border-gray-200/80 shadow-xs">
          <span class="text-[10px] font-bold text-amber-600 uppercase tracking-wider">Pending Action</span>
          <div class="text-2xl font-bold font-heading text-amber-700 mt-1"><%= stats.pendingCount %></div>
          <p class="text-[10px] text-gray-400 mt-0.5">Ordered or Processing</p>
        </div>
        <div class="bg-white p-4 rounded-2xl border border-gray-200/80 shadow-xs">
          <span class="text-[10px] font-bold text-blue-600 uppercase tracking-wider">Dispatched / In Transit</span>
          <div class="text-2xl font-bold font-heading text-blue-700 mt-1"><%= stats.shippedCount %></div>
          <p class="text-[10px] text-gray-400 mt-0.5">With shipping carrier</p>
        </div>
        <div class="bg-white p-4 rounded-2xl border border-gray-200/80 shadow-xs">
          <span class="text-[10px] font-bold text-emerald-600 uppercase tracking-wider">Delivered</span>
          <div class="text-2xl font-bold font-heading text-emerald-700 mt-1"><%= stats.deliveredCount %></div>
          <p class="text-[10px] text-gray-400 mt-0.5">Completed fulfillments</p>
        </div>
      </div>

      <!-- Filters & Search Toolbar -->
      <div class="space-y-3">
        <!-- Status Filter Pills -->
        <div class="flex items-center gap-1.5 flex-wrap text-xs">
          <a href="/admin/orders?status=all&paymentStatus=<%= query.paymentStatus || 'all' %>&shippingStatus=<%= query.shippingStatus || 'all' %>" class="px-3 py-1.5 rounded-xl font-bold transition-colors <%= (!query.status || query.status === 'all') ? 'bg-[#123524] text-white shadow-2xs' : 'bg-white text-gray-600 border border-gray-200 hover:bg-gray-50' %>">
            All Orders
          </a>
          <a href="/admin/orders?status=Ordered&paymentStatus=<%= query.paymentStatus || 'all' %>&shippingStatus=<%= query.shippingStatus || 'all' %>" class="px-3 py-1.5 rounded-xl font-bold transition-colors <%= query.status === 'Ordered' ? 'bg-amber-600 text-white shadow-2xs' : 'bg-white text-amber-700 border border-amber-200 hover:bg-amber-50' %>">
            Ordered (New)
          </a>
          <a href="/admin/orders?status=Processing&paymentStatus=<%= query.paymentStatus || 'all' %>&shippingStatus=<%= query.shippingStatus || 'all' %>" class="px-3 py-1.5 rounded-xl font-bold transition-colors <%= query.status === 'Processing' ? 'bg-blue-600 text-white shadow-2xs' : 'bg-white text-blue-700 border border-blue-200 hover:bg-blue-50' %>">
            Processing
          </a>
          <a href="/admin/orders?status=Shipped&paymentStatus=<%= query.paymentStatus || 'all' %>&shippingStatus=<%= query.shippingStatus || 'all' %>" class="px-3 py-1.5 rounded-xl font-bold transition-colors <%= query.status === 'Shipped' ? 'bg-indigo-600 text-white shadow-2xs' : 'bg-white text-indigo-700 border border-indigo-200 hover:bg-indigo-50' %>">
            Shipped
          </a>
          <a href="/admin/orders?status=Delivered&paymentStatus=<%= query.paymentStatus || 'all' %>&shippingStatus=<%= query.shippingStatus || 'all' %>" class="px-3 py-1.5 rounded-xl font-bold transition-colors <%= query.status === 'Delivered' ? 'bg-emerald-700 text-white shadow-2xs' : 'bg-white text-emerald-800 border border-emerald-200 hover:bg-emerald-50' %>">
            Delivered
          </a>
          <a href="/admin/orders?status=Cancelled&paymentStatus=<%= query.paymentStatus || 'all' %>&shippingStatus=<%= query.shippingStatus || 'all' %>" class="px-3 py-1.5 rounded-xl font-bold transition-colors <%= query.status === 'Cancelled' ? 'bg-rose-700 text-white shadow-2xs' : 'bg-white text-rose-700 border border-rose-200 hover:bg-rose-50' %>">
            Cancelled
          </a>
        </div>

        <!-- Search & Filter Bar -->
        <form action="/admin/orders" method="GET" class="bg-white p-3 rounded-2xl border border-gray-200/80 shadow-xs flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
          <input type="hidden" name="status" value="<%= query.status || 'all' %>">
          
          <div class="relative flex-1">
            <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
            <input 
              type="text" 
              name="search" 
              value="<%= query.search || '' %>" 
              placeholder="Search by order # (e.g. VIVA-9824), customer name, email, phone, or tracking #..." 
              class="w-full pl-9 pr-4 py-1.5 text-xs rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-emerald-500"
            >
          </div>

          <div class="flex items-center gap-2 flex-wrap">
            <% if (!isSeller && sellers && sellers.length > 0) { %>
              <!-- Seller Store Filter -->
              <select name="sellerId" onchange="this.form.submit()" class="text-xs px-3 py-1.5 border border-amber-300 rounded-xl bg-amber-50/60 focus:outline-none font-semibold text-amber-900">
                <option value="">All Sellers &amp; Stores</option>
                <% sellers.forEach(s => { %>
                  <option value="<%= s._id %>" <%= (selectedSellerId == s._id.toString() || query.sellerId == s._id.toString()) ? 'selected' : '' %>>
                    <%= s.storeName || s.name %>
                  </option>
                <% }) %>
              </select>
            <% } %>

            <!-- Payment Status Filter -->
            <select name="paymentStatus" onchange="this.form.submit()" class="text-xs px-3 py-1.5 border border-gray-200 rounded-xl bg-white focus:outline-none font-medium text-gray-700">
              <option value="all">All Payments</option>
              <option value="Paid" <%= query.paymentStatus === 'Paid' ? 'selected' : '' %>>Paid</option>
              <option value="Pending" <%= query.paymentStatus === 'Pending' ? 'selected' : '' %>>Pending Payment</option>
              <option value="Refunded" <%= query.paymentStatus === 'Refunded' ? 'selected' : '' %>>Refunded</option>
            </select>

            <!-- Shipping Status Filter -->
            <select name="shippingStatus" onchange="this.form.submit()" class="text-xs px-3 py-1.5 border border-gray-200 rounded-xl bg-white focus:outline-none font-medium text-gray-700">
              <option value="all">All Shipping</option>
              <option value="Unfulfilled" <%= query.shippingStatus === 'Unfulfilled' ? 'selected' : '' %>>Unfulfilled</option>
              <option value="In Transit" <%= query.shippingStatus === 'In Transit' ? 'selected' : '' %>>In Transit</option>
              <option value="Delivered" <%= query.shippingStatus === 'Delivered' ? 'selected' : '' %>>Delivered</option>
            </select>

            <!-- Sort -->
            <select name="sort" onchange="this.form.submit()" class="text-xs px-3 py-1.5 border border-gray-200 rounded-xl bg-white focus:outline-none font-medium text-gray-700">
              <option value="newest" <%= (!query.sort || query.sort === 'newest') ? 'selected' : '' %>>Sort: Newest First</option>
              <option value="total-desc" <%= query.sort === 'total-desc' ? 'selected' : '' %>>Amount: High to Low</option>
              <option value="total-asc" <%= query.sort === 'total-asc' ? 'selected' : '' %>>Amount: Low to High</option>
              <option value="oldest" <%= query.sort === 'oldest' ? 'selected' : '' %>>Oldest First</option>
            </select>

            <button type="submit" class="px-4 py-1.5 bg-[#123524] text-white text-xs font-bold rounded-xl hover:bg-[#1a4b33] transition-colors">
              Filter
            </button>
            <% if (query.search || (query.status && query.status !== 'all') || (query.paymentStatus && query.paymentStatus !== 'all') || (query.shippingStatus && query.shippingStatus !== 'all') || query.sellerId || query.sort) { %>
              <a href="/admin/orders" class="px-3 py-1.5 text-xs text-gray-500 hover:text-gray-800 font-semibold">Reset</a>
            <% } %>
          </div>
        </form>
      </div>

      <!-- Bulk Actions Bar -->
      <form id="bulkOrdersForm" action="/admin/orders/bulk" method="POST">
        <div class="bg-white rounded-2xl border border-gray-200/80 overflow-hidden shadow-xs">
          
          <!-- Table Header / Bulk Strip -->
          <div class="p-4 border-b border-gray-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-gray-50/50">
            <div class="flex items-center gap-3">
              <label class="inline-flex items-center gap-2 cursor-pointer font-bold text-xs text-gray-700">
                <input type="checkbox" id="selectAllOrders" onchange="toggleSelectAllOrders(this)" class="rounded text-emerald-600">
                <span>Select All</span>
              </label>
              <span id="selectedCount" class="text-[11px] text-gray-400 font-medium">0 orders selected</span>
            </div>

            <div class="flex items-center gap-2">
              <span class="text-xs text-gray-500 font-medium">Bulk Status:</span>
              <select name="status" class="text-xs px-2.5 py-1 border border-gray-200 rounded-lg bg-white font-semibold">
                <option value="Processing">Mark as Processing</option>
                <option value="Shipped">Mark as Shipped</option>
                <option value="Delivered">Mark as Delivered</option>
                <option value="Cancelled">Mark as Cancelled</option>
              </select>
              <button type="submit" onclick="return confirm('Apply this status to all selected orders?')" class="px-3 py-1 bg-[#123524] hover:bg-[#1a4b33] text-white text-xs font-bold rounded-lg transition-colors">
                Apply
              </button>
            </div>
          </div>

          <!-- Orders Table -->
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead>
                <tr class="text-gray-400 uppercase tracking-wider text-[10px] border-b border-gray-100 bg-gray-50/70">
                  <th class="py-3 px-4 w-10"></th>
                  <th class="py-3 px-4">Order #</th>
                  <th class="py-3 px-4">Customer</th>
                  <th class="py-3 px-4">Items Summary</th>
                  <th class="py-3 px-4">Total</th>
                  <th class="py-3 px-4">Payment</th>
                  <th class="py-3 px-4">Shipping</th>
                  <th class="py-3 px-4">Date</th>
                  <th class="py-3 px-4">Status</th>
                  <th class="py-3 px-4 text-right">Action</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                <% if (orders && orders.length > 0) { %>
                  <% orders.forEach(order => { %>
                    <tr class="hover:bg-gray-50/70 transition-colors">
                      <!-- Checkbox -->
                      <td class="py-4 px-4">
                        <input type="checkbox" name="orderNumbers" value="<%= order.orderNumber %>" onchange="updateSelectedOrdersCount()" class="order-checkbox rounded text-emerald-600">
                      </td>

                      <!-- Order Number -->
                      <td class="py-4 px-4">
                        <button 
                          type="button" 
                          onclick="viewOrderDetail('<%= order.orderNumber %>')" 
                          class="font-mono font-bold text-[#123524] bg-emerald-50 hover:bg-emerald-100 px-2 py-1 rounded-md text-xs transition-colors flex items-center gap-1"
                        >
                          <span>#<%= order.orderNumber %></span>
                          <i class="fa-solid fa-arrow-up-right-from-square text-[9px] text-emerald-700"></i>
                        </button>
                      </td>

                      <!-- Customer Info -->
                      <td class="py-4 px-4">
                        <div class="font-bold text-gray-900"><%= (order.customer && order.customer.name) || 'Customer' %></div>
                        <div class="text-[10px] text-gray-400"><%= (order.customer && order.customer.email) || 'N/A' %></div>
                        <% if (order.customer && order.customer.city) { %>
                          <div class="text-[10px] text-gray-400"><%= order.customer.city %>, <%= order.customer.country || 'US' %></div>
                        <% } %>
                      </td>

                      <!-- Items Summary -->
                      <td class="py-4 px-4 max-w-xs">
                        <% if (order.items && order.items.length > 0) { %>
                          <div class="flex items-center gap-2">
                            <% if (order.items[0].image) { %>
                              <img src="<%= order.items[0].image %>" alt="Product" class="w-8 h-8 object-contain rounded border border-gray-100 bg-white shrink-0">
                            <% } %>
                            <div>
                              <div class="text-gray-800 font-medium truncate max-w-[150px]">
                                <%= order.items[0].name %>
                              </div>
                              <div class="text-[10px] text-gray-400 flex items-center gap-1.5 flex-wrap mt-0.5">
                                <span><%= order.items.reduce((sum, item) => sum + (item.quantity || 1), 0) %> total units <%= order.items.length > 1 ? `(${order.items.length} products)` : '' %></span>
                                <% if (!isSeller) { %>
                                  <% const uniqueSellers = [...new Set(order.items.map(i => i.sellerName).filter(Boolean))]; %>
                                  <% if (uniqueSellers.length > 0) { %>
                                    <span class="bg-amber-50 text-amber-900 border border-amber-200 px-1.5 py-0.2 rounded text-[9px] font-semibold flex items-center gap-1">
                                      <i class="fa-solid fa-store text-[8px] text-amber-700"></i> <%= uniqueSellers.join(', ') %>
                                    </span>
                                  <% } %>
                                <% } %>
                              </div>
                            </div>
                          </div>
                        <% } else { %>
                          <span class="text-gray-400">No item details</span>
                        <% } %>
                      </td>

                      <!-- Total -->
                      <td class="py-4 px-4 whitespace-nowrap">
                        <span class="font-bold text-gray-900 text-sm">$<%= (order.total || 0).toFixed(2) %></span>
                      </td>

                      <!-- Payment Status -->
                      <td class="py-4 px-4 whitespace-nowrap">
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold <%= order.paymentStatus === 'Paid' ? 'bg-emerald-100 text-emerald-800' : (order.paymentStatus === 'Refunded' ? 'bg-purple-100 text-purple-800' : 'bg-amber-100 text-amber-800') %>">
                          <i class="fa-solid fa-circle text-[6px]"></i>
                          <span><%= order.paymentStatus || 'Paid' %></span>
                        </span>
                        <div class="text-[9px] text-gray-400 mt-0.5"><%= order.paymentMethod || 'Credit Card' %></div>
                      </td>

                      <!-- Shipping Status -->
                      <td class="py-4 px-4 whitespace-nowrap">
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold <%= order.shippingStatus === 'Delivered' ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' : (order.shippingStatus === 'In Transit' ? 'bg-blue-50 text-blue-800 border border-blue-200' : 'bg-amber-50 text-amber-800 border border-amber-200') %>">
                          <i class="fa-solid fa-truck text-[8px]"></i>
                          <span><%= order.shippingStatus || 'Unfulfilled' %></span>
                        </span>
                        <% if (order.trackingNumber) { %>
                          <div class="text-[9px] text-gray-400 font-mono mt-0.5"><%= order.trackingNumber %></div>
                        <% } %>
                      </td>

                      <!-- Date -->
                      <td class="py-4 px-4 whitespace-nowrap text-gray-500 text-[11px]">
                        <div><%= new Date(order.createdAt).toLocaleDateString() %></div>
                        <div class="text-[10px] text-gray-400"><%= new Date(order.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></div>
                      </td>

                      <!-- Order Status Badge -->
                      <td class="py-4 px-4 whitespace-nowrap">
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider <%= order.status === 'Delivered' ? 'bg-emerald-100 text-emerald-800' : (order.status === 'Shipped' ? 'bg-indigo-100 text-indigo-800' : (order.status === 'Processing' ? 'bg-blue-100 text-blue-800' : (order.status === 'Cancelled' ? 'bg-rose-100 text-rose-800' : 'bg-amber-100 text-amber-800'))) %>">
                          <span class="w-1.5 h-1.5 rounded-full <%= order.status === 'Delivered' ? 'bg-emerald-600' : (order.status === 'Shipped' ? 'bg-indigo-600' : (order.status === 'Processing' ? 'bg-blue-600' : (order.status === 'Cancelled' ? 'bg-rose-600' : 'bg-amber-600'))) %>"></span>
                          <span><%= order.status %></span>
                        </span>
                      </td>

                      <!-- Action Button -->
                      <td class="py-4 px-4 text-right whitespace-nowrap">
                        <button 
                          type="button" 
                          onclick="viewOrderDetail('<%= order.orderNumber %>')" 
                          class="px-3 py-1.5 bg-[#123524] hover:bg-[#1a4b33] text-white rounded-lg text-xs font-bold transition-colors shadow-2xs"
                        >
                          Fulfillment
                        </button>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="10" class="py-12 text-center text-gray-400">
                      <i class="fa-solid fa-receipt text-2xl mb-2 block text-gray-300"></i>
                      No orders found matching your search or filters.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>

          <!-- Pagination Controls -->
          <% if (pagination && pagination.totalPages > 1) { %>
            <div class="p-4 border-t border-gray-100 flex items-center justify-between text-xs bg-gray-50/50">
              <span class="text-gray-500 font-medium">
                Showing page <%= pagination.page %> of <%= pagination.totalPages %> (<%= pagination.totalOrders %> total orders)
              </span>
              <div class="flex items-center gap-1.5">
                <% if (pagination.hasPrevPage) { %>
                  <a href="/admin/orders?page=<%= pagination.page - 1 %>&status=<%= query.status || 'all' %>&paymentStatus=<%= query.paymentStatus || 'all' %>&shippingStatus=<%= query.shippingStatus || 'all' %>&search=<%= query.search || '' %>&sellerId=<%= query.sellerId || '' %>&sort=<%= query.sort || 'newest' %>" class="px-3 py-1.5 rounded-lg border border-gray-200 bg-white hover:bg-gray-50 font-bold text-gray-700">
                    &larr; Prev
                  </a>
                <% } %>
                <% for(let p = 1; p <= pagination.totalPages; p++) { %>
                  <a href="/admin/orders?page=<%= p %>&status=<%= query.status || 'all' %>&paymentStatus=<%= query.paymentStatus || 'all' %>&shippingStatus=<%= query.shippingStatus || 'all' %>&search=<%= query.search || '' %>&sellerId=<%= query.sellerId || '' %>&sort=<%= query.sort || 'newest' %>" class="px-3 py-1.5 rounded-lg font-bold transition-colors <%= p === pagination.page ? 'bg-[#123524] text-white' : 'border border-gray-200 bg-white text-gray-700 hover:bg-gray-50' %>">
                    <%= p %>
                  </a>
                <% } %>
                <% if (pagination.hasNextPage) { %>
                  <a href="/admin/orders?page=<%= pagination.page + 1 %>&status=<%= query.status || 'all' %>&paymentStatus=<%= query.paymentStatus || 'all' %>&shippingStatus=<%= query.shippingStatus || 'all' %>&search=<%= query.search || '' %>&sellerId=<%= query.sellerId || '' %>&sort=<%= query.sort || 'newest' %>" class="px-3 py-1.5 rounded-lg border border-gray-200 bg-white hover:bg-gray-50 font-bold text-gray-700">
                    Next &rarr;
                  </a>
                <% } %>
              </div>
            </div>
          <% } %>
        </div>
      </form>

    </main>
  </div>

  <!-- Comprehensive Order Detail & Fulfillment Modal with Status Timeline -->
  <div id="orderDetailModal" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-white rounded-2xl max-w-2xl w-full p-6 shadow-xl space-y-4 max-h-[90vh] overflow-y-auto">
      
      <!-- Modal Header -->
      <div class="flex items-center justify-between border-b border-gray-100 pb-3">
        <div>
          <div class="flex items-center gap-2">
            <h3 class="font-heading font-bold text-lg text-[#123524]" id="modalOrderNumber">Order Details</h3>
            <span class="text-[10px] font-bold px-2 py-0.5 rounded-full" id="modalOrderStatusBadge"></span>
          </div>
          <span class="text-[11px] text-gray-400" id="modalOrderDate"></span>
        </div>
        <button onclick="document.getElementById('orderDetailModal').classList.add('hidden')" class="text-gray-400 hover:text-gray-600 text-xl font-bold">&times;</button>
      </div>

      <!-- Customer & Shipping Box -->
      <div class="bg-gray-50 p-4 rounded-xl border border-gray-200/80 space-y-2 text-xs">
        <div class="flex items-center justify-between border-b border-gray-200/60 pb-2">
          <span class="font-bold text-gray-900" id="modalCustomerName"></span>
          <span class="text-emerald-700 font-bold" id="modalPaymentSummary"></span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-gray-600">
          <div><span class="text-gray-400">Email:</span> <span id="modalCustomerEmail" class="font-medium"></span></div>
          <div><span class="text-gray-400">Phone:</span> <span id="modalCustomerPhone" class="font-medium"></span></div>
          <div class="sm:col-span-2"><span class="text-gray-400">Shipping Address:</span> <span id="modalCustomerAddress" class="font-medium text-gray-800"></span></div>
        </div>
      </div>

      <!-- Itemized Products List -->
      <div class="space-y-2">
        <span class="font-bold text-gray-700 text-xs uppercase tracking-wider">Ordered Products</span>
        <div id="modalItemsContainer" class="max-h-48 overflow-y-auto divide-y divide-gray-100 border border-gray-100 rounded-xl p-2 text-xs"></div>
      </div>

      <!-- Financial Breakdown -->
      <div class="bg-gray-50/50 p-3 rounded-xl border border-gray-100 space-y-1 text-xs">
        <div class="flex items-center justify-between text-gray-500">
          <span>Items Subtotal:</span>
          <span class="font-semibold text-gray-800" id="modalSubtotal"></span>
        </div>
        <div class="flex items-center justify-between text-gray-500">
          <span>Shipping Fee:</span>
          <span class="font-semibold text-gray-800" id="modalShippingFee"></span>
        </div>
        <div class="flex items-center justify-between text-gray-500">
          <span>Estimated Sales Tax:</span>
          <span class="font-semibold text-gray-800" id="modalTax"></span>
        </div>
        <div class="flex items-center justify-between text-gray-900 font-bold border-t border-gray-200/80 pt-1.5 text-sm">
          <span>Total Charged:</span>
          <span class="font-heading font-bold text-[#123524]" id="modalOrderTotal"></span>
        </div>
      </div>

      <!-- Order Timeline (statusHistory) -->
      <div class="space-y-2 border-t border-gray-100 pt-3">
        <span class="font-bold text-gray-700 text-xs uppercase tracking-wider flex items-center gap-1.5">
          <i class="fa-solid fa-clock-rotate-left text-emerald-700"></i> Order Status Timeline
        </span>
        <div id="modalTimelineContainer" class="space-y-2 max-h-36 overflow-y-auto p-2 bg-gray-50 rounded-xl text-xs"></div>
      </div>

      <!-- Fulfillment & Status Update Form -->
      <form action="/admin/orders/status" method="POST" class="pt-3 border-t border-gray-100 space-y-3 text-xs">
        <input type="hidden" name="orderNumber" id="modalFormOrderNumber">
        
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div>
            <label class="font-bold text-gray-700 block mb-1">Order Status:</label>
            <select name="status" id="modalStatusSelect" class="w-full px-2.5 py-1.5 border border-gray-200 rounded-xl font-semibold">
              <option value="Ordered">Ordered (New)</option>
              <option value="Processing">Processing</option>
              <option value="Shipped">Shipped</option>
              <option value="Delivered">Delivered</option>
              <option value="Cancelled">Cancelled</option>
            </select>
          </div>

          <div>
            <label class="font-bold text-gray-700 block mb-1">Payment Status:</label>
            <select name="paymentStatus" id="modalPaymentStatusSelect" class="w-full px-2.5 py-1.5 border border-gray-200 rounded-xl font-semibold">
              <option value="Paid">Paid</option>
              <option value="Pending">Pending Payment</option>
              <option value="Failed">Failed</option>
              <option value="Refunded">Refunded</option>
            </select>
          </div>

          <div>
            <label class="font-bold text-gray-700 block mb-1">Shipping Status:</label>
            <select name="shippingStatus" id="modalShippingStatusSelect" class="w-full px-2.5 py-1.5 border border-gray-200 rounded-xl font-semibold">
              <option value="Unfulfilled">Unfulfilled</option>
              <option value="Shipped">Shipped</option>
              <option value="In Transit">In Transit</option>
              <option value="Out for Delivery">Out for Delivery</option>
              <option value="Delivered">Delivered</option>
              <option value="Returned">Returned</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="font-bold text-gray-700 block mb-1">Carrier:</label>
            <input type="text" name="carrier" id="modalCarrierInput" placeholder="e.g. FedEx Ground" class="w-full px-3 py-1.5 border border-gray-200 rounded-xl">
          </div>
          <div>
            <label class="font-bold text-gray-700 block mb-1">Tracking Number:</label>
            <input type="text" name="trackingNumber" id="modalTrackingInput" placeholder="e.g. TRK-9824US" class="w-full px-3 py-1.5 border border-gray-200 rounded-xl font-mono">
          </div>
        </div>

        <div>
          <label class="font-bold text-gray-700 block mb-1">Timeline Audit Note:</label>
          <input type="text" name="note" placeholder="e.g. Dispatched package via FedEx Ground" class="w-full px-3 py-1.5 border border-gray-200 rounded-xl">
        </div>

        <div class="flex items-center justify-end gap-2 pt-2">
          <button type="button" onclick="document.getElementById('orderDetailModal').classList.add('hidden')" class="px-4 py-2 text-gray-600 hover:bg-gray-100 rounded-xl font-bold">
            Close
          </button>
          <button type="submit" class="px-5 py-2 bg-[#123524] hover:bg-[#1a4b33] text-white font-bold rounded-xl transition-colors shadow-xs">
            Save Fulfillment Status
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function toggleSelectAllOrders(master) {
      document.querySelectorAll('.order-checkbox').forEach(cb => cb.checked = master.checked);
      updateSelectedOrdersCount();
    }

    function updateSelectedOrdersCount() {
      const selected = document.querySelectorAll('.order-checkbox:checked').length;
      document.getElementById('selectedCount').innerText = `${selected} orders selected`;
    }

    async function viewOrderDetail(orderNumber) {
      try {
        const res = await fetch(`/admin/orders/detail/${orderNumber}`);
        const data = await res.json();
        if (data.success && data.order) {
          const o = data.order;
          document.getElementById('modalOrderNumber').innerText = `Order #${o.orderNumber}`;
          document.getElementById('modalOrderDate').innerText = `Placed on ${new Date(o.createdAt).toLocaleString()}`;
          
          const statusBadge = document.getElementById('modalOrderStatusBadge');
          statusBadge.innerText = o.status;
          statusBadge.className = `text-[10px] font-bold px-2 py-0.5 rounded-full ${o.status === 'Delivered' ? 'bg-emerald-100 text-emerald-800' : (o.status === 'Shipped' ? 'bg-indigo-100 text-indigo-800' : 'bg-amber-100 text-amber-800')}`;

          document.getElementById('modalCustomerName').innerText = (o.customer && o.customer.name) || 'Customer';
          document.getElementById('modalCustomerEmail').innerText = (o.customer && o.customer.email) || 'N/A';
          document.getElementById('modalCustomerPhone').innerText = (o.customer && o.customer.phone) || 'N/A';
          document.getElementById('modalCustomerAddress').innerText = (o.customer && (o.customer.address || o.customer.city)) ? `${o.customer.address || ''}, ${o.customer.city || ''}, ${o.customer.zip || ''}` : 'Standard Shipping';
          document.getElementById('modalPaymentSummary').innerText = `${o.paymentStatus || 'Paid'} via ${o.paymentMethod || 'Credit Card'}`;

          document.getElementById('modalSubtotal').innerText = `$${(o.subtotal || 0).toFixed(2)}`;
          document.getElementById('modalShippingFee').innerText = (o.shippingFee > 0) ? `$${o.shippingFee.toFixed(2)}` : 'FREE';
          document.getElementById('modalTax').innerText = `$${(o.tax || 0).toFixed(2)}`;
          document.getElementById('modalOrderTotal').innerText = `$${(o.total || 0).toFixed(2)}`;

          document.getElementById('modalFormOrderNumber').value = o.orderNumber;
          document.getElementById('modalStatusSelect').value = o.status;
          document.getElementById('modalPaymentStatusSelect').value = o.paymentStatus || 'Paid';
          document.getElementById('modalShippingStatusSelect').value = o.shippingStatus || 'Unfulfilled';
          document.getElementById('modalCarrierInput').value = o.carrier || 'FedEx Ground';
          document.getElementById('modalTrackingInput').value = o.trackingNumber || '';

          // Populate items list
          const container = document.getElementById('modalItemsContainer');
          container.innerHTML = '';
          (o.items || []).forEach(item => {
            const row = document.createElement('div');
            row.className = 'py-2 flex items-center justify-between gap-2';
            row.innerHTML = `
              <div class="flex items-center gap-2.5">
                <img src="${item.image || '/images/products/headphones.png'}" alt="${item.name}" class="w-8 h-8 rounded-md object-contain border border-gray-100 bg-white">
                <div>
                  <div class="font-bold text-gray-800">${item.name}</div>
                  <div class="text-[10px] text-gray-400">SKU: ${item.sku || 'N/A'} &bull; Qty: ${item.quantity || 1} &times; $${(item.price || 0).toFixed(2)}</div>
                </div>
              </div>
              <div class="font-bold text-gray-900">$${((item.price || 0) * (item.quantity || 1)).toFixed(2)}</div>
            `;
            container.appendChild(row);
          });

          // Populate timeline history
          const timelineContainer = document.getElementById('modalTimelineContainer');
          timelineContainer.innerHTML = '';
          if (o.statusHistory && o.statusHistory.length > 0) {
            o.statusHistory.forEach(h => {
              const item = document.createElement('div');
              item.className = 'flex items-start gap-2 py-1 border-b border-gray-100 last:border-0';
              item.innerHTML = `
                <div class="w-2 h-2 rounded-full bg-emerald-600 mt-1.5 shrink-0"></div>
                <div class="flex-1">
                  <div class="flex items-center justify-between">
                    <span class="font-bold text-gray-800">${h.status} (${h.shippingStatus || 'Updated'})</span>
                    <span class="text-[10px] text-gray-400">${new Date(h.date).toLocaleString()}</span>
                  </div>
                  <div class="text-gray-600 text-[11px]">${h.note || ''}</div>
                  <div class="text-[9px] text-gray-400">By: ${h.updatedBy || 'Staff'}</div>
                </div>
              `;
              timelineContainer.appendChild(item);
            });
          } else {
            timelineContainer.innerHTML = '<div class="text-gray-400 text-center py-2">No timeline events recorded.</div>';
          }

          document.getElementById('orderDetailModal').classList.remove('hidden');
        }
      } catch (err) {
        console.error('Error fetching order detail:', err);
      }
    }
  </script>

</body>
</html>
